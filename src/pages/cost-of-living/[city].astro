---
import Layout from '../../layouts/Layout.astro';
import cities from '../../public/data/cities.json';

export async function getStaticPaths() {
    return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const usdToTwd = 32;
const fmt = (n) => n.toLocaleString('zh-TW');
const costRows = [
    { label: '生存水準 Survival', usd: city.costs_usd.survival },
    { label: '舒適水準 Comfort', usd: city.costs_usd.comfort },
    { label: '奢華水準 Luxury', usd: city.costs_usd.luxury },
];
const indexRows = [
    { label: '安全指數', value: city.indices.safety },
    { label: '網路速度', value: city.indices.internet },
    { label: '氣候舒適', value: city.indices.weather },
];
const title = `${city.name['zh-TW']}生活成本：月支出與指數｜TaiCalc`;
const description = `${city.name['zh-TW']}月生活成本：生存 ${fmt(city.costs_usd.survival)} USD、舒適 ${fmt(city.costs_usd.comfort)} USD、奢華 ${fmt(city.costs_usd.luxury)} USD。含安全/網路/氣候指數與標籤。`;
const keywords = `${city.name['zh-TW']}生活費,${city.name['zh-TW']}生活成本,${city.country['zh-TW']}生活費,移居,數位遊牧,遠距工作`;

const placeSchema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Place',
    name: city.name['zh-TW'],
    description: city.description['zh-TW'],
    url: `https://taicalc.com/cost-of-living/${city.slug}`,
    address: { '@type': 'PostalAddress', addressCountry: city.country['zh-TW'] },
});
---

<Layout title={title} description={description} keywords={keywords}>
    <script type="application/ld+json" set:html={placeSchema} slot="head" />
    <div class="max-w-4xl mx-auto px-4 md:px-0 py-8">
        <nav class="text-xs text-ink-400 mb-4">
            <a href="/" class="hover:text-ink-700">TaiCalc</a> ›
            <a href="/cost-of-living" class="hover:text-ink-700">城市生活成本</a> ›
            <span class="text-ink-600">{city.name['zh-TW']}</span>
        </nav>

        <div class="overflow-hidden rounded-2xl border border-paper-300 bg-white">
            <img src={city.image} alt={city.name['zh-TW']} class="h-48 w-full object-cover md:h-64" />
            <div class="p-6">
                <p class="text-[11px] font-semibold uppercase tracking-[.18em] text-brand-300">{city.region} · {city.currency}</p>
                <h1 class="mt-2 text-2xl font-semibold md:text-3xl">{city.name['zh-TW']}</h1>
                <p class="mt-2 text-sm text-ink-500">{city.description['zh-TW']}</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                    {city.tags.map((tag) => (
                        <span class="rounded-full bg-paper-100 px-3 py-1 text-xs text-ink-600">{tag}</span>
                    ))}
                </div>
            </div>
        </div>

        <h2 class="mt-8 text-lg font-semibold">月生活成本（USD）</h2>
        <table class="mt-3 w-full text-sm border-collapse">
            <thead>
                <tr class="border-b border-paper-300 text-left text-ink-400">
                    <th class="py-2 pr-3 font-medium">水準</th>
                    <th class="py-2 pr-3 text-right font-medium">USD / 月</th>
                    <th class="py-2 text-right font-medium">約台幣 / 月</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-paper-200 text-ink-600 [&>tr:nth-child(even)]:bg-paper-100/70">
                {costRows.map((row) => (
                    <tr>
                        <td class="py-2 pr-3">{row.label}</td>
                        <td class="py-2 pr-3 text-right font-semibold tabular-nums text-ink-700">${fmt(row.usd)}</td>
                        <td class="py-2 text-right tabular-nums">約 ${fmt(row.usd * usdToTwd)} 元</td>
                    </tr>
                ))}
            </tbody>
        </table>

        <h2 class="mt-8 text-lg font-semibold">生活指數（0–100 概估）</h2>
        <div class="mt-3 space-y-3">
            {indexRows.map((row) => (
                <div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-ink-600">{row.label}</span>
                        <span class="font-semibold text-ink-700 tabular-nums">{row.value}</span>
                    </div>
                    <div class="mt-1 h-2 rounded-full bg-paper-200 overflow-hidden">
                        <div class="h-full rounded-full bg-brand-500" :style="{}" style={`width: ${row.value}%`}></div>
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <a href="/cost-of-living/compare" class="rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm font-semibold text-brand-700 hover:border-brand-400 hover:bg-brand-100 transition-colors">與其他城市比較 →</a>
            <a href="/tools/life-simulator" class="rounded-xl border border-paper-300 bg-white px-4 py-3 text-sm font-semibold text-ink-600 hover:border-brand-200 hover:text-brand-600 transition-colors">用人生模擬器規劃移居 →</a>
        </div>

        <p class="mt-8 text-xs text-ink-400">金額為 USD 月支出概估，匯率以 1 USD ≈ 32 TWD 估算；實際生活費依個人消費習慣差異大，僅供移居與旅遊規劃參考。</p>
    </div>
</Layout>
