---
import Layout from '../../layouts/Layout.astro';
import CostOfLivingCompare from '../../components/calculators/CostOfLivingCompare.vue';

const title = "城市生活成本比較器｜兩城月支出與指數對照 | TaiCalc";
const description = "選兩個城市，即時比較月生活成本（生存/舒適/奢華三級）與安全、網路、氣候指數。適合數位遊牧、遠距工作與移居評估。";
const keywords = "城市生活成本比較,生活費比較,移居城市比較,數位遊牧,遠距工作,曼谷vs台北,大阪vs台北";
---

<Layout title={title} description={description} keywords={keywords}>
    <div class="max-w-4xl mx-auto px-4 md:px-0 py-8">
        <nav class="text-xs text-ink-400 mb-4">
            <a href="/" class="hover:text-ink-700">TaiCalc</a> ›
            <a href="/cost-of-living" class="hover:text-ink-700">城市生活成本</a> ›
            <span class="text-ink-600">比較器</span>
        </nav>

        <p class="text-[11px] font-semibold uppercase tracking-[.18em] text-brand-300">Compare</p>
        <h1 class="mt-2 text-2xl font-semibold md:text-3xl">城市生活成本比較器</h1>
        <p class="mt-2 text-sm text-ink-500">選兩個城市，並排比較月支出與生活指數。</p>

        <div class="mt-6">
            <CostOfLivingCompare client:only="vue" />
        </div>

        <div class="mt-8 rounded-2xl border border-paper-300 bg-paper-100 p-5">
            <h2 class="text-base font-semibold text-ink-700">怎麼用這個比較器</h2>
            <ul class="mt-3 space-y-1 text-sm text-ink-600">
                <li>先選兩個城市，比較「舒適水準」的月支出差異。</li>
                <li>再看安全、網路與氣候指數——低成本不一定適合每個人。</li>
                <li>移居前建議用<a href="/tools/life-simulator" class="text-brand-700 hover:underline">人生模擬器</a>把生活費帶入長期財務規劃。</li>
            </ul>
        </div>

        <p class="mt-8 text-xs text-ink-400">金額為 USD 月支出概估，實際依個人消費習慣差異大；指數為 0–100 概估。僅供移居與旅遊規劃參考。</p>
    </div>
</Layout>
