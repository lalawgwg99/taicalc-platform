---
import Layout from '../layouts/Layout.astro';

const title = "育兒財務工具箱｜TaiCalc";
const description = "育兒成本一次算清：育兒津貼、育嬰留停、托育補助與收入缺口，用數字規劃生養計畫。";

const steps = [
    {
        title: "算育兒津貼與留停",
        desc: "育嬰留停津貼、育兒津貼與托育補助，確認生養的政府支持。",
        href: "/tools/parental-benefit-calculator",
        cta: "育兒津貼試算",
    },
    {
        title: "確認收入缺口",
        desc: "留停期間收入減少多少？用薪資實拿估算家庭現金流。",
        href: "/tools/salary-calculator",
        cta: "薪資實拿",
    },
    {
        title: "走一遍人生模擬",
        desc: "把育兒放進人生模擬器，看買房、買車與育兒的長期財務影響。",
        href: "/tools/life-simulator",
        cta: "人生模擬器",
    },
];

const comparePoints = [
    { title: "津貼 vs 實際支出", desc: "政府補助能覆蓋多少育兒成本？" },
    { title: "留停 vs 繼續工作", desc: "收入缺口與職涯中斷如何取捨？" },
    { title: "一胎 vs 多胎", desc: "多子女的津貼與成本如何累加？" },
];
---

<Layout title={title} description={description} fullWidth>
    <section class="pt-16 pb-20 md:pt-24 md:pb-28 hero-sheen relative overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 md:px-6 text-center relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-brand-50 border border-brand-100 rounded-full mb-6">
                <span class="text-xs font-medium text-brand-600">生養計畫先算財務</span>
            </div>
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-normal text-ink-700 tracking-tight leading-[1.2] mb-5">
                育兒是長期支出<br class="md:hidden">先算清再決定
            </h1>
            <p class="text-base md:text-lg text-ink-400 leading-relaxed max-w-2xl mx-auto mb-8">
                育兒津貼、育嬰留停、托育補助——把政府支持與實際支出對上，才能安心規劃。
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="/tools/parental-benefit-calculator" class="btn-primary rounded-xl px-5 py-3 text-sm">先算育兒津貼</a>
                <a href="/tools/life-simulator" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white border border-paper-300 text-ink-100 text-sm font-medium hover:border-brand hover:text-brand transition-colors">走一遍人生模擬</a>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24 bg-white section-wash">
        <div class="max-w-6xl mx-auto px-4 md:px-6">
            <div class="max-w-xl mb-10 md:mb-14">
                <span class="text-[11px] font-semibold text-brand uppercase tracking-widest">三步驟</span>
                <h2 class="text-xl md:text-2xl font-medium text-ink-700 mt-2">用 3 個計算完成育兒財務規劃</h2>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
                {steps.map((step) => (
                    <a href={step.href} class="group rounded-2xl border border-paper-300 bg-paper-100 p-5 transition-all hover:border-brand-300 hover:bg-paper-50">
                        <p class="text-sm font-semibold text-ink-700 group-hover:text-brand transition-colors">{step.title}</p>
                        <p class="mt-2 text-sm text-ink-500 leading-relaxed">{step.desc}</p>
                        <p class="mt-4 text-sm font-semibold text-brand">{step.cta} →</p>
                    </a>
                ))}
            </div>

            <div class="mt-12 grid gap-4 md:grid-cols-3">
                {comparePoints.map((point) => (
                    <div class="rounded-2xl border border-paper-300 bg-white p-5">
                        <p class="text-sm font-semibold text-ink-700">{point.title}</p>
                        <p class="mt-2 text-sm text-ink-500 leading-relaxed">{point.desc}</p>
                    </div>
                ))}
            </div>

            <div class="mt-12 rounded-2xl border border-paper-300 bg-paper-100 p-6">
                <h2 class="text-base font-semibold text-ink-700">延伸閱讀</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    <a href="/blog/2026-parental-leave-benefit-80-percent-daily-application" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">2026 育嬰留停 8 成薪</a>
                    <a href="/blog/2026-new-policies-guide" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">2026 新制總整理</a>
                    <a href="/glossary/parental-leave-allowance" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">育嬰留停津貼</a>
                    <a href="/glossary/childcare-allowance" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">育兒津貼</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
