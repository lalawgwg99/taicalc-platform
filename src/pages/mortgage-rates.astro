---
import Layout from '../layouts/Layout.astro';
import { centralBankFiveBankRates, newYouthRates, newYouthTerms, mortgageDataSources, mortgageLastUpdated } from '../data/mortgageRates';

const title = "房貸利率市調表｜央行五大銀行與新青安 3.0 利率一覽 | TaiCalc";
const description = "台灣房貸利率市調：央行五大銀行新承做放款平均利率（2026 最新）、新青安 3.0 完整利率階梯（1.775%→2.275%）與申請條件。附資料來源與更新日期。";
const keywords = "房貸利率,房貸利率比較,五大銀行房貸利率,新青安利率,新青安3.0,央行利率,房貸利率2026";

const tableSchema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'TaiCalc 房貸利率市調表',
    description: '央行五大銀行新承做放款平均利率與新青安 3.0 利率階梯',
    dateModified: mortgageLastUpdated,
    creator: { '@type': 'Organization', name: 'TaiCalc' },
});
---

<Layout title={title} description={description} keywords={keywords}>
    <script type="application/ld+json" set:html={tableSchema} slot="head" />
    <div class="max-w-3xl mx-auto px-4 md:px-0 py-8">
        <nav class="text-xs text-ink-400 mb-4">
            <a href="/" class="hover:text-ink-700">TaiCalc</a> ›
            <a href="/housing-toolbox" class="hover:text-ink-700">買房工具箱</a> ›
            <span class="text-ink-600">房貸利率市調</span>
        </nav>

        <p class="text-[11px] font-semibold uppercase tracking-[.18em] text-brand-300">Mortgage rates</p>
        <h1 class="mt-2 text-2xl font-semibold md:text-3xl">房貸利率市調表</h1>
        <p class="mt-2 text-sm text-ink-500">央行五大銀行新承做放款平均利率（市場基準）＋新青安 3.0 利率階梯。更新：{mortgageLastUpdated}</p>

        <h2 class="mt-8 text-lg font-semibold">五大銀行新承做放款平均利率（央行）</h2>
        <table class="mt-3 w-full text-sm border-collapse">
            <thead>
                <tr class="border-b border-paper-300 text-left text-ink-400">
                    <th class="py-2 pr-3 font-medium">月份</th>
                    <th class="py-2 pr-3 text-right font-medium">加權平均利率</th>
                    <th class="py-2 font-medium">說明</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-paper-200 text-ink-600 [&>tr:nth-child(even)]:bg-paper-100/70">
                {centralBankFiveBankRates.map((point) => (
                    <tr>
                        <td class="py-2 pr-3 font-semibold text-ink-700">{point.month}</td>
                        <td class="py-2 pr-3 text-right font-bold text-ink-700 tabular-nums">{point.rate}%</td>
                        <td class="py-2 text-xs text-ink-500">{point.note}</td>
                    </tr>
                ))}
            </tbody>
        </table>
        <p class="mt-2 text-xs text-ink-400">五大銀行＝台銀、合庫銀、一銀、華銀、土銀。此為市場整體利率基準，個別銀行房貸利率依成數、信用與專案略有差異。</p>

        <h2 class="mt-8 text-lg font-semibold">新青安 3.0 利率階梯（2026-08-01 起）</h2>
        <table class="mt-3 w-full text-sm border-collapse">
            <thead>
                <tr class="border-b border-paper-300 text-left text-ink-400">
                    <th class="py-2 pr-3 font-medium">期間</th>
                    <th class="py-2 pr-3 text-right font-medium">利率</th>
                    <th class="py-2 font-medium">說明</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-paper-200 text-ink-600 [&>tr:nth-child(even)]:bg-paper-100/70">
                {newYouthRates.map((row) => (
                    <tr>
                        <td class="py-2 pr-3 font-semibold text-ink-700">{row.period}</td>
                        <td class="py-2 pr-3 text-right font-bold text-brand-700 tabular-nums">{row.rate}%</td>
                        <td class="py-2 text-xs text-ink-500">{row.note}</td>
                    </tr>
                ))}
            </tbody>
        </table>

        <h2 class="mt-8 text-lg font-semibold">新青安 3.0 申請條件</h2>
        <ul class="mt-3 space-y-1 text-sm text-ink-600">
            <li>額度上限：{newYouthTerms.maxAmountWan} 萬元（新婚 1,200 萬、育兒家庭 1,500 萬）</li>
            <li>成數最高 {Math.round(newYouthTerms.maxLtv * 100)} 成、年限最長 {newYouthTerms.maxYears} 年、寬限期最長 {newYouthTerms.maxGrace} 年</li>
            <li>排富：本人年所得不超過 {newYouthTerms.incomeCap.toLocaleString('zh-TW')} 元、申貸年齡未滿 {newYouthTerms.ageCap} 歲</li>
            <li>申辦期間：{newYouthTerms.period}</li>
        </ul>

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <a href="/tools/mortgage-calculator" class="rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm font-semibold text-brand-700 hover:border-brand-400 hover:bg-brand-100 transition-colors">用房貸試算器算月付 →</a>
            <a href="/compare/xin-qing-an-vs-general-mortgage" class="rounded-xl border border-paper-300 bg-white px-4 py-3 text-sm font-semibold text-ink-600 hover:border-brand-200 hover:text-brand-600 transition-colors">新青安 vs 一般房貸比較 →</a>
        </div>

        <div class="mt-8 rounded-xl border border-paper-300 bg-paper-100 px-4 py-3 text-xs text-ink-500">
            <strong>資料來源：</strong>
            {mortgageDataSources.map((source, i) => (
                <span>{i > 0 ? ' · ' : ''}<a href={source.href} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">{source.label}</a></span>
            ))}
            <span class="block mt-1">更新日期：{mortgageLastUpdated}。利率會隨央行政策與市場變動，請以主管機關與承貸銀行最新公告為準。</span>
        </div>
    </div>
</Layout>
