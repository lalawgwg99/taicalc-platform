---
import Layout from '../layouts/Layout.astro';

const title = "買車決策工具箱｜TaiCalc";
const description = "買車前先算清楚：車貸、牌照稅、燃料費、折舊與養車成本一次算完，避免買得起卻養不起。";

const steps = [
    {
        title: "算真正養車成本",
        desc: "車貸、牌照稅、燃料費、折舊與保養一次算清，別只看車價。",
        href: "/tools/car-cost-calculator",
        cta: "買車總成本",
    },
    {
        title: "確認薪資負擔得起",
        desc: "把月付與養車成本對上薪資實拿，確認不會壓垮現金流。",
        href: "/tools/salary-calculator",
        cta: "薪資實拿",
    },
    {
        title: "油錢 vs 電費",
        desc: "油車與電動車的能源成本差異，用電費與油耗一起比較。",
        href: "/tools/electricity-calculator",
        cta: "電費試算",
    },
];

const comparePoints = [
    { title: "車貸月付 vs 現金", desc: "貸款買車的利息成本是否值得？" },
    { title: "油車 vs 電動車", desc: "能源成本與折舊誰划算？" },
    { title: "養車 vs 大眾運輸", desc: "每月養車成本是否超過通勤預算？" },
];
---

<Layout title={title} description={description} fullWidth>
    <section class="pt-16 pb-20 md:pt-24 md:pb-28 hero-sheen relative overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 md:px-6 text-center relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-brand-50 border border-brand-100 rounded-full mb-6">
                <span class="text-xs font-medium text-brand-600">買車前先算清楚</span>
            </div>
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-normal text-ink-700 tracking-tight leading-[1.2] mb-5">
                買得起，更要養得起<br class="md:hidden">把帳算完再下單
            </h1>
            <p class="text-base md:text-lg text-ink-400 leading-relaxed max-w-2xl mx-auto mb-8">
                車價只是開始。牌照稅、燃料費、折舊與保養才是長期負擔——用 TaiCalc 一次算清。
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="/tools/car-cost-calculator" class="btn-primary rounded-xl px-5 py-3 text-sm">先算養車成本</a>
                <a href="/tools/salary-calculator" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white border border-paper-300 text-ink-100 text-sm font-medium hover:border-brand hover:text-brand transition-colors">先算薪資實拿</a>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24 bg-white section-wash">
        <div class="max-w-6xl mx-auto px-4 md:px-6">
            <div class="max-w-xl mb-10 md:mb-14">
                <span class="text-[11px] font-semibold text-brand uppercase tracking-widest">三步驟</span>
                <h2 class="text-xl md:text-2xl font-medium text-ink-700 mt-2">用 3 個計算完成買車決策</h2>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
                {steps.map((step) => (
                    <a href={step.href} class="group rounded-2xl border border-paper-300 bg-paper-100 p-5 transition-all hover:border-brand-300 hover:bg-paper-50">
                        <p class="text-sm font-semibold text-ink-700 group-hover:text-brand transition-colors">{step.title}</p>
                        <p class="mt-2 text-sm text-ink-500 leading-relaxed">{step.desc}</p>
                        <p class="mt-4 text-sm font-semibold text-brand">{step.cta} →</p>
                    </a>
                ))}
            </div>

            <div class="mt-12 grid gap-4 md:grid-cols-3">
                {comparePoints.map((point) => (
                    <div class="rounded-2xl border border-paper-300 bg-white p-5">
                        <p class="text-sm font-semibold text-ink-700">{point.title}</p>
                        <p class="mt-2 text-sm text-ink-500 leading-relaxed">{point.desc}</p>
                    </div>
                ))}
            </div>

            <div class="mt-12 rounded-2xl border border-paper-300 bg-paper-100 p-6">
                <h2 class="text-base font-semibold text-ink-700">延伸閱讀</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    <a href="/blog/2026-car-ownership-cost-per-month-taiwan" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">2026 台灣養車月成本</a>
                    <a href="/glossary/basic-wage" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">基本工資</a>
                    <a href="/glossary/electricity-tier" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">電費級距</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
