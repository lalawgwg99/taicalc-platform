---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DecisionCalculator from '../../components/calculators/DecisionCalculator.vue';
import IntentPanel from '../../components/IntentPanel.astro';
const sources = [
  { label: '財政部｜115 年遺產稅免稅額及扣除額', href: 'https://www.mof.gov.tw/singlehtml/384fb3077bb349ea973e7fc6f13b6974?cntId=f2a148bdd1614850be9fa56df8cc9d5c' },
  { label: '財政部｜遺產及贈與稅課稅級距', href: 'https://www.mof.gov.tw/singlehtml/384fb3077bb349ea973e7fc6f13b6974?cntId=9ba544f1016c4b85b54960b4346b5b75' },
  { label: '財政部稅務入口網｜贈與稅免稅額', href: 'https://www.etax.nat.gov.tw/etwmain/tax-info/understanding/tax-saving-secret/o2Q68JR' },
];
const faqs = [
  { q: '贈與稅免稅額是每人每年都有嗎？', a: '每位贈與人每曆年有 244 萬元免稅額，不是每位受贈人各有一份。' },
  { q: '遺產價值直接用市價嗎？', a: '不同資產有各自申報價值認定方式，例如土地、房屋與有價證券並非一律直接用成交市價。' },
];
---
<ToolLayout title="115 年遺產稅／贈與稅試算" description="套用 115 年遺產稅免稅額、扣除額與遺產贈與稅累進級距，快速估算應納稅額。" keywords="遺產稅試算,贈與稅試算,115年免稅額,遺產稅扣除額,贈與稅免稅額" category="稅務與傳承" kicker="先看課稅淨額，再決定是否需要更完整的傳承規劃。" faqs={faqs} dataVersion="115-estate-gift-v1" dataYear="民國 115 年" lastUpdated="2026-07-29" sources={sources}>
  <DecisionCalculator type="estate-tax" client:only="vue" slot="tool" />
  <IntentPanel slot="after-tool" source="estate-tax" partnerTitle="合法稅務與傳承專業服務合作" />
  <div slot="article"><h2>115 年試算基礎</h2><p>遺產稅免稅額為 1,333 萬元，另依配偶、直系卑親屬、父母、重度以上身心障礙與喪葬費等計算扣除額。贈與稅每位贈與人每年免稅額為 244 萬元。</p><p>工具採 10%、15%、20% 逐段累進計算。未成年子女加扣、農地、公共設施保留地、夫妻剩餘財產差額分配等特殊項目，請填入其他扣除額前先確認適用資格。</p></div>
</ToolLayout>
