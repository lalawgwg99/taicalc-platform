---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DecisionCalculator from '../../components/calculators/DecisionCalculator.vue';
import AssetCompare from '../../components/calculators/AssetCompare.vue';
import IntentPanel from '../../components/IntentPanel.astro';
const faqs = [
  { q: '什麼是實質報酬？', a: '實質報酬是把名目報酬扣除通膨影響後的購買力變化，精確關係為（1＋淨名目報酬）÷（1＋通膨）－1。' },
  { q: '預設 ETF 7% 代表保證報酬嗎？', a: '不代表。預設值只是方便比較的長期情境，使用者應自行輸入符合商品、幣別與風險承受度的假設。' },
  { q: '定存 1.5%、債券 3.5%、ETF 7% 是怎麼來的？', a: '為歷史長期年化報酬的概估值：台幣定存約 1.5%、債券型 ETF 約 3.5%、股票型 ETF 約 7%。實際報酬波動大，僅供比較參考。' },
  { q: '高報酬的資產一定比較好嗎？', a: '不一定。股票型 ETF 報酬高但波動大，短期可能虧損；定存保本但購買力被通膨侵蝕。應依風險承受度與投資期間配置。' },
  { q: '100 萬放 10 年，實質價值差多少？', a: '以通膨 2% 為例：定存（1.5%）10 年後實質價值約 95 萬元（縮水），股票型 ETF（7%）約 162 萬元。差距可達 67 萬元。' },
];
---
<ToolLayout title="定存、債券、ETF 實質報酬比較｜通膨後購買力＋三資產互動試算" description="同時比較定存、債券與 ETF 在費用、稅務耗損及通膨後的實質年報酬與期末購買力。另有「資產實質報酬比較」分頁，互動試算三種資產 10 年後的實質價值差異。" keywords="實質報酬計算,通膨計算,定存債券ETF比較,複利試算,ETF報酬,定存vs債券vsETF" category="投資與退休" kicker="帳面數字變大，不一定代表購買力真的增加。" faqs={faqs} dataVersion="2026.07-return-v1" dataYear="自訂情境" lastUpdated="2026-07-29" sources={[{ label: '中央銀行｜物價與統計資料', href: 'https://www.cbc.gov.tw/' }]}>
  <div slot="tool">
    <div class="tool-tabs" role="tablist" aria-label="實質報酬功能切換">
      <button type="button" data-tabbtn="calc" role="tab" aria-selected="true">實質報酬試算</button>
      <button type="button" data-tabbtn="assetvs" role="tab" aria-selected="false">資產實質報酬比較</button>
    </div>
    <div data-tabpanel="calc" role="tabpanel">
      <DecisionCalculator type="real-return" client:only="vue" />
    </div>
    <div data-tabpanel="assetvs" role="tabpanel" hidden>
      <AssetCompare client:only="vue" />
    </div>
  </div>
  <script>
    (function () {
      var btns = Array.prototype.slice.call(document.querySelectorAll('[data-tabbtn]'));
      var panels = Array.prototype.slice.call(document.querySelectorAll('[data-tabpanel]'));
      if (!btns.length) return;
      function activate(name) {
        btns.forEach(function (b) {
          var on = b.getAttribute('data-tabbtn') === name;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (p) { p.hidden = p.getAttribute('data-tabpanel') !== name; });
      }
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          var name = b.getAttribute('data-tabbtn');
          activate(name);
          try {
            var url = new URL(window.location.href);
            url.searchParams.set('tab', name);
            history.replaceState(null, '', url.toString());
          } catch (e) {}
        });
      });
      var init = null;
      try { init = new URLSearchParams(window.location.search).get('tab'); } catch (e) {}
      var valid = btns.map(function (b) { return b.getAttribute('data-tabbtn'); });
      activate(valid.indexOf(init) >= 0 ? init : 'calc');
    })();
  </script>
  <style>
    .tool-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px solid rgba(0,0,0,0.06); }
    .tool-tabs [data-tabbtn] {
      padding: 0.6rem 1.1rem; font-size: 0.875rem; font-weight: 600;
      color: #78716c; background: transparent; border: none; cursor: pointer;
      border-bottom: 2px solid transparent; margin-bottom: -2px;
    }
    .tool-tabs [data-tabbtn][aria-selected="true"] { color: #166534; border-bottom-color: #16a34a; }
    .tool-tabs [data-tabbtn]:hover { color: #44403c; }
  </style>
  <IntentPanel slot="after-tool" source="real-return" partnerTitle="合法金融服務與理財教育合作" />
  <div slot="article"><h2>用購買力比較</h2><p>工具先從名目報酬扣除年費用與稅務耗損，再以通膨折算今天購買力。定存、債券與 ETF 的預設報酬都是情境輸入，不是即時利率、歷史回測或未來保證。</p><h3>風險沒有放進單一數字</h3><p>期末價值無法完整代表價格波動、匯率、信用風險與流動性。比較時應搭配資金用途與可承受虧損，而非只選最高報酬。公式與比較方式可參考<a href="/blog/real-return-after-inflation-fees-tax">定存、債券、ETF 扣通膨後實質報酬</a>。</p>
  <h2>定存 vs 債券 vs ETF：通膨後實質報酬比較</h2><p>同樣 100 萬元，放在定存、債券或股票型 ETF，10 年後的購買力天差地遠。關鍵不是名目數字，而是<strong>扣除通膨後的實質價值</strong>。切換上方「資產實質報酬比較」分頁，輸入你的金額、年數與通膨率即時試算。</p>
  <h3>100 萬、10 年、通膨 2% 試算情境</h3><ul><li><strong>台幣定存</strong>（1.5%）：名目約 116 萬，實質約 <strong>95 萬</strong>（購買力縮水）</li><li><strong>債券型 ETF</strong>（3.5%）：名目約 141 萬，實質約 <strong>116 萬</strong></li><li><strong>股票型 ETF</strong>（7%）：名目約 197 萬，實質約 <strong>162 萬</strong></li></ul>
  <blockquote><strong>重點：</strong>定存看似安全，實質購買力卻逐年縮水。退休與長期資金，至少要讓報酬率跑贏通膨。</blockquote>
  <p class="note-box">年化報酬為歷史概估，非保證；未計稅與費用。資產配置請依個人風險承受度決定。</p></div>
</ToolLayout>
