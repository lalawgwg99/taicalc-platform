---
import ToolLayout from '../../layouts/ToolLayout.astro';
import LaborPensionCalculator from '../../components/calculators/LaborPensionCalculator.vue';
import LaborPensionLumpVsMonthly from '../../components/calculators/LaborPensionLumpVsMonthly.vue';
import PensionContributionCompare from '../../components/calculators/PensionContributionCompare.vue';

const title = "2026 勞退試算極致版｜舊制/新制退休金＋一次領vs月領、自提0%vs6%比較｜TaiCalc";
const description = "試算勞退提撥、複利與退休後可領金額。另有「一次領 vs 月領」分頁比較勞保老年年金回本年限，「自提 0% vs 6%」分頁比較自提節稅與長期效益。";
const keywords = "勞退自提,勞工退休金,新制退休金,舊制退休金,勞退試算,勞退自提6%,退休金計算,雇主提撥,節稅效益,勞保一次領,勞保月領,一次領vs月領,回本年限";

const faqs = [
    {
        q: "勞退自提 6% 划算嗎？有什麼好處？",
        a: "自提全數自所得扣除節稅，保證收益不低於當地銀行2年期定存利率、基本上保本，專戶跟人走；原則上60歲才能領，彈性低，先留足緊急預備金。"
    },
    {
        q: "2026 年勞退分紅平均 13 萬元，是每個人都領得到嗎？",
        a: "不是每個人都領一樣多。勞動基金運用局 2026 年 11 月 2 日公布：新制勞退基金今年前 9 月收益率 30.43%（8 月底為 29.25%），收益 1 兆 7,044 億元；以約 1,310 萬戶有效帳戶估算，平均每戶帳面分紅約 13.01 萬元，首次突破 13 萬元。實際分配依個人專戶累積本金與提繳期間計算，2027 年 3 月底前分配入帳，且原則上須年滿 60 歲才能領。另外注意：30.43% 是今年前 9 個月的累計收益率，不是年化報酬率，不能直接拿來推估未來每年都有 30%。"
    },
    {
        q: "勞退新制和舊制差在哪？",
        a: "新制（2005年7月）：雇主每月提撥薪資6%到專戶，跟人走；舊制一次給付，需同一單位滿25年或滿15年55歲，離職年資歸零；2005年後初次就業新制。"
    },
    {
        q: "勞退的錢幾歲可以領？",
        a: "年滿60歲即可請領；未滿60歲死亡，由遺屬或指定請領人一次請領。可選一次領或按月領；按月領期間死亡，餘額由遺屬領回。"
    },
    {
        q: "雇主沒提撥勞退 6% 怎麼辦？",
        a: "雇主月提撥6%是法定義務，不是福利。短提或未提可向勞保局檢舉，雇主會被罰鍰並須補提；可上勞保局網站查專戶確認是否足額提撥，定期檢查。"
    },
    {
        q: "勞退自提的錢會不會虧損？",
        a: "保證收益：勞退基金收益不得低於當地銀行2年期定存利率，長期持有基本上保本；但只是「不低於定存」，不是保證高報酬，別當積極投資工具。"
    },
    {
        q: "勞退自提 6% 能節多少稅？",
        a: "月薪45,000元、稅率12%為例：每月自提2,748元，每年節稅約3,957元；稅率越高，節稅效益越大。"
    },
    {
        q: "月薪 4.5 萬自提 6%，一年能省多少稅？",
        a: "依勞保局舉例（工商時報 2026-10-08 報導）：月薪 4.5 萬元對應的月提繳工資為 45,800 元（不是實領薪水，是級距對應的提繳工資）。自提 1% 每月 458 元、一年 5,496 元，5% 稅率約省稅 275 元；自提 3% 每月 1,374 元、一年 16,488 元，約省稅 824 元；自提 6% 每月 2,748 元、一年 32,976 元，約省稅 1,649 元。自提金額全數自當年度薪資所得扣除，但原則上要年滿 60 歲才能領，提繳比例一年內最多調整 2 次，也可隨時申報停止；實際節稅看你的適用稅率與提繳工資級距。"
    },
    {
        q: "誰適合自提？誰不適合？",
        a: "高稅率、想強迫儲蓄、退休資金不足者適合自提；低稅率、需要資金彈性、或自信投資報酬遠高於勞退者，可評估後再決定。"
    },
    {
        q: "勞保老年年金月領怎麼算？",
        a: "月領＝平均月投保薪資×年資×1.55%。以45,800元、30年為例，每月約21,297元；可用「一次領 vs 月領」分頁試算。"
    },
    {
        q: "勞保一次請領怎麼算？",
        a: "一次領金額＝平均月投保薪資×給付月數。前15年年資每年1個月、第16年起每年2個月，上限45個月。以45,800元、30年為例，約206.1萬元。"
    },
    {
        q: "勞保月領要多久才能超過一次領？",
        a: "以45,800元、30年為例：一次領約206.1萬元，月領每月約2.13萬元，約8.1年累計即超過一次領；預期領取超過8~9年者，月領通常較有利。"
    },
    {
        q: "勞保可以同時領一次領和月領嗎？",
        a: "不行。勞保老年給付的月領與一次請領只能擇一，請領時需確認。提前或延後請領會增減月領金額（每提前/延後 1 年增減 4%）。"
    },
];
---

<ToolLayout title={title} description={description} keywords={keywords} category="退休理財" faqs={faqs}>
    <div slot="tool">
        <div class="tool-tabs" role="tablist" aria-label="勞退功能切換">
            <button type="button" data-tabbtn="calc" role="tab" aria-selected="true">勞退試算</button>
            <button type="button" data-tabbtn="lump" role="tab" aria-selected="false">一次領 vs 月領</button>
            <button type="button" data-tabbtn="selfpay" role="tab" aria-selected="false">自提 0% vs 6%</button>
        </div>
        <div data-tabpanel="calc" role="tabpanel">
            <LaborPensionCalculator client:only="vue" />
        </div>
        <div data-tabpanel="lump" role="tabpanel" hidden>
            <LaborPensionLumpVsMonthly client:only="vue" />
        </div>
        <div data-tabpanel="selfpay" role="tabpanel" hidden>
            <PensionContributionCompare client:only="vue" />
        
    <script is:inline>
        (function () {
            var btns = Array.prototype.slice.call(document.querySelectorAll('[data-tabbtn]'));
            var panels = Array.prototype.slice.call(document.querySelectorAll('[data-tabpanel]'));
            if (!btns.length) return;
            function activate(name) {
                btns.forEach(function (b) {
                    var on = b.getAttribute('data-tabbtn') === name;
                    b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panels.forEach(function (p) { p.hidden = p.getAttribute('data-tabpanel') !== name; });
            }
            btns.forEach(function (b) {
                b.addEventListener('click', function () {
                    var name = b.getAttribute('data-tabbtn');
                    activate(name);
                    try {
                        var url = new URL(window.location.href);
                        url.searchParams.set('tab', name);
                        history.replaceState(null, '', url.toString());
                    } catch (e) {}
                });
            });
            var init = null;
            try { init = new URLSearchParams(window.location.search).get('tab'); } catch (e) {}
            var valid = btns.map(function (b) { return b.getAttribute('data-tabbtn'); });
            activate(valid.indexOf(init) >= 0 ? init : 'calc');
        })();
    </script>
</div>
    </div>
    
    <style>
        .tool-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px solid rgba(0,0,0,0.06); overflow-x: auto; scrollbar-width: none; }
        .tool-tabs [data-tabbtn] { white-space: nowrap; flex-shrink: 0;
            padding: 0.6rem 1.1rem; font-size: 0.875rem; font-weight: 600;
            color: #78716c; background: transparent; border: none; cursor: pointer;
            border-bottom: 2px solid transparent; margin-bottom: -2px;
        }
        .tool-tabs [data-tabbtn][aria-selected="true"] { color: #166534; border-bottom-color: #16a34a; }
        .tool-tabs [data-tabbtn]:hover { color: #44403c; }
    </style>

    <div slot="article">
        <h2>自提 6% 的三個效果，一個代價</h2>
        <p>自提是從薪水裡每月多撥 1%～6% 進自己的勞退帳戶。它有三個實際效果，也要付一個代價：錢要鎖到 60 歲才領得出來。</p>

        <h3>1. 當年度少繳所得稅</h3>
        <p>自提金額會從當年度的薪資所得中扣除，不計入課稅。月薪 5 萬、自提 6%，對應提繳工資 50,600 元，一年自提 36,432 元；若你的所得稅率是 12%，當年就少繳約 4,372 元。稅率越高省得越多；稅率只有 5% 的人，一年約省 1,822 元。</p>

        <h3>2. 收益有下限，不是保證獲利</h3>
        <p>勞退基金由勞動基金運用局投資，法規保障最低收益不低於銀行兩年期定存利率，結算不足由國庫補足。但這只是下限——實際收益隨基金績效浮動，過去也出現過單年度負收益的年份。</p>

        <h3>3. 帳戶跟著你走</h3>
        <p>勞退是個人專戶，換工作不用結清，雇主提撥和你的自提都累積在同一個帳戶裡，工作年資中斷也不影響。</p>

        <blockquote>
            <strong>先想清楚：</strong>自提的錢原則上 60 歲前不能領。手邊還沒有緊急預備金、或有高利率債務的人，先顧好流動性，再考慮自提。
        </blockquote>

        <h2>勞保老年年金：一次領 vs 月領（回本年限試算）</h2>
        <p>勞保老年年金請領時最常糾結「一次領」還是「月領」。關鍵在於：<strong>月領多久能累計超過一次領總額</strong>。切換上方「一次領 vs 月領」分頁，輸入你的投保薪資與年資即時比較。</p>

        <h3>45,800 元、30 年試算情境</h3>
        <ul>
            <li><strong>月領</strong>：45,800 × 30 × 1.55% ≈ <strong>21,297 元／月</strong></li>
            <li><strong>一次領</strong>：45,800 × 45 個月（前 15 年 15 個月＋後 15 年 30 個月）≈ <strong>206.1 萬元</strong></li>
            <li><strong>回本年限</strong>：206.1 萬 ÷ 21,297 ÷ 12 ≈ <strong>8.1 年</strong></li>
        </ul>
        <blockquote>
            <strong>判斷原則：</strong>預期領取超過回本年限者，月領通常較有利（且月領隨物價調整）；資金有立即需求、或預期壽命較短者，可考慮一次領。
        </blockquote>

        <h3>注意事項</h3>
        <ul>
            <li>提前 5 年或延後 5 年請領，每 1 年增減 4% 給付。</li>
            <li>實際給付以勞保局核定為準，本頁為概算。</li>
            <li>月領年金設有「展延」機制，延後請領可提高月領金額。</li>
        </ul>
        <p class="note-box">數字為本頁比較器依勞保老年給付規則概算，四捨五入；實際金額以勞保局核定為準。</p>

        <h2>勞退自提 0% vs 6%：節稅與複利比較</h2>
        <p>勞退新制除了雇主強制提撥 6%，勞工還可自願額外提繳 1%~6%。自提的最大誘因是<strong>節稅</strong>——自提金額免計入當年度所得。切換上方「自提 0% vs 6%」分頁，比較自提與不自提的長期差異。</p>

        <h3>月薪 45,000、30 年、報酬 5%、稅率 12% 試算情境</h3>
        <ul>
            <li><strong>每月自提 6%</strong>：2,748 元／月，30 年累積約 <strong>229 萬元</strong>（複利）</li>
            <li><strong>每年節稅</strong>：約 3,957 元，30 年累積節稅約 <strong>11.9 萬元</strong></li>
            <li>自提 vs 不自提的長期差異，主要來自節稅效益</li>
        </ul>

        <h3>一年來看：自提 6% vs 不自提（月薪 4.5 萬、提繳工資 45,800 元、稅率 5%）</h3>
        <div class="overflow-x-auto">
        <table>
            <thead><tr><th>一年對照</th><th>自提 6%</th><th>不自提</th></tr></thead>
            <tbody>
                <tr><td>每月自提</td><td>2,748 元</td><td>0 元</td></tr>
                <tr><td>一年自提總額</td><td>32,976 元</td><td>0 元</td></tr>
                <tr><td>當年節稅（5% 稅率）</td><td>約 1,649 元</td><td>0 元</td></tr>
                <tr><td>預估收益（6.6%）</td><td>約 2,176 元</td><td>0 元</td></tr>
                <tr><td>一年後專戶增加（自提＋收益）</td><td>約 35,152 元</td><td>0 元</td></tr>
            </tbody>
        </table>
        </div>
        <p>自提與節稅數字依勞保局舉例（月薪 4.5 萬元對應提繳工資 45,800 元）；報酬率 6.6% 為新制勞退基金近十年平均每年報酬率約數（今周刊 2026-10-21），僅作假設、非保證，實際收益隨基金績效浮動。30.43% 是 2026 年前 9 個月的累計收益率，不可當成年化報酬往後推估。</p>
        <blockquote>
            <strong>重點：</strong>自提是「強迫儲蓄＋節稅」的組合。稅率越高越划算；但資金鎖在專戶、須待法定年齡領取，需權衡彈性。
        </blockquote>

        <p class="note-box">數字為本頁比較器複利估算；勞退專戶具保證收益下限（2 年期定存利率），實際收益以勞保局公布為準。</p>
    </div>
</ToolLayout>
