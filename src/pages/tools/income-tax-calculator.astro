---
import ToolLayout from '../../layouts/ToolLayout.astro';
import IncomeTaxCalculator from '../../components/calculators/IncomeTaxCalculator.vue';
import IntentPanel from '../../components/IntentPanel.astro';
import { coreToolGovernance } from '../../data/regulatoryMetadata';

const title = "2026 所得稅試算機｜TaiCalc";
const description = "估算 2026 綜所稅。比較標準、列舉與股利模式。";
const keywords = "2026所得稅,綜合所得稅試算,所得稅計算,股利所得稅,薪資所得,標準扣除額,列舉扣除額,節稅規劃,報稅試算";
const governance = coreToolGovernance.incomeTax;

const faqs = [
    {
        q: "年薪 100 萬要繳多少所得稅？2026 試算",
        a: "年薪100萬 薪扣22.7、標扣13.6、免稅額10.1萬，課稅53.6萬，5%（61萬以下），應納26,800元；扶養子女每人免稅額15.15萬。"
    },
    {
        q: "2026 年報稅截止日是幾號？可以延期嗎？",
        a: "綜所稅申報期間每年5月1日～5月31日；重大災害等特殊情況可公告延期。用財政部電子申報繳稅服務（手機或電腦版）在5月底前完成，超期可能面臨滯報金。"
    },
    {
        q: "標準扣除額和列舉扣除額哪個比較省稅？",
        a: "標準扣除額單身13.6萬元、夫妻27.2萬元，不需憑證；列舉扣除額需整理捐贈、保費、房貸利息、租金等收據，合計超過標準扣除額才划算。"
    },
    {
        q: "股票股利要繳稅嗎？合併計稅還是分離課稅划算？",
        a: "股利所得二選一：合併計稅納入綜所，享8.5%可抵減稅額（上限8萬元），適合稅率20%以下；分離課稅固定28%，適合綜所稅率30～40%的高薪族。"
    },
    {
        q: "扶養未成年子女可以少繳多少稅？2026 新制",
        a: "2026年起（115年度），未成年子女免稅額由10.1萬元提高為15.15萬元，每名多5.05萬；5%稅率省2,525元，12%稅率省約6,060元。"
    },
    {
        q: "勞退自提可以省多少稅？",
        a: "勞退自提最高月薪6%，自薪資所得扣除；月薪5萬自提6%（提繳工資50,600元，月3,036元），一年自提36,432元，12%稅率省約4,372元。"
    },
];
---

<ToolLayout
    title={title}
    description={description}
    keywords={keywords}
    category="薪資與稅務"
    faqs={faqs}
    kicker="先估稅額，再比較扣除與退稅補繳"
    dataVersion={governance.version}
    dataYear={governance.dataYear}
    lastUpdated={governance.updatedAt}
    sources={governance.sources}
>
    <IncomeTaxCalculator client:only="vue" slot="tool" />
    <IntentPanel
        slot="after-tool"
        source="income-tax"
        partnerTitle="報稅記帳服務"
    />

    <div slot="article">
        <h2>綜合所得稅怎麼計算？2026 年版詳解</h2>
        <p>台灣個人綜合所得稅採<strong>累進稅率制</strong>，課稅所得越高，稅率越高（5% 到 40%）。關鍵在於：最終「課稅所得淨額」是從全年總所得扣掉免稅額、扣除額與各項特別扣除後的金額，通常比你想的低很多。</p>

        <h3>計算公式</h3>
        <p><strong>課稅所得 = 全年所得 − 薪資特別扣除 − 免稅額 − 扣除額（標準或列舉）− 其他特別扣除</strong></p>
        <p>許多人誤以為「年薪 100 萬就要繳很高的稅」，實際上扣掉一系列扣除後，大多數上班族課稅所得會降至 5% ~12% 稅率區間。</p>

        <h3>標準扣除 vs 列舉扣除</h3>
        <ul>
            <li><strong>標準扣除：</strong>不需檢附收據，單身 136,000 元，夫妻合申 272,000 元，最省事。</li>
            <li><strong>列舉扣除：</strong>需整理捐贈、保費、醫療與房貸利息等收據。超過標準扣除額才有利。房屋租金支出自 113 年度起改列特別扣除額，不再放入列舉扣除。</li>
        </ul>

        <blockquote>
            這支工具會同時算標準扣除和列舉扣除，直接告訴你哪個方案稅最少。
        </blockquote>

        <h3>常見誤解</h3>
        <ul>
            <li>年終獎金不會提高月薪對應的扣繳稅率，但合計到年度所得後可能進入更高的累進區間。</li>
            <li>股利所得有「合併計稅」或「分離課稅（28%）」兩種方式可選，本試算機可切換比較差異。</li>
            <li>勞退自提的金額可以全額從薪資所得中扣除，有節稅效果。</li>
        </ul>

        <p>如果你要更完整的申報準備流程，建議先看<a href="/blog/2026-income-tax-filing-deductions-taiwan">2026 報稅免稅額與扣除額整理</a>，再搭配<a href="/tax-season">報稅季攻略</a>整理憑證。請注意，本工具使用 115 年度所得金額，適用於 2027 年 5 月申報。</p>
    </div>
</ToolLayout>
