---
import ToolLayout from '../../layouts/ToolLayout.astro';
import RentCostCalculator from '../../components/calculators/RentCostCalculator.vue';
import RentVsBuy from '../../components/calculators/RentVsBuy.vue';

const title = "租金成本計算｜租 vs 買 10 年比較｜TaiCalc";
const description = "計算租屋真實成本，包含押金機會成本與隱藏費用；另有「租 vs 買」分頁，輸入房價、頭期款與月租金，比較買房與租屋 10 年後的淨資產差異。";
const keywords = "租金計算,租屋成本,押金機會成本,租屋試算,房租計算,租金補貼,租屋開銷,租屋預算,買房vs租屋,買房划算,租屋划算,租購比較";

const faqs = [
    {
        q: "房東押金最多可以收幾個月？",
        a: "依《租賃住宅市場發展及管理條例》規定，押金不得超過 2 個月租金總額。簽約時若房東要求超過 2 個月，你可以拒絕；已經超收的部分，可以要求返還。這條規定適用於住宅租賃，簽約前先確認契約內容。"
    },
    {
        q: "租屋電費一度 5 元、7 元合法嗎？",
        a: "2024 年 7 月起適用的新版住宅租賃定型化契約規定，房東向房客收取的電費，不得超過台電當期每度平均電價。若房東以一度 5 元、7 元超收，房客可向各縣市消保官申訴，最高可罰 30 萬元。簽約時務必確認電費計價方式寫進契約。"
    },
    {
        q: "2026 年還有租金補貼可以申請嗎？",
        a: "中央有推動租金補貼專案（300 億元中央擴大租金補貼），單身、新婚、育兒家庭等符合資格者每月可獲數千元補助。申請資格、金額與期程每年公告，請以內政部國土管理署最新公告為準，符合資格記得在申請期間內提出，別讓權益睡著。"
    },
    {
        q: "房東可以在租約到期後隨便漲房租嗎？",
        a: "租約存續期間內，租金依契約約定，房東不能單方面調漲。租約到期后续約屬於新契約，房東可以提出新租金，房客也有議價或不續租的權利。實務上建議：續約前先查附近實價登錄與租屋行情，帶著數據談，比空口議價有效。"
    },
    {
        q: "租屋的真實成本除了房租還有什麼？",
        a: "至少還有四筆：押金的機會成本（兩個月押金壓著，等於少賺利息）、電費價差（分租套房常高於台電費率）、通勤成本（為省房租住遠，交通費與時間都是錢）、搬家與家具折舊。把這些加總後除以 12，才是你每月的真實居住成本，用本站計算機一次算清楚。"
    },
    {
        q: "買房一定比租屋划算嗎？",
        a: "不一定。買房划算與否取決於房價漲幅、租金水準與頭期款的投資報酬。房價漲幅高於投資報酬時買房較佳；反之租屋＋投資可能更划算。用「租 vs 買」分頁輸入自己的條件試算最準。"
    },
    {
        q: "買房的真實成本有哪些？",
        a: "除月付金外，還有房屋稅、地價稅、管理費、維修、裝潢與交易成本（仲介、契稅、代書）。比較器以每年約房價 1% 估算持有成本。"
    },
    {
        q: "頭期款拿去投資，報酬率該設多少？",
        a: "保守可用 4~5%（股債配置），積極 7%。報酬率越高，租屋＋投資越有利。比較器預設 5%。"
    },
    {
        q: "租 vs 買比較忽略了什麼？",
        a: "未計裝潢、搬家、心理安定感、學區與生活品質等非財務因素。買房的「穩定感」與租屋的「彈性」各有價值，無法量化。"
    },
];
---

<ToolLayout title={title} description={description} keywords={keywords} category="生活計算" faqs={faqs}>
    <div slot="tool">
        <div class="tool-tabs" role="tablist" aria-label="租屋功能切換">
            <button type="button" data-tabbtn="calc" role="tab" aria-selected="true">租金成本試算</button>
            <button type="button" data-tabbtn="rentbuy" role="tab" aria-selected="false">租 vs 買</button>
        </div>
        <div data-tabpanel="calc" role="tabpanel">
            <RentCostCalculator client:only="vue" />
        </div>
        <div data-tabpanel="rentbuy" role="tabpanel" hidden>
            <RentVsBuy client:only="vue" />
        
    <script is:inline>
        (function () {
            var btns = Array.prototype.slice.call(document.querySelectorAll('[data-tabbtn]'));
            var panels = Array.prototype.slice.call(document.querySelectorAll('[data-tabpanel]'));
            if (!btns.length) return;
            function activate(name) {
                btns.forEach(function (b) {
                    var on = b.getAttribute('data-tabbtn') === name;
                    b.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panels.forEach(function (p) { p.hidden = p.getAttribute('data-tabpanel') !== name; });
            }
            btns.forEach(function (b) {
                b.addEventListener('click', function () {
                    var name = b.getAttribute('data-tabbtn');
                    activate(name);
                    try {
                        var url = new URL(window.location.href);
                        url.searchParams.set('tab', name);
                        history.replaceState(null, '', url.toString());
                    } catch (e) {}
                });
            });
            var init = null;
            try { init = new URLSearchParams(window.location.search).get('tab'); } catch (e) {}
            var valid = btns.map(function (b) { return b.getAttribute('data-tabbtn'); });
            activate(valid.indexOf(init) >= 0 ? init : 'calc');
        })();
    </script>
</div>
    </div>
    
    <style>
        .tool-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px solid rgba(0,0,0,0.06); }
        .tool-tabs [data-tabbtn] {
            padding: 0.6rem 1.1rem; font-size: 0.875rem; font-weight: 600;
            color: #78716c; background: transparent; border: none; cursor: pointer;
            border-bottom: 2px solid transparent; margin-bottom: -2px;
        }
        .tool-tabs [data-tabbtn][aria-selected="true"] { color: #166534; border-bottom-color: #16a34a; }
        .tool-tabs [data-tabbtn]:hover { color: #44403c; }
    </style>

    <div slot="article">
        <h2>租屋不只是繳房租：隱形成本大揭密</h2>
        <p>很多租屋族在計算預算時，往往只看到每個月的「房租」，卻忽略了押金的時間價值與其他潛在費用。這可能導致您低估了真實的居住成本。</p>

        <h3>租屋三大隱形成本</h3>
        <ul class="list-disc pl-5 space-y-2">
            <li><strong>押金機會成本：</strong> 兩個月的押金壓在房東那裡（通常是數萬元），這筆錢如果拿去投資（例如 5% 的 ETF），一年下來其實有數千元的「少賺利息」。</li>
            <li><strong>電費價差：</strong> 許多分租套房採取「一度電 5 元」甚至更高的計價方式，遠高於台電的一般費率。</li>
            <li><strong>通勤成本：</strong> 為了省房租住得遠，反而增加了每日的交通費與時間成本。</li>
        </ul>

        <blockquote>
            <strong>租屋補貼：</strong> 別忘了查詢政府的「300億元中央擴大租金補貼專案」。只要符合資格（單身、新婚、育兒家庭等），每月可補助 2,000 ~ 8,000 元不等，能大幅降低您的租屋負擔。
        </blockquote>

        <h2>買房 vs 租屋：不是二分法，是財務算術</h2>
        <p>「買房好還是租屋好」沒有標準答案，關鍵在三個數字：<strong>房價漲幅、租金水準、頭期款的投資報酬</strong>。用「租 vs 買」分頁輸入自己的條件，看 10 年後的淨資產差異。</p>

        <h3>1,200 萬房、頭期 300 萬、租金 2.5 萬試算情境</h3>
        <ul>
            <li><strong>買房</strong>：月付約 3.7 萬＋持有成本，10 年後淨資產約 <strong>1,000 萬+</strong>（含房價漲幅 3%）</li>
            <li><strong>租屋</strong>：月租 2.5 萬（年漲 2%），頭期 300 萬投資（5%），10 年後淨資產約 <strong>489 萬</strong></li>
            <li>房價持續上漲時，買房累積資產的速度通常勝過租屋</li>
        </ul>
        <blockquote>
            <strong>判斷原則：</strong>房價漲幅高、租金貴、且你打算長住 → 買房；房價漲幅低、投資報酬高、或你重視彈性 → 租屋＋投資。
        </blockquote>

        <p class="note-box">本比較為估算，未計裝潢/仲介/搬家等成本；房價與租金漲幅假設會大幅影響結果。</p>
    </div>
</ToolLayout>
