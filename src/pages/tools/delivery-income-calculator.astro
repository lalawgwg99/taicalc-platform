---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DeliveryIncomeCalculator from '../../components/calculators/DeliveryIncomeCalculator.vue';

const title = "外送收入計算｜UberEats、foodpanda 淨所得試算｜TaiCalc";
const description = "外送員實拿試算：輸入跑單收入，扣除油錢、機車折舊、保養與保險，算出真正的淨所得與時薪。";
const keywords = "外送收入計算,foodpanda收入,UberEats收入,外送員淨所得,外送油錢,外送成本計算,外送時薪,熊貓外送,ubereats外送,外送員報稅,外送勞健保";

const faqs = [
    {
        q: "外送員一個月能賺多少？",
        a: "全職月跑單收入常見3萬至5萬元，但這是「毛收入」；扣油錢、機車折舊保養、營業用保險與勞健保自付後，淨所得通常約毛收入6.5到8折。"
    },
    {
        q: "外送收入需要報稅嗎？",
        a: "需要，屬個人綜合所得稅範圍，隔年5月併入申報；歸類薪資所得或其他所得，視契約關係（僱傭或承攬）而定。建議每月提撥約5%收入作稅款預備金。"
    },
    {
        q: "跑外送機車保險要怎麼保？",
        a: "投保「營業用機車險」（第三人責任險＋超額責任險）：自用機車險事故時若認定為營業行為可拒絕理賠；營業用保費雖較貴，不能省。"
    },
    {
        q: "外送員有勞保和健保嗎？",
        a: "多數平台與外送員屬承攬關係，平台不幫投保勞健保；須自行透過職業工會加保，個人負擔較高（勞保約6成、健保約6成），計入每月成本。"
    },
    {
        q: "怎麼算外送的真實時薪？",
        a: "（當月跑單總收入 − 油錢 − 保養維修攤提 − 保險攤提 − 勞健保自付額）÷ 上線時數（含等單取餐送餐回程）；只用總收入除以時數會高估2到3成。"
    },
    {
        q: "外送專法上路後，每單真的有保底 45 元嗎？",
        a: "有，但要分兩種口徑看，不能混為一談。《外送員權益保障及外送平台管理法》2026 年 7 月 21 日上路，第 5 條規定每筆訂單基本報酬下限＝服務時間（分鐘）÷ 60 × 當年度最低工資時薪 × 1.25，且不得低於保障金額。第一種口徑是「時薪」：服務時間換算的時薪不得低於最低工資 1.25 倍，2026 年為 196 × 1.25 ＝ 245 元，2027 年為 205 × 1.25 ＝ 256.25 元（約 256 元）。第二種口徑是「每單」：每筆訂單基本報酬不得低於保障金額，2026 年為 45 元；保障金額每年隨最低工資調幅公告調整，2027 年按 45 × 205 ÷ 196 ≈ 47.07 元推估約 47 元，正式金額以主管機關公告為準。注意：等單時間不算在服務時間內，獎金不計入基本報酬檢核。詳細公式可看本站專法解讀文。"
    },
    {
        q: "專法後每單報酬變高，為什麼月底實拿可能反而變少？",
        a: "因為保底只管基本報酬下限，不管你一個月跑幾單、等單多久、獎金有沒有被砍。據三立新聞網 2026-10-30 報導，foodpanda 平均每單報酬增加 38%，等單時間卻也增加 43%；同樣上線時數，單量少了、趟次獎金變了，月底毛收入未必增加。判斷有沒有真的變多，要看淨時薪：（跑單總收入 − 油錢 − 保養維修攤提 − 保險攤提）÷ 實際上線時數，而且要把等單時間也算進去。下面對照表就是同樣 180 小時的兩種跑法試算。"
    },
    {
        q: "Uber 和熊貓，專法後哪家比較划算？",
        a: "不能只比平台公告的漲幅，要比扣成本、含等單時間的淨時薪。毛數字方面，據三立新聞網 2026-10-30 報導，Uber Eats 服務期間平均每小時報酬由 330 元提高至 420 元；foodpanda 平均每單報酬增加 38%，但等單時間也增加 43%，單量少了會抵銷單價漲幅。淨時薪算法：（跑單總收入 − 油錢 − 保養維修攤提 − 保險攤提）÷ 含等單、取餐、送餐、回程的實際上線時數。本頁下方對照表就是同樣 180 小時的兩種跑法：A 專法前常見跑法淨時薪 220 元，B 等單拉長、獎金減半淨時薪 181 元。報導數字是毛數字，不會寫入本頁計算機預設；要比哪家划算，把你上個月的實際數字代入計算機最準。"
    },
];

const sources = [
    { label: '勞動部（外送員權益保障專法主管機關）', href: 'https://www.mol.gov.tw/' },
    { label: '財政部（綜合所得稅申報）', href: 'https://www.mof.gov.tw/singlehtml/384fb3077bb349ea973e7fc6f13b6974?cntId=34b463dc8f1b49f29d440d92a6fd5139' },
    { label: '三立新聞網（外送專法後實況報導）', href: 'https://www.setn.com/news/1930702' },
];
---

<ToolLayout title={title} description={description} keywords={keywords} category="工作計算" faqs={faqs} sources={sources} lastUpdated="2026-11-03">
    <DeliveryIncomeCalculator client:only="vue" slot="tool" />

    <div slot="article">
        <h2>跑外送真的好賺嗎？揭密騎士的真實時薪</h2>
        <p>外送平台的高薪神話已成過去式，取而代之的是更精算的獎勵機制。想要在外送戰場生存，您不能只看「跑單總收入」，更要學會計算「淨利」。同樣月入 4 萬的外送員，扣除成本後一個可能實拿 3.2 萬，另一個只剩 2.6 萬，差別全在成本有沒有算清楚。</p>

        <h3>外送收入的三層算法</h3>
        <ul class="list-disc pl-5 space-y-2">
            <li><strong>第一層：平台顯示金額</strong> —— 跑單費、趟次獎勵、加碼時段的總和。這是毛收入，不是你的薪水。</li>
            <li><strong>第二層：扣除變動成本</strong> —— 油錢、機車耗損（黑油、輪胎、煞車皮、傳動）。市區走走停停最耗油，耗材更換頻率是一般通勤的 3 到 5 倍。</li>
            <li><strong>第三層：扣除固定成本</strong> —— 營業用機車險、職業工會勞健保自付額、手機資費。這些不管跑多跑少，每月照樣支出。</li>
        </ul>
        <p>三層扣完剩下的，才是你真正賺到的錢。建議每個月結算一次，如果連續兩個月淨時薪低於你的底線（例如低於基本工資換算時薪），就該調整跑單策略或考慮轉換跑道。</p>

        <p><strong>專法上路後，毛時薪數字會騙人：</strong>據三立新聞網 2026-10-30 報導，foodpanda 平均每單報酬增加 38%、等單時間卻也增加 43%，Uber Eats 服務期間平均每小時報酬由 330 元提高至 420 元。這些都是未扣成本的毛數字；等單拉長、趟次獎金變動都會吃掉漲幅。算淨時薪要用（跑單總收入 − 油錢 − 保養維修攤提 − 保險攤提 − 勞健保自付額）÷ 實際上線時數，而且要把等單、取餐、送餐、回程的時間全部計入，才是真正落袋的時薪。上述報導數字僅為背景新聞，不會寫入本站計算機預設。</p>

        <h3>同樣每月上線 180 小時，兩種跑法對照（假設試算）</h3>
        <p>下表用本頁計算機公式實算（油價 30 元、油耗 35 公里／公升、保養攤提 0.8 元／公里、保險每月 1,500 元）。A 是專法前常見跑法；B 假設等單拉長使單量少一成、趟次獎金減半。數字是假設情境、不是平台官方數據，重點是看「等單與獎金」怎麼吃掉漲幅。</p>
        <div class="overflow-x-auto">
        <table>
            <thead><tr><th class="whitespace-nowrap">跑法</th><th class="whitespace-nowrap">毛收入（每月）</th><th class="whitespace-nowrap">油錢</th><th class="whitespace-nowrap">保養攤提</th><th class="whitespace-nowrap">淨所得（每月）</th><th class="whitespace-nowrap">淨時薪</th></tr></thead>
            <tbody>
                <tr><td class="whitespace-nowrap">A：專法前常見跑法</td><td class="whitespace-nowrap">45,000 元（38,000＋7,000）</td><td class="whitespace-nowrap">2,057 元</td><td class="whitespace-nowrap">1,920 元</td><td class="whitespace-nowrap">39,523 元</td><td class="whitespace-nowrap">220 元</td></tr>
                <tr><td class="whitespace-nowrap">B：等單拉長、獎金減半</td><td class="whitespace-nowrap">37,700 元（34,200＋3,500）</td><td class="whitespace-nowrap">1,851 元</td><td class="whitespace-nowrap">1,728 元</td><td class="whitespace-nowrap">32,621 元</td><td class="whitespace-nowrap">181 元</td></tr>
            </tbody>
        </table>
        </div>
        <p>同樣 180 小時，淨所得少 6,902 元（約 17.5%）、淨時薪從 220 元掉到 181 元。結論：每單漲幅要先扣掉「少跑的單」和「被砍的獎金」才算數；把你上個月的實際數字代入本頁計算機，比看平台公告的漲幅準。想對照正職收入，可用<a href="/tools/salary-calculator">薪資實拿計算機</a>算月薪實拿，再跟淨時薪換算的月收比較。</p>

        <h3>新手最常忽略的三筆錢</h3>
        <ul class="list-disc pl-5 space-y-2">
            <li><strong>稅：</strong> 外送所得要併入綜合所得稅申報。每月先提撥約 5% 當稅款預備金，報稅季才不會措手不及。</li>
            <li><strong>勞健保：</strong> 平台多半不幫你保，自行加入職業工會是必要支出，也是你的職災與醫療保障。</li>
            <li><strong>車輛折舊：</strong> 一台 7 萬元的機車，全職跑兩年就接近報廢年限。把購車成本攤提到每個月，才是誠實的算法。</li>
        </ul>

        <blockquote>
            <strong>商業保險：</strong> 無論是 UberEats 或 foodpanda，都強烈建議投保「營業用機車險」（第三責任險+超額）。因為一般自用機車險在「營業行為」發生事故時是<strong>不理賠</strong>的。
        </blockquote>

        <h3>提高淨利的三個實戰方向</h3>
        <ul class="list-disc pl-5 space-y-2">
            <li><strong>挑時段不挑單量：</strong> 餐期加碼時段的單均價最高，離峰時段空等油錢照燒，時薪反而更低。</li>
            <li><strong>固定熱區減少空車：</strong> 熟悉 2 到 3 個店家密集的熱區，縮短取餐等待與空車里程。</li>
            <li><strong>記帳：</strong> 用本站計算機每月結算一次，連續記錄三個月，你會清楚知道自己的真實時薪曲線。</li>
        </ul>

        <h2>外送專法上路後的三件事（2026 年 7 月 21 日起）</h2>
        <p>《外送員權益保障及外送平台管理法》上路後，跑單收入多了法定下限，直接影響你的試算基準：</p>
        <ul class="list-disc pl-5 space-y-2">
            <li><strong>每單保底 45 元（每單口徑）：</strong> 每筆訂單的基本報酬不得低於保障金額，2026 年為 45 元；保障金額每年隨最低工資調幅公告調整，2027 年按 45 × 205 ÷ 196 ≈ 47.07 元推估約 47 元，正式金額以主管機關公告為準。低於下限的派單結構可以直接檢舉。</li>
            <li><strong>時薪下限 1.25 倍（時薪口徑）：</strong> 以外送服務時間（不含等單）換算，時薪不得低於最低工資 1.25 倍；算式為時薪 × 1.25，2026 年為 196 × 1.25 ＝ 245 元，2027 年為 205 × 1.25 ＝ 256.25 元（約 256 元）。256 元是時薪下限、47 元是每單保障金額推估值，兩者口徑不同，不要直接比較。</li>
            <li><strong>職災保障：</strong> 平台須為外送員投保相關保險並提撥職災補償準備，跑單途中的保障不再是零。</li>
        </ul>
        <p>想搞懂保底公式怎麼算、疊單怎麼拆，看這兩篇：<a href="/blog/2026-delivery-worker-protection-act-pay-guide">外送專法計酬公式全解讀（45 元與 245 元怎麼來）</a>、<a href="/blog/2026-delivery-monthly-income-after-new-act">專法上路後實測月收＋3 種時數試算</a>。算完也可以回本頁把保底金額代入，當作收入下限來試算。</p>
    </div>
</ToolLayout>
