---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DecisionCalculator from '../../components/calculators/DecisionCalculator.vue';
import IntentPanel from '../../components/IntentPanel.astro';
const sources = [
  { label: '勞動部｜勞退新制資遣費', href: 'https://www.mol.gov.tw/1607/28162/28540/28564/28568/30457/' },
  { label: '勞動基準法第 16 條｜預告期間', href: 'https://laws.mol.gov.tw/FLAW/FLAWDOC01.aspx?flno=16&id=FL014930' },
  { label: '勞動部｜預告工資計算', href: 'https://www.mol.gov.tw/1607/28690/2282/2326/2288/82265/post' },
  { label: '勞動部｜未休特休工資', href: 'https://www.mol.gov.tw/1607/28690/2282/2284/2290/7171/' },
  { label: '勞動部｜失業給付', href: 'https://www.mol.gov.tw/1607/28162/28472/28480/28482/29195/?cprint=pt' },
];
const faqs = [
  { q: '自願離職也有資遣費嗎？', a: '一般自願離職沒有資遣費與資遣預告工資；本工具是以雇主依法資遣、且年資適用勞退新制為主要情境。' },
  { q: '未休特休一天怎麼算？', a: '月薪制勞工原則上以契約終止前最近一個月正常工資除以 30 作為一日工資基礎。' },
  { q: '資遣費怎麼算？新制和舊制差在哪？', a: '新制每滿1年0.5個月平均工資、最高6個月；舊制每滿1年1個月。基數為離職前6個月平均工資。' },
  { q: '年資未滿一年，資遣費怎麼算？', a: '新制按比例算：每滿1年0.5個月平均工資。例：平均工資45,000元、做8個月，45,000×0.5×8/12＝15,000元；做滿1年是22,500元。未滿3個月也有資遣費，只是沒有預告期。（勞工退休金條例第12條）' },
  { q: '年資未滿一年，預告期是幾天？', a: '未滿3個月0天，3個月至1年10天，1至3年20天，3年以上30天（勞基法第16條）。' },
  { q: '試用期沒過被資遣，有資遣費嗎？', a: '有。試用期勞工被依法資遣，仍按新制依年資比例發資遣費，離職後30日內給付；未滿3個月雖無預告期，資遣費照算。（勞工退休金條例第12條）' },
  { q: '資遣費要扣稅嗎？', a: '屬退職所得，定額免稅：2026年一次領取「20.6萬元×年資」以下免稅，超過部分按級距計入所得，多半免稅。（所得稅法第14條第1項第9類；財政部公告）' },
  { q: '被資遣後，預告期間可以請謀職假嗎？', a: '可以。預告期間內每週最多請2日、工資照給；雇主直接給預告工資代替預告時沒有謀職假。' },
  { q: '什麼是非自願離職？', a: '雇主依勞基法第11條終止契約（如歇業、虧損、業務性質變更、不能勝任工作）就是非自願離職，可領資遣費，並可憑離職證明向公立就業服務機構申請失業給付；自願離職一般兩者皆無。' },
];
---
<ToolLayout title="離職結算計算器｜資遣費、預告工資、特休" description="一次估算勞退新制資遣費、預告期間工資、未休特休與最後薪資。" keywords="資遣費計算,離職結算,預告工資,未休特休,最後薪資" category="工作與收入" kicker="離開公司前，先把每一筆應結清的項目列出來。" faqs={faqs} dataVersion="2026.07-labor-v1" dataYear="現行勞動法規" lastUpdated="2026-11-22" sources={sources}>
  <DecisionCalculator type="separation" client:only="vue" slot="tool" />
  <IntentPanel
    slot="after-tool"
    source="severance"
    partnerTitle="勞動權益服務"
  />
  <div slot="article"><h2>適用範圍</h2><p>資遣費採勞退新制：每滿一年發給二分之一個月平均工資，未滿一年按比例，最高六個月。預告工資依年資判斷 0、10、20 或 30 天，再扣除雇主已給的預告天數；一日工資取最近正常月薪除以 30 與日平均工資較高者。</p><p>舊制年資、職災、退休、定期契約或工資認定有爭議時，應帶薪資明細與契約向地方勞工主管機關確認。</p><h2>年資案例：平均工資 45,000 元試算</h2><p>基數為離職前 6 個月平均工資全薪；新制未滿 1 年按比例，最高 6 個月。</p><div class="overflow-x-auto"><table><thead><tr><th>年資情境</th><th>計算方式</th><th>資遣費</th></tr></thead><tbody><tr><td>新制 1 年</td><td>0.5 個月</td><td class="whitespace-nowrap">22,500 元</td></tr><tr><td>新制 5 年</td><td>2.5 個月</td><td class="whitespace-nowrap">112,500 元</td></tr><tr><td>新制 5 年 6 個月</td><td class="whitespace-nowrap">2.75 個月（6 個月按比例折 0.25 個月）</td><td class="whitespace-nowrap">123,750 元</td></tr><tr><td>新制 10 年</td><td>5 個月</td><td class="whitespace-nowrap">225,000 元</td></tr><tr><td>新制 12 年以上</td><td>6 個月（上限）</td><td class="whitespace-nowrap">270,000 元</td></tr><tr><td>舊制 5 年</td><td>5 個月</td><td class="whitespace-nowrap">225,000 元</td></tr><tr><td>舊制 10 年</td><td>10 個月</td><td class="whitespace-nowrap">450,000 元</td></tr></tbody></table></div><h2>新制與舊制對照</h2><div class="overflow-x-auto"><table><thead><tr><th>項目</th><th>新制（94/7/1 後年資）</th><th>舊制（94/7/1 前年資）</th></tr></thead><tbody><tr><td>計算方式</td><td>每滿 1 年發 0.5 個月平均工資，未滿 1 年按比例</td><td>每滿 1 年發 1 個月平均工資</td></tr><tr><td>最高月數</td><td>6 個月</td><td>無 6 個月上限（依年資累計）</td></tr><tr><td>法源</td><td>勞工退休金條例第 12 條</td><td>勞動基準法第 17 條</td></tr></tbody></table></div><h2>預告期對照（勞動基準法第 16 條）</h2><div class="overflow-x-auto"><table><thead><tr><th>繼續工作年資</th><th>預告天數</th></tr></thead><tbody><tr><td>未滿 3 個月</td><td>0 天（無預告期，資遣費照算）</td></tr><tr><td>滿 3 個月未滿 1 年</td><td>10 天</td></tr><tr><td>滿 1 年未滿 3 年</td><td>20 天</td></tr><tr><td>滿 3 年以上</td><td>30 天</td></tr></tbody></table></div><h2>預告工資與特休折算金額例（月薪 45,000 元）</h2><p>一日工資＝45,000 ÷ 30＝1,500 元。預告工資＝預告天數 × 一日工資；特休折算＝未休天數 × 一日工資（勞基法第 38 條第 4 項：契約終止而未休之日數，雇主應發給工資）。</p><div class="overflow-x-auto"><table><thead><tr><th>項目</th><th>天數</th><th>金額</th></tr></thead><tbody><tr><td>預告工資（滿 3 個月未滿 1 年）</td><td class="whitespace-nowrap">10 天</td><td class="whitespace-nowrap">15,000 元</td></tr><tr><td>預告工資（滿 1 年未滿 3 年）</td><td class="whitespace-nowrap">20 天</td><td class="whitespace-nowrap">30,000 元</td></tr><tr><td>預告工資（滿 3 年以上）</td><td class="whitespace-nowrap">30 天</td><td class="whitespace-nowrap">45,000 元</td></tr><tr><td>特休折算（未休 5 天）</td><td class="whitespace-nowrap">5 天</td><td class="whitespace-nowrap">7,500 元</td></tr><tr><td>特休折算（未休 10 天）</td><td class="whitespace-nowrap">10 天</td><td class="whitespace-nowrap">15,000 元</td></tr></tbody></table></div><p>預告工資為預告天數乘一日工資，再扣除雇主已給的預告天數；一日工資取最近正常月薪除以 30 與日平均工資較高者。以上案例為試算情境，實際金額以個人薪資明細與契約為準。</p><h2>被資遣後下一步：失業給付</h2><p>拿到資遣費不是結束。非自願離職可申請就業保險失業給付：退保當日前 3 年內就保年資滿 1 年以上、有工作能力及繼續工作意願，向公立就業服務機構辦理求職登記，14 日內仍無法推介就業或安排職業訓練，即可請領。給付按離職前 6 個月平均月投保薪資 60% 按月發給，最長 6 個月；離職時滿 45 歲或領有身心障礙證明最長 9 個月；扶養無工作收入眷屬每人加給 10%，最多 20%。申請時帶離職證明、身分證到公立就業服務機構辦理求職登記與失業認定；認定完成後勞保局約 10 個工作日內核付。續領須每月辦理失業再認定並提供求職紀錄。</p><p>另外注意：雇主須在離職後 30 日內給付資遣費（勞工退休金條例第 12 條）；逾期未給，可向地方勞工主管機關申訴檢舉。</p></div>
</ToolLayout>
