---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ElectricityCalculator from '../../components/calculators/ElectricityCalculator.vue';
import ElectricityCompare from '../../components/calculators/ElectricityCompare.vue';
import ApplianceEnergyCompare from '../../components/calculators/ApplianceEnergyCompare.vue';
import { coreToolGovernance } from '../../data/regulatoryMetadata';

const title = "電費計算機｜一度電 1.78～8.86 元，3 秒算 2026 台電電費";
const description = "每月 350 度電費：非夏月約 752 元、夏月約 826 元；一度電 1.78～8.86 元，輸入度數 3 秒算出電費，免註冊免費試算。";
const keywords = "電費計算機,電費試算,電費計算線上,冷氣電費計算機,台電電費,累進電價,夏月電費,非夏月電費,省電試算,冷氣耗電,BTU/h,CSPF,一度電多少錢,租屋電費,家電耗電比較,節能標章,每年耗電量";
const governance = coreToolGovernance.electricity;

const faqs = [
    {
        q: "台電帳單的「用電度數」怎麼計算？",
        a: "台電多為每兩個月抄一次表，帳單度數通常是雙月用量。1度電＝1千瓦時（kWh）＝1,000W電器用1小時；換算月用量先將帳單度數除以2再輸入。"
    },
    {
        q: "台電累進電費怎麼算？夏月和非夏月差多少？",
        a: "台電住家電費採累進費率：300度/月約非夏月621元、夏月673元，對照雙月帳單再乘以2；高用電級距採現行費率，低用電納入每月最低計收100元。"
    },
    {
        q: "冷氣開一天大概多少電費？",
        a: "電功率kW、BTU/h配COP/CSPF，或冷房kW換算。如12,000 BTU/h、COP 4.0冷氣約0.88 kW；日開8小時，月約211度。"
    },
    {
        q: "家裡哪個電器最耗電？",
        a: "依序：電熱水器約1,200W、冷氣900W～3,600W（大型可到5kW～10kW以上）、電磁爐、烘乾機各1,800W、老舊冰箱150～200W。"
    },
    {
        q: "BTU/h、COP、CSPF 分別是什麼？",
        a: "BTU/h與冷房能力kW都是冷房能力，1 kW約3,412 BTU/h；COP是即時效率，冷房能力÷COP推估功率；CSPF是季節效率，粗估整季耗電。"
    },
    {
        q: "如何有效降低夏季電費？",
        a: "冷氣設26～28°C，搭配電扇可省電10～20%；每月洗一次濾網；夏季尖峰減少高耗電家電同時運轉；換用LED燈泡。"
    },
    {
        q: "租屋電費一度 5 元合理嗎？房東這樣收算超收嗎？",
        a: "很可能超收：300度非夏月621、夏月673元，5元/度1,500元，約2.2～2.4倍；2024年7月新制，房東不得逾「每度平均電價」，超收可返還。"
    },
    {
        q: "兩房小家庭一個月電費大概多少？",
        a: "兩大一小：非夏月每月約400度、約908元；夏天每月約650度、約2,167元，雙月帳單一次約4,334元。度數與季節不同，漲幅不能直接對比。"
    },
    {
        q: "冷氣開整晚（8 小時）一個月要多花多少電費？",
        a: "輸入功率0.9 kW變頻冷氣：0.9 kW×8小時×30天＝216度，非夏月約431元/月、夏月約459元/月；噸數須配對坪數，不足反而更耗電。"
    },
    {
        q: "一級能效冰箱一年電費多少？換掉老冰箱省多少？",
        a: "看能源效率標示的「年耗電量」。以年耗電 300 度的一級能效冰箱為例，月均 25 度，25 × 1.78＝44.5 元，未達每月最低計收 100 元，以 100 元計收，一年電費約 1,200 元。老舊冰箱（200W 全年不停，年耗電約 1,752 度）一年電費約 3,276 元，換新一年可省約 2,076 元。"
    },
    {
        q: "為什麼夏天的電費帳單特別貴？",
        a: "台電多為雙月抄表；6～9月適用較貴夏月費率。小家庭夏天每月650度，單月2,167元，雙月帳單一次約4,334元，不是被多收。"
    },
    {
        q: "為什麼現在的電費比 20 年前還便宜？",
        a: "120 度以下每度 1.78 元，比 2004 年的 2.1 元還便宜：2015 年電價三連降，之後幾次調漲民生 330 度以下都凍漲，直到 2024 年 4 月才結束。代價是台電吸收價差，2026 年 10 月每度售電成本已達 3.64 元。（太報 2026-11-07）"
    },
    {
        q: "12 月電價審議會若調漲，我家電費會漲多少？",
        a: "仍以審議會決議為準。按 9 月審議提報的平均應調 12.83% 粗估：350 度非夏月 752 元漲到約 849 元、多約 97 元，夏月 826 元漲到約 932 元；實際若按級距分開調整，數字會不同。本頁「若漲 12.83%」有對照表。"
    },
    {
        q: "電費試算線上做要準備什麼資料？",
        a: "只要帳單度數：輸入每月用電度數即算出夏月與非夏月金額；雙月抄表先除以2再輸入。級距單價採台電2026-04-01住宅費率，一度電1.78～8.86元。"
    },
];
---

<ToolLayout
    title={title}
    description={description}
    keywords={keywords}
    category="生活計算"
    compactHero
    faqs={faqs}
    dataVersion={governance.version}
    dataYear={governance.dataYear}
    lastUpdated={governance.updatedAt}
    sources={governance.sources}
>
    <div slot="tool">
        <section class="ec-hero" aria-label="一度電多少錢速答">
            <p class="ec-hero-kicker">一度電多少錢？</p>
            <p class="ec-hero-big">1.78 <span class="ec-hero-tilde">～</span> 8.86 <span class="ec-hero-unit">元 / 度</span></p>
            <p class="ec-hero-note">雙月帳單先除以 2 再輸入，立刻算出夏月與非夏月金額。</p>
        </section>

        <section class="ec-section" id="calculator" aria-label="電費試算">
            <h2 class="ec-h2">電費試算</h2>
            <ElectricityCalculator client:only="vue" />
        </section>

        <details class="ec-section ec-collapse" aria-label="電價審議追蹤">
            <summary class="ec-summary">12 月電價審議追蹤（尚未定案）<span class="ec-summary-hint">點開看進展</span></summary>
            <p class="ec-lead">台電 2026 年 9 月電價審議會提報平均電價應調 12.83%，審議會決議優先爭取政府 711 億元撥補，並預留伏筆、將在 12 月第 3 次電價審議會審議輸配電費率時一併討論電價；若 12 月作成調整，新費率自 2027 年 1 月 1 日起適用（9 月 18 日審議會結論）。台電 10 月 22 日說法：今年民生用電估計吸收逾 760 億元，民生高用電度數會被優先討論。11 月 4 日立法院聯席會議審查 115 年度追加預算案（台電撥補 711 億元），立委質詢提議中油、台電各砍 500 億元，撥補能否全額通過尚未定案；台電董事長曾文生同日表示今年民生用電已吸收逾 750 億元。11 月 5 日立法院財政等 7 個委員會聯席會議完成 115 年度追加預算案初審，台電 711 億元撥補因朝野無共識全數保留送院會處理、須先經黨團協商，依 10 月 30 日朝野協商結論於 11 月 20 日前完成三讀；台電同日表示，今年吸收補貼民生用電已逾 750 億元，其中每月 700 度以下的一般住宅及小商家約 1,300 萬戶、就吸收約 720 億元。11 月 7 日太報引台電說法：10 月每度售電成本已攀升至 3.64 元，民生 120 度以下每度僅售 1.78 元。以上皆為審議前說法，12 月是否調漲、調多少，仍以電價審議會決議為準；本頁費率維持台電 2026-04-01 住宅費率。</p>
        </details>

        <details class="ec-section ec-collapse" aria-label="若漲價情境試算">
            <summary class="ec-summary">若漲 12.83%，電費差多少？</summary>
            <p class="ec-lead">以下只是把 9 月審議提報的平均電價應調幅度 12.83% 套用到同一用電量的粗估，12 月是否調漲、調多少，仍以電價審議會決議與台電公告費率為準；本頁計算機仍用現行費率。實際調幅若按級距分開調整，數字會與粗估不同。</p>
            <div class="ec-tablewrap"><table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="border-b border-paper-300 text-left text-ink-400">
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">每月用電</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">現行電費</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">若漲 12.83%</th>
                        <th class="py-2 font-medium whitespace-nowrap">差額</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-paper-200 text-ink-600">
                    <tr><td class="py-2 pr-3 whitespace-nowrap">非夏月 350 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">約 $752</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">約 $849</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">多約 $97</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">夏月 350 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">約 $826</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">約 $932</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">多約 $106</td></tr>
                </tbody>
            </table></div>
        </details>

        <div class="ec-duo">
        <section class="ec-section" aria-label="四種家庭實際案例">
            <h2 class="ec-h2">四種家庭的實際電費</h2>
            <p class="ec-lead">直接看數字最有感，皆以台電 2026-04-01 住宅費率試算：</p>
            <div class="ec-tablewrap"><table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="border-b border-paper-300 text-left text-ink-400">
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">家庭型態</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">每月用電</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">非夏月</th>
                        <th class="py-2 font-medium whitespace-nowrap">夏月</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-paper-200 text-ink-600">
                    <tr><td class="py-2 pr-3 whitespace-nowrap">單身租屋族</td><td class="py-2 pr-3 whitespace-nowrap">200 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">395 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">418 元</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">小資租屋</td><td class="py-2 pr-3 whitespace-nowrap">300 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">621 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">673 元</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">兩房小家庭</td><td class="py-2 pr-3 whitespace-nowrap">500 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">1,221 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">1,396 元</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">大家庭（透天）</td><td class="py-2 pr-3 whitespace-nowrap">800 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">2,596 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">3,068 元</td></tr>
                </tbody>
            </table></div>
            <p class="text-xs text-ink-400 mt-2">台電多為雙月抄表，實際帳單約為上表 × 2。同樣度數直接比較：夏月費率較貴，度數越高差距越大。</p>
        </section>

        <section class="ec-section" id="tiers" aria-label="級距速查表">
            <h2 class="ec-h2">六段級距單價速查 <span class="ec-h2-sub">元/度</span></h2>
            <div class="ec-tablewrap"><table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="border-b border-paper-300 text-left text-ink-400">
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">每月用電</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">夏月</th>
                        <th class="py-2 font-medium whitespace-nowrap">非夏月</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-paper-200 text-ink-600">
                    <tr><td class="py-2 pr-3 whitespace-nowrap">120 度以下</td><td class="py-2 pr-3 font-semibold text-ink-700">1.78</td><td class="py-2 font-semibold text-ink-700">1.78</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">121～330 度</td><td class="py-2 pr-3 font-semibold text-ink-700">2.55</td><td class="py-2 font-semibold text-ink-700">2.26</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">331～500 度</td><td class="py-2 pr-3 font-semibold text-ink-700">3.80</td><td class="py-2 font-semibold text-ink-700">3.13</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">501～700 度</td><td class="py-2 pr-3 font-semibold text-ink-700">5.14</td><td class="py-2 font-semibold text-ink-700">4.24</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">701～1,000 度</td><td class="py-2 pr-3 font-semibold text-ink-700">6.44</td><td class="py-2 font-semibold text-ink-700">5.27</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">1,001 度以上</td><td class="py-2 pr-3 font-semibold text-ink-700">8.86</td><td class="py-2 font-semibold text-ink-700">7.03</td></tr>
                </tbody>
            </table></div>
            <p class="text-xs text-ink-400 mt-2">台電 2026-04-01 起實施費率；雙月抄表者各級距度數加倍。</p>
        </section>
        </div>

        <section class="ec-section" aria-label="夏月 vs 非夏月">
            <h2 class="ec-h2">夏月 vs 非夏月</h2>
            <p class="ec-lead">6～9 月適用較貴的夏月費率。同樣度數，夏天就是比較貴——直接比較看看差多少：</p>
            <div class="ec-tablewrap"><table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="border-b border-paper-300 text-left text-ink-400">
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">每月用電</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">非夏月</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">夏月</th>
                        <th class="py-2 font-medium whitespace-nowrap">夏月多付</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-paper-200 text-ink-600">
                    <tr><td class="py-2 pr-3 whitespace-nowrap">200 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">395 元</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">418 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">多 23 元</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">350 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">752 元</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">826 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">多 74 元</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">500 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">1,221 元</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">1,396 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">多 175 元</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">700 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">2,069 元</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">2,424 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">多 355 元</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">1,000 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">3,650 元</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">4,356 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">多 706 元</td></tr>
                </tbody>
            </table></div>
            <p class="text-xs text-ink-400 mt-2">以台電 2026-04-01 住宅費率逐級計價：每級距金額四捨五入至元後加總；度數越高、夏月貴的差距越大。下方互動比較器可輸入自己的度數即時對照。</p>
            <ElectricityCompare client:only="vue" />
        </section>

        <section class="ec-section" aria-label="比家電">
            <h2 class="ec-h2">比家電：誰是吃電怪獸？</h2>
            <p class="ec-lead">看不懂能源效率標示？選家電類型，照著黃色指引找到標示上的數字，3 台家電直接比年電費：</p>
            <ApplianceEnergyCompare client:only="vue" />
        </section>
    </div>

    <style>
        .ec-hero { background: linear-gradient(135deg, #14532d 0%, #166534 60%, #15803d 100%); border-radius: 1.25rem; padding: 2rem 1.5rem; margin-bottom: 2rem; text-align: center; color: #fff; box-shadow: 0 8px 24px rgba(20,83,45,.25); }
        .ec-hero-kicker { font-size: 0.9rem; font-weight: 700; color: #bbf7d0; margin: 0 0 0.5rem; letter-spacing: .05em; }
        .ec-hero-big { font-size: 2.75rem; font-weight: 800; margin: 0; line-height: 1.15; font-variant-numeric: tabular-nums; }
        .ec-hero-tilde { color: #bbf7d0; font-weight: 600; }
        .ec-hero-unit { font-size: 1.1rem; font-weight: 600; color: #dcfce7; }
        .ec-hero-note { font-size: 0.85rem; color: #dcfce7; line-height: 1.7; margin: 0.9rem auto 0; max-width: 34rem; }
        .ec-section { margin-bottom: 2.25rem; }
        .ec-summary { cursor: pointer; font-size: 1.2rem; font-weight: 800; color: #25231F; margin: 0 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 2px solid rgba(20,83,45,.15); list-style: none; }
        .ec-summary::-webkit-details-marker { display: none; }
        .ec-summary::marker { content: ''; }
        .ec-summary-hint { font-size: 0.8rem; font-weight: 600; color: #78716c; margin-left: 0.5rem; }
        .ec-h2 { font-size: 1.2rem; font-weight: 800; color: #25231F; margin: 0 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 2px solid rgba(20,83,45,.15); }
        .ec-h2-sub { font-size: 0.8rem; font-weight: 600; color: #78716c; }
        .ec-lead { font-size: 0.9rem; color: #57534e; line-height: 1.7; margin: 0 0 1rem; }
        .ec-tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #E8E4DA; border-radius: 0.75rem; background: #FFFDF7; }
        .ec-tablewrap table { min-width: 100%; }
        .ec-tablewrap th, .ec-tablewrap td { padding-left: 0.75rem; }
        .ec-tablewrap th:first-child, .ec-tablewrap td:first-child { padding-left: 1rem; }
