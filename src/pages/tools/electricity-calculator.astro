---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ElectricityCalculator from '../../components/calculators/ElectricityCalculator.vue';
import ElectricityCompare from '../../components/calculators/ElectricityCompare.vue';
import ApplianceEnergyCompare from '../../components/calculators/ApplianceEnergyCompare.vue';
import { coreToolGovernance } from '../../data/regulatoryMetadata';

const title = "電費計算機｜一度電多少錢？2026台電電費試算＋家電耗電比一比";
const description = "台電一度電多少錢？輸入每月用電度數，3秒算出夏月／非夏月電費金額。支援冷氣噸數換算、電器耗電估算、夏月非夏月比較；另有「比家電」分頁，輸入節能標示年耗電量比較3台家電電費。2026最新費率，免註冊免費試算。";
const keywords = "電費計算機,冷氣電費計算機,台電電費,累進電價,夏月電費,非夏月電費,省電試算,冷氣耗電,BTU/h,CSPF,一度電多少錢,租屋電費,家電耗電比較,節能標章,每年耗電量";
const governance = coreToolGovernance.electricity;

const faqs = [
    {
        q: "台電累進電費怎麼算？夏月和非夏月差多少？",
        a: "台電住家電費採累進費率，且帳單多半是雙月抄表。本工具以「每月」度數估算：300 度/月約為非夏月 621 元、夏月 673 元；若對照雙月帳單，可再乘以 2。高用電級距已採現行費率，低用電則納入每月最低計收 100 元。"
    },
    {
        q: "冷氣開一天大概多少電費？",
        a: "現在可用三種方式估算：直接輸入電功率 kW、輸入冷房能力 BTU/h 搭配 COP/CSPF，或輸入冷房能力 kW 再換算。例如 12,000 BTU/h、COP 4.0 的冷氣，推估輸入功率約 0.88 kW；每天開 8 小時，一個月約 211 度。"
    },
    {
        q: "家裡哪個電器最耗電？",
        a: "耗電怪獸依序通常是：電熱水器（約 1,200W）、冷氣（家用約 900W～3,600W，大型或商用機種可到 5kW～10kW 以上）、電磁爐（1,800W）、烘乾機（1,800W）、老舊冰箱（150～200W，全年不停）。建議用插座型電表或設備銘板量測各電器實際耗電，比估算更準確。"
    },
    {
        q: "BTU/h、COP、CSPF 分別是什麼？",
        a: "BTU/h 與冷房能力 kW 都是在描述冷氣的冷房能力；1 kW 冷房能力約等於 3,412 BTU/h。COP 是即時效率，冷房能力 ÷ COP 可推估當下輸入功率；CSPF 是季節效率，適合拿來粗估整季平均耗電，但不等於每一分鐘的實際功率。"
    },
    {
        q: "台電帳單的「用電度數」怎麼計算？",
        a: "台電多為每兩個月抄一次表，帳單上的「度數」通常是雙月用電量。1 度電 = 1 千瓦時（kWh）= 1,000W 電器使用 1 小時。若想換算成月用量，可先將帳單度數除以 2，再輸入本工具。"
    },
    {
        q: "如何有效降低夏季電費？",
        a: "幾個省電實招：(1) 冷氣設定 26～28°C，搭配電扇可省電 10～20%；(2) 每月清洗一次濾網；(3) 夏季尖峰減少高耗電家電同時運轉；(4) 換用 LED 燈泡；(5) 若已知冷氣 BTU/h 與 COP/CSPF，可先用本工具找出耗電是否異常，再決定是否換機。"
    },
    {
        q: "租屋電費一度 5 元合理嗎？房東這樣收算超收嗎？",
        a: "很可能超收。以每月用電 300 度為例，台電實收金額為非夏月 621 元、夏月 673 元；房東若按一度 5 元收就是 1,500 元，約為台電實價的 2.2～2.4 倍。2024 年 7 月上路的租屋電費新制規定，房東按度計費不得超過電費單的「每度平均電價」，超收部分房客可要求返還。簽約前先用本工具算出台電實價，再跟房東談。"
    },
    {
        q: "兩房小家庭一個月電費大概多少？",
        a: "以兩大一小、冷氣加電熱水器加家電齊全為例：非夏月每月約 400 度，電費約 908 元；夏天冷氣全開每月約 650 度，電費約 2,167 元。台電多為雙月抄表，夏天的雙月帳單會一次看到約 4,334 元，先有心理準備就不會被嚇到。"
    },
    {
        q: "冷氣開整晚（8 小時）一個月要多花多少電費？",
        a: "以輸入功率 0.9 kW 的變頻冷氣為例：0.9 kW × 8 小時 × 30 天＝216 度電，換算電費非夏月約 431 元/月、夏月約 459 元/月。另外提醒：冷氣噸數要配對房間坪數，噸數不足時壓縮機全速運轉反而更耗電。"
    },
    {
        q: "一級能效冰箱一年電費多少？換掉老冰箱省多少？",
        a: "看能源效率標示的「年耗電量」。以年耗電 300 度的一級能效冰箱為例，月均 25 度，25 × 1.78＝44.5 元，未達每月最低計收 100 元，以 100 元計收，一年電費約 1,200 元。老舊冰箱（200W 全年不停，年耗電約 1,752 度）一年電費約 3,276 元，換新一年可省約 2,076 元。"
    },
    {
        q: "為什麼夏天的電費帳單特別貴？",
        a: "兩個原因疊加：第一，台電多為每兩個月抄表，帳單金額是兩個月的用量；第二，6～9 月適用較貴的夏月費率。以小家庭夏天每月 650 度為例，單月電費 2,167 元，雙月帳單一次就是約 4,334 元，看起來嚇人但公式正確，不是被多收。"
    },
];
---

<ToolLayout
    title={title}
    description={description}
    keywords={keywords}
    category="生活計算"
    compactHero
    faqs={faqs}
    dataVersion={governance.version}
    dataYear={governance.dataYear}
    lastUpdated={governance.updatedAt}
    sources={governance.sources}
>
    <div slot="tool">
        <section class="ec-hero" aria-label="一度電多少錢速答">
            <p class="ec-hero-kicker">一度電多少錢？</p>
            <p class="ec-hero-big">1.78 <span class="ec-hero-tilde">～</span> 8.86 <span class="ec-hero-unit">元 / 度</span></p>
            <p class="ec-hero-note">台電住家採累進費率：120 度以下最便宜，超過 1,000 度夏月最貴。往下輸入度數，3 秒算出你的電費。</p>
        </section>

        <section class="ec-section" aria-label="電費試算">
            <h2 class="ec-h2">電費試算</h2>
            <ElectricityCalculator client:only="vue" />
        </section>

        <div class="ec-duo">
        <section class="ec-section" aria-label="三種家庭實際案例">
            <h2 class="ec-h2">三種家庭的實際電費</h2>
            <p class="ec-lead">直接看數字最有感，皆以台電 2026-04-01 住宅費率試算：</p>
            <div class="ec-tablewrap"><table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="border-b border-paper-300 text-left text-ink-400">
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">家庭型態</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">每月用電</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">非夏月</th>
                        <th class="py-2 font-medium whitespace-nowrap">夏月</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-paper-200 text-ink-600">
                    <tr><td class="py-2 pr-3">單身租屋族</td><td class="py-2 pr-3 whitespace-nowrap">200 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">395 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">418 元</td></tr>
                    <tr><td class="py-2 pr-3">小資租屋</td><td class="py-2 pr-3 whitespace-nowrap">300 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">621 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">673 元</td></tr>
                    <tr><td class="py-2 pr-3">兩房小家庭</td><td class="py-2 pr-3 whitespace-nowrap">400／650 度</td><td class="py-2 pr-3 font-semibold text-ink-700 whitespace-nowrap">908 元</td><td class="py-2 font-semibold text-ink-700 whitespace-nowrap">2,167 元</td></tr>
                </tbody>
            </table></div>
            <p class="text-xs text-ink-400 mt-2">台電多為雙月抄表，實際帳單約為上表 × 2。</p>
        </section>

        <section class="ec-section" aria-label="級距速查表">
            <h2 class="ec-h2">六段級距單價速查 <span class="ec-h2-sub">元/度</span></h2>
            <div class="ec-tablewrap"><table class="w-full text-sm border-collapse">
                <thead>
                    <tr class="border-b border-paper-300 text-left text-ink-400">
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">每月用電</th>
                        <th class="py-2 pr-3 font-medium whitespace-nowrap">夏月</th>
                        <th class="py-2 font-medium whitespace-nowrap">非夏月</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-paper-200 text-ink-600">
                    <tr><td class="py-2 pr-3 whitespace-nowrap">120 度以下</td><td class="py-2 pr-3 font-semibold text-ink-700">1.78</td><td class="py-2 font-semibold text-ink-700">1.78</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">121～330 度</td><td class="py-2 pr-3 font-semibold text-ink-700">2.55</td><td class="py-2 font-semibold text-ink-700">2.26</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">331～500 度</td><td class="py-2 pr-3 font-semibold text-ink-700">3.80</td><td class="py-2 font-semibold text-ink-700">3.13</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">501～700 度</td><td class="py-2 pr-3 font-semibold text-ink-700">5.14</td><td class="py-2 font-semibold text-ink-700">4.24</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">701～1,000 度</td><td class="py-2 pr-3 font-semibold text-ink-700">6.44</td><td class="py-2 font-semibold text-ink-700">5.27</td></tr>
                    <tr><td class="py-2 pr-3 whitespace-nowrap">1,001 度以上</td><td class="py-2 pr-3 font-semibold text-ink-700">8.86</td><td class="py-2 font-semibold text-ink-700">7.03</td></tr>
                </tbody>
            </table></div>
            <p class="text-xs text-ink-400 mt-2">台電 2026-04-01 起實施費率；雙月抄表者各級距度數加倍。</p>
        </section>
        </div>

        <section class="ec-section" aria-label="夏月 vs 非夏月">
            <h2 class="ec-h2">夏月 vs 非夏月</h2>
            <p class="ec-lead">6～9 月適用較貴的夏月費率。同樣度數，夏天就是比較貴——直接比較看看差多少：</p>
            <ElectricityCompare client:only="vue" />
        </section>

        <section class="ec-section" aria-label="比家電">
            <h2 class="ec-h2">比家電：誰是吃電怪獸？</h2>
            <p class="ec-lead">看不懂能源效率標示？選家電類型，照著黃色指引找到標示上的數字，3 台家電直接比年電費：</p>
            <ApplianceEnergyCompare client:only="vue" />
        </section>
    </div>

    <style>
        .ec-hero { background: linear-gradient(135deg, #14532d 0%, #166534 60%, #15803d 100%); border-radius: 1.25rem; padding: 2rem 1.5rem; margin-bottom: 2rem; text-align: center; color: #fff; box-shadow: 0 8px 24px rgba(20,83,45,.25); }
        .ec-hero-kicker { font-size: 0.9rem; font-weight: 700; color: #bbf7d0; margin: 0 0 0.5rem; letter-spacing: .05em; }
        .ec-hero-big { font-size: 2.75rem; font-weight: 800; margin: 0; line-height: 1.15; font-variant-numeric: tabular-nums; }
        .ec-hero-tilde { color: #bbf7d0; font-weight: 600; }
        .ec-hero-unit { font-size: 1.1rem; font-weight: 600; color: #dcfce7; }
        .ec-hero-note { font-size: 0.85rem; color: #dcfce7; line-height: 1.7; margin: 0.9rem auto 0; max-width: 34rem; }
        .ec-section { margin-bottom: 2.25rem; }
        .ec-h2 { font-size: 1.2rem; font-weight: 800; color: #25231F; margin: 0 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 2px solid rgba(20,83,45,.15); }
        .ec-h2-sub { font-size: 0.8rem; font-weight: 600; color: #78716c; }
        .ec-lead { font-size: 0.9rem; color: #57534e; line-height: 1.7; margin: 0 0 1rem; }
        .ec-tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #E8E4DA; border-radius: 0.75rem; background: #FFFDF7; }
        .ec-tablewrap table { min-width: 100%; }
        .ec-tablewrap th, .ec-tablewrap td { padding-left: 0.75rem; }
        .ec-tablewrap th:first-child, .ec-tablewrap td:first-child { padding-left: 1rem; }
        .ec-tablewrap th:last-child, .ec-tablewrap td:last-child { padding-right: 1rem; }
        @media (min-width: 1024px) {
            .ec-duo { display: grid; grid-template-columns: 1.15fr 1fr; gap: 2rem; align-items: start; }
            .ec-duo .ec-section { margin-bottom: 2.25rem; }
            .ec-hero-big { font-size: 3.5rem; }
            .ec-hero { padding: 2.75rem 2rem; text-align: left; display: grid; grid-template-columns: 1fr auto; gap: 1rem 2rem; align-items: center; }
            .ec-hero-kicker { grid-column: 1 / -1; }
            .ec-hero-note { grid-column: 1 / -1; margin-left: 0; max-width: 44rem; text-align: left; }
        }
    </style>

    <div slot="article">
        <h2>台電住宅電費怎麼算？現行累進費率懶人包</h2>
        <p>夏季電費總是讓人心驚膽跳？真正要先搞懂的，是台電住家電費不是「總度數 × 單價」，而是分段累進計價：120 度以下一度 1.78 元，超過 1,000 度夏月一度最高 8.86 元。本頁上方的級距速查表可以直接對照，輸入每月度數則會自動切換夏月 / 非夏月級距，並補上低用電時的每月最低計收規則。</p>

        <p class="text-xs text-ink-400 mt-6">資料版本：本頁住宅級距單價採台電 2026-04-01 起實施費率（115 年 3 月 27 日電價審議會決議），並納入每月最低計收 100 元規則。冷氣換算屬估算，實際仍以設備銘板與帳單為準。</p>

        <h2>相關工具與延伸閱讀</h2>
        <ul class="list-disc pl-5 space-y-2">
            <li><a href="/tools/rent-cost-calculator" class="text-ink-700 underline underline-offset-4">租屋成本計算機</a>：房租、水電、管理費一次算清，租屋族比價簽約前必用。</li>
            <li><a href="/tools/home-ownership-cost-calculator" class="text-ink-700 underline underline-offset-4">購屋成本計算機</a>：買房後的水電、管理費等長期持有成本一起估。</li>
            <li><a href="/blog/2026-october-electricity-price-freeze-guide" class="text-ink-700 underline underline-offset-4">2026年10月電價凍漲解讀：應漲沒漲，你的電費單差了多少？</a></li>
            <li><a href="/blog/2026-rental-electricity-rate-legal-guide" class="text-ink-700 underline underline-offset-4">2026租屋電費一度收多少才合法？租屋電費新制懶人包</a></li>
        </ul>
    </div>
</ToolLayout>
