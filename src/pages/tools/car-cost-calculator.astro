---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DecisionCalculator from '../../components/calculators/DecisionCalculator.vue';
const sources = [
  { label: '財政部｜使用牌照稅', href: 'https://www.etax.nat.gov.tw/etwmain/tax-info/understanding/tax-saving-manual/local/vehicle-license-tax/2Jv5NBY' },
  { label: '交通部公路局｜公路養管費（原汽燃費）', href: 'https://www.thb.gov.tw/cp.aspx?Create=1&n=224' },
  { label: '財政部｜電動車免徵牌照稅延長至 2030', href: 'https://www.mof.gov.tw/singlehtml/384fb3077bb349ea973e7fc6f13b6974?cntId=dbcf258b658c4a399c43c596709d09d4' },
  { label: 'Toyota｜2026 Corolla Cross／RAV4 規配', href: 'https://www.toyota.com.tw/showroom/COROLLA_CROSS/' },
  { label: 'Honda｜2026 CR-V 規配', href: 'https://www.honda-taiwan.com.tw/2026CR-V/' },
];
const faqs = [
  { q: '買車只看車貸月付夠嗎？', a: '不夠。真正成本還包括牌照稅、燃料使用費、保險、能源、保養、停車、貸款利息與折舊。' },
  { q: '電動車目前要繳牌照稅嗎？', a: '完全以電能為動力的車輛免徵使用牌照稅優惠已延長至 2030 年底，仍以主管機關最新公告為準。' },
  { q: 'RAV4、CR-V、Corolla Cross 的預設值可以直接當成交條件嗎？', a: '不建議。車款預設採 2026 年台灣原廠公開售價、排氣量與測試油耗，用來快速建立比較基準；實際成交價、配備、道路油耗、保險、維修和殘值仍應自行修改。' },
  { q: '油電車的牌照稅與公路養管費怎麼算？', a: '一般非外接充電油電車仍依排氣量套用汽油小客車稅費級距，本工具會自動帶入。' },
];
---
<ToolLayout title="買車總成本計算器｜RAV4、CR-V、Corolla Cross 養車成本" description="快速帶入 2026 RAV4、CR-V、Corolla Cross 原廠車價、排氣量與油耗，再整合車貸、稅費、保險、停車、保養和折舊，算出真正每月養車成本。" keywords="買車成本計算機,養車成本,RAV4養車成本,CRV養車成本,Corolla Cross養車成本,車貸試算,牌照稅,公路養管費,汽車折舊" category="交通與購車" kicker="先選熱門車款，再用自己的成交價與使用習慣算完整持有成本。" faqs={faqs} dataVersion="2026.07-car-v3" dataYear="2026 原廠規配與現行稅費" lastUpdated="2026-07-30" sources={sources}>
  <DecisionCalculator type="car" client:only="vue" slot="tool" />
  <section slot="after-tool" class="mt-5 grid gap-3 md:grid-cols-2">
    <div class="rounded-2xl border border-paper-300 bg-paper-200 p-5">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">免費更新</p>
      <h2 class="mt-2 text-base font-semibold text-ink-700">收到車款、稅費與養車指南</h2>
      <p class="mt-2 text-xs leading-6 text-ink-500">用自己的 Email 寄出訂閱要求；本站不會在背景收集你的試算內容。</p>
      <a
        href="mailto:laladoo99@gmail.com?subject=訂閱%20TaiCalc%20車款與稅費更新&body=我同意接收%20TaiCalc%20車款、稅費與養車指南。"
        data-lead-type="car_updates"
        data-lead-placement="car_result"
        class="action-link mt-4"
      >用 Email 訂閱</a>
    </div>
    <div class="rounded-2xl border border-paper-300 bg-paper-200 p-5">
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-400">合作夥伴</p>
      <h2 class="mt-2 text-base font-semibold text-ink-700">車貸、車險與試乘服務合作</h2>
      <p class="mt-2 text-xs leading-6 text-ink-500">TaiCalc 只接受資訊透明、可清楚揭露合作關係的方案。</p>
      <a
        href="/partnerships?from=car-cost"
        data-partner-id="partnership-inquiry"
        data-partner-placement="car_result"
        data-offer-type="b2b"
        class="action-link mt-4"
      >查看合作方式</a>
    </div>
  </section>
  <div slot="article">
    <h2>買車的真正成本</h2>
    <p>本工具將購車價差、持有期間貸款利息與日常支出放在同一張帳上。2026 年起汽車燃料使用費已更名為「公路使用養護安全管理費」（公路養管費），費額表沿用排氣量與汽柴油分類。折舊以你設定的期末殘值估算，保險、維修與能源價格則是可調情境。</p>
    <h3>熱門車款預設怎麼用？</h3>
    <p>選擇 RAV4、CR-V 或 Corolla Cross 後，系統會帶入 2026 年台灣原廠公開的建議售價、排氣量與測試油耗。預設的用途是建立一致的比較起點，不是代替業務報價；請再改成自己的成交價、頭期款、保險、停車與預估殘值。</p>
    <h3>結果怎麼看</h3>
    <p>「每月總成本」適合拿來和大眾運輸、租車或不同車款比較；它不是每月實際扣款，而是把折舊等成本平均攤開。成本組成圖可協助辨識真正的大項，完成後也能儲存在本機、分享相同條件、下載附 TaiCalc 網址的分享圖，或列印成 PDF。</p>
  </div>
</ToolLayout>
