---
import ToolLayout from '../../layouts/ToolLayout.astro';

const title = "訂閱管家｜別再被自動續訂扣錢：訂閱追蹤＋取消期限提醒";
const description = "Netflix、Spotify、iCloud 訂閱一多就忘記取消？訂閱管家幫你記錄每筆訂閱的扣款日與最晚取消日，取消期限 3 天前紅色警示，再也不被自動續訂偷扣錢。資料只存你的瀏覽器，免註冊免費使用。";
const keywords = "訂閱管理,自動續訂,取消訂閱,Netflix取消,Spotify取消,訂閱追蹤,扣款提醒,訂閱管家,試用期提醒";

const faqs = [
    {
        q: "「最晚取消日」是什麼？為什麼要設？",
        a: "很多訂閱不是扣款當天取消就好：有些平台要求提前 24 小時以上取消，有些則是取消後要等帳單週期結束。最晚取消日就是「想取消的話，最晚要在這天之前動手」的日子，預設是下次扣款日前一天，你也可以按各平台規則往前調。期限剩 3 天內會紅色警示。"
    },
    {
        q: "我的訂閱資料存在哪裡？會上傳嗎？",
        a: "只存在你自己瀏覽器的 localStorage，不會上傳到任何伺服器，也不用註冊。但也因此換手機或清掉瀏覽器資料會遺失；重要訂閱建議另外截圖備份。"
    },
    {
        q: "年繳的訂閱要怎麼記？",
        a: "金額填年繳總額、週期選「每年」即可。每月花費分佈會自動換算成月平均（年繳金額 ÷ 12），讓你跟月繳方案放在同一個基準比較。"
    },
    {
        q: "取消指南的步驟是最新的嗎？",
        a: "取消路徑為 2026 年整理，各平台介面可能微調，原則是：網頁版訂閱到官網帳戶頁取消、App Store 訂閱到 iPhone「設定 → Apple ID → 訂閱項目」取消、Google Play 訂閱到 Play 商店「付款與訂閱」取消。取消後務必確認收到確認信或截圖留存。"
    },
];
---

<ToolLayout
    title={title}
    description={description}
    keywords={keywords}
    category="投資與退休"
    faqs={faqs}
>
    <div slot="tool">
        <div class="st-tabs" role="tablist" aria-label="訂閱管家功能切換">
            <button type="button" data-st-tab="home" role="tab" aria-selected="true">提醒</button>
            <button type="button" data-st-tab="list" role="tab" aria-selected="false">訂閱</button>
            <button type="button" data-st-tab="form" role="tab" aria-selected="false">＋ 新增</button>
        </div>

        <div data-st-panel="home" role="tabpanel">
            <div id="st-homeBanner"></div>
            <div class="st-card st-total" id="st-totalCard">
                <div class="st-total-row">
                    <div>
                        <div class="st-total-num" id="st-monthlyTotal">NT$0</div>
                        <div class="st-label">使用中訂閱・每月平均總支出</div>
                    </div>
                    <div class="st-total-side" id="st-totalMeta"></div>
                </div>
                <div class="st-foot">年繳／季繳會自動換算成月平均（年繳 ÷ 12），USD 依 1:32 換算。</div>
            </div>
            <div class="st-card">
                <h3>⏳ 取消期限倒數</h3>
                <div id="st-cancelList"><div class="st-muted">載入中…</div></div>
                <div class="st-foot">想取消的訂閱要在「最晚取消日」前動手，否則會被續扣。期限剩 3 天內會紅色標示。</div>
            </div>
            <div class="st-card">
                <h3>⏰ 7 天內扣款</h3>
                <div id="st-dueList"><div class="st-muted">載入中…</div></div>
            </div>
        </div>

        <div data-st-panel="list" role="tabpanel" hidden>
            <div id="st-subList"></div>
            <details class="st-hist" id="st-histWrap" style="display:none">
                <summary id="st-histSummary">已取消的訂閱</summary>
                <div id="st-histList"></div>
            </details>
        </div>

        <div data-st-panel="form" role="tabpanel" hidden>
            <div class="st-card">
                <h3 id="st-formTitle">新增訂閱</h3>
                <div class="st-muted" style="margin-bottom:4px">快速帶入：</div>
                <div class="st-chips" id="st-presetChips"></div>
                <form class="st-f" id="st-subForm" onsubmit="return false">
                    <input type="hidden" id="st-f_id">
                    <label>名稱 *</label>
                    <input id="st-f_name" placeholder="例：Netflix" maxlength="100">
                    <div class="st-grid2">
                        <div><label>金額 *</label><input id="st-f_amount" type="number" min="0" step="0.01" placeholder="390"></div>
                        <div><label>幣別</label>
                            <select id="st-f_currency"><option value="TWD">TWD</option><option value="USD">USD</option></select>
                        </div>
                    </div>
                    <div class="st-grid2">
                        <div><label>週期</label>
                            <select id="st-f_cycle">
                                <option value="monthly">每月</option>
                                <option value="weekly">每週</option>
                                <option value="quarterly">每季</option>
                                <option value="halfyear">每半年</option>
                                <option value="yearly">每年</option>
                                <option value="custom">自訂天數</option>
                            </select>
                        </div>
                        <div id="st-cycleDaysWrap" style="display:none"><label>每幾天</label><input id="st-f_cycle_days" type="number" min="1" value="30"></div>
                    </div>
                    <label>首次扣款日 *</label>
                    <input id="st-f_first_billing" type="date">
                    <label>最晚取消日 <span class="st-hint">想取消要在這天之前動手，否則被續扣（預設為下次扣款日前一天）</span></label>
                    <input id="st-f_cancel_by" type="date">
                    <div class="st-grid2">
                        <div><label>狀態</label>
                            <select id="st-f_status">
                                <option value="active">使用中</option>
                                <option value="trial">試用中</option>
                                <option value="paused">已暫停</option>
                            </select>
                        </div>
                        <div id="st-trialEndWrap" style="display:none"><label>試用到期日</label><input id="st-f_trial_end" type="date"></div>
                    </div>
                    <div class="st-grid2">
                        <div><label>分類</label>
                            <select id="st-f_category">
                                <option value="">未分類</option>
                                <option>影音</option><option>音樂</option><option>雲端</option>
                                <option>遊戲</option><option>健身</option><option>購物會員</option>
                                <option>工具</option><option>其他</option>
                            </select>
                        </div>
                        <div><label>付款方式</label><input id="st-f_pay_method" placeholder="例：信用卡末四碼" maxlength="50"></div>
                    </div>
                    <label>備註</label>
                    <textarea id="st-f_note" maxlength="500" rows="2"></textarea>
                    <div style="margin-top:14px"><button type="button" class="st-primary st-block" id="st-formSave">儲存</button></div>
                </form>
            </div>
        </div>

        <script is:inline>
        (function () {
            'use strict';
            /* ---------- 日期邏輯（純函數，移植自 sub-tracker/logic.js） ---------- */
            function pad(n) { return (n < 10 ? '0' : '') + n; }
            function fmtDate(y, m, d) { return y + '-' + pad(m) + '-' + pad(d); }
            function todayStr(d) { d = d || new Date(); return fmtDate(d.getFullYear(), d.getMonth() + 1, d.getDate()); }
            function parseParts(s) { var p = String(s).split('-'); return { y: +p[0], m: +p[1], d: +p[2] }; }
            function lastDayOf(y, m) { return new Date(y, m, 0).getDate(); }
            function addMonthsAnchored(firstBilling, months) {
                var p = parseParts(firstBilling);
                var total = (p.m - 1) + months;
                var ny = p.y + Math.floor(total / 12);
                var nm = (total % 12) + 1;
                var nd = Math.min(p.d, lastDayOf(ny, nm));
                return fmtDate(ny, nm, nd);
            }
            function addDaysStr(dateStr, days) {
                var p = parseParts(dateStr);
                var d = new Date(p.y, p.m - 1, p.d);
                d.setDate(d.getDate() + days);
                return fmtDate(d.getFullYear(), d.getMonth() + 1, d.getDate());
            }
            function cycleMonths(cycle) {
                switch (cycle) {
                    case 'monthly': return 1;
                    case 'quarterly': return 3;
                    case 'halfyear': return 6;
                    case 'yearly': return 12;
                    default: return 0;
                }
            }
            function billingAt(sub, n) {
                var first = sub.first_billing;
                if (sub.cycle === 'weekly') return addDaysStr(first, n * 7);
                if (sub.cycle === 'custom') {
                    var days = parseInt(sub.cycle_days, 10);
                    if (!days || days <= 0) days = 30;
                    return addDaysStr(first, n * days);
                }
                return addMonthsAnchored(first, n * cycleMonths(sub.cycle));
            }
            function nextBilling(sub, today) {
                today = today || todayStr();
                var n = 0, date = billingAt(sub, 0), guard = 0;
                while (date <= today && guard < 5000) { n++; date = billingAt(sub, n); guard++; }
                return date;
            }
            function billingOnOrAfter(sub, date) {
                var n = 0, d = billingAt(sub, 0), guard = 0;
                while (d < date && guard < 5000) { n++; d = billingAt(sub, n); guard++; }
                return d;
            }
            function daysUntil(dateStr, today) {
                today = today || todayStr();
                var a = parseParts(dateStr), b = parseParts(today);
                var ms = Date.UTC(a.y, a.m - 1, a.d) - Date.UTC(b.y, b.m - 1, b.d);
                return Math.round(ms / 86400000);
            }
            function billingCount(sub, today) {
                today = today || todayStr();
                var n = 0, count = 0, guard = 0;
                while (guard < 5000) {
                    if (billingAt(sub, n) > today) break;
                    count++; n++; guard++;
                }
                return count;
            }
            function totalPaid(sub, today) { return billingCount(sub, today) * Number(sub.amount || 0); }
            function monthlyAvg(sub) {
                var amt = Number(sub.amount || 0);
                switch (sub.cycle) {
                    case 'weekly': return amt * 52 / 12;
                    case 'monthly': return amt;
                    case 'quarterly': return amt / 3;
                    case 'halfyear': return amt / 6;
                    case 'yearly': return amt / 12;
                    case 'custom': {
                        var days = parseInt(sub.cycle_days, 10);
                        if (!days || days <= 0) days = 30;
                        return amt * 30 / days;
                    }
                    default: return amt;
                }
            }
            function toTWD(amount, currency) {
                return String(currency || 'TWD').toUpperCase() === 'USD' ? Number(amount) * 32 : Number(amount);
            }
            function isLive(sub) { return sub.status === 'active' || sub.status === 'trial'; }
            function getDue(subs, today) {
                today = today || todayStr();
                var horizon = addDaysStr(today, 7);
                var dueSoon = [], trialEnding = [];
                (subs || []).forEach(function (sub) {
                    if (!sub || sub.status === 'cancelled') return;
                    if (sub.status === 'trial' && sub.trial_end) {
                        var dt = daysUntil(sub.trial_end, today);
                        if (dt >= 0 && dt <= 3) trialEnding.push({ sub: sub, daysLeft: dt });
                    }
                    if (sub.status === 'paused') return;
                    var nb = billingOnOrAfter(sub, today);
                    if (nb <= horizon) dueSoon.push({ sub: sub, date: nb, daysLeft: daysUntil(nb, today) });
                });
                dueSoon.sort(function (a, b) { return a.date < b.date ? -1 : 1; });
                trialEnding.sort(function (a, b) { return a.daysLeft - b.daysLeft; });
                return { dueSoon: dueSoon, trialEnding: trialEnding };
            }
            /* 最晚取消日：有填用填的，沒填預設為下次扣款日前一天 */
            function getCancelBy(sub, today) {
                if (sub.cancel_by) return sub.cancel_by;
                return addDaysStr(nextBilling(sub, today || todayStr()), -1);
            }

            /* ---------- 資料（localStorage，不上傳） ---------- */
            var LS_KEY = 'taicalc-subscriptions-v1';
            function loadSubs() {
                try {
                    var raw = localStorage.getItem(LS_KEY);
                    var arr = raw ? JSON.parse(raw) : [];
                    return Array.isArray(arr) ? arr : [];
                } catch (e) { return []; }
            }
            function saveSubs() {
                try { localStorage.setItem(LS_KEY, JSON.stringify(state.subs)); } catch (e) {}
            }
            function newId() { return Date.now() * 1000 + Math.floor(Math.random() * 1000); }

            var state = { subs: loadSubs(), calY: 0, calM: 0, editingId: null, cancelByTouched: false };

            var PRESETS = [
                { name: 'Netflix', amount: 390, currency: 'TWD', cycle: 'monthly', category: '影音' },
                { name: 'Spotify', amount: 149, currency: 'TWD', cycle: 'monthly', category: '音樂' },
                { name: 'YouTube Premium', amount: 199, currency: 'TWD', cycle: 'monthly', category: '影音' },
                { name: 'iCloud+', amount: 90, currency: 'TWD', cycle: 'monthly', category: '雲端' },
                { name: 'Google One 100GB', amount: 65, currency: 'TWD', cycle: 'monthly', category: '雲端' },
                { name: 'Disney+', amount: 270, currency: 'TWD', cycle: 'monthly', category: '影音' },
                { name: 'KKBOX', amount: 149, currency: 'TWD', cycle: 'monthly', category: '音樂' }
            ];

            var GUIDE = [
                { name: 'Netflix', steps: ['開啟 Netflix 網頁版並登入', '右上角頭像 →「帳戶」', '「會員資格與帳單」→「取消會員資格」', '按指示確認，帳單週期結束前仍可觀看'] },
                { name: 'Spotify', steps: ['到 spotify.com/account 登入', '「變更方案」→ 捲到最下「取消 Premium」', '按指示確認即可'] },
                { name: 'YouTube Premium', steps: ['YouTube App → 右下「你」→ 右上齒輪', '「購買內容與會員資格」→ 點 Premium 方案', '「停用」→ 選擇原因確認'] },
                { name: 'iCloud+', steps: ['iPhone「設定」→ 點最上方 Apple ID', '「訂閱項目」→ 選擇 iCloud+', '「取消訂閱」確認（經 App Store 訂閱者皆在此取消）'] },
                { name: 'Google One', steps: ['Google One App → 左上選單 →「設定」', '「取消會員資格」→ 按指示確認', '注意：經由 Google Play 訂閱者改在 Play 商店「付款與訂閱」取消'] },
                { name: 'Disney+', steps: ['到 disneyplus.com 登入 →「帳戶」', '訂閱方案下點「取消訂閱」', '經 Apple / Google 訂閱者：請到該平台的訂閱管理取消'] },
                { name: 'KKBOX', steps: ['KKBOX App →「設定」→「方案管理」', '「取消自動續訂」→ 確認', '經電信帳單代收者：需到電信商 App 取消小額付費項目'] }
            ];

            function esc(s) {
                return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }
            function $(id) { return document.getElementById(id); }
            function moneyOf(sub) {
                var a = Number(sub.amount || 0);
                return sub.currency === 'USD' ? 'US$' + a : 'NT$' + Math.round(a).toLocaleString('en-US');
            }
            function twd(n) { return 'NT$' + Math.round(n).toLocaleString('en-US'); }
            function cycleLabel(c) {
                return { weekly: '每週', monthly: '每月', quarterly: '每季', halfyear: '每半年', yearly: '每年', custom: '自訂' }[c] || '每月';
            }
            function statusLabel(s) {
                return { trial: '試用中', active: '使用中', paused: '已暫停', cancelled: '已取消' }[s] || s;
            }
            function shortDate(ds) { var p = parseParts(ds); return p.m + '/' + p.d; }

            /* ---------- 分頁切換 ---------- */
            var tabBtns = Array.prototype.slice.call(document.querySelectorAll('[data-st-tab]'));
            var tabPanels = Array.prototype.slice.call(document.querySelectorAll('[data-st-panel]'));
            function switchView(name) {
                tabBtns.forEach(function (b) { b.setAttribute('aria-selected', b.getAttribute('data-st-tab') === name ? 'true' : 'false'); });
                tabPanels.forEach(function (p) { p.hidden = p.getAttribute('data-st-panel') !== name; });
                if (name === 'form' && !state.editingId) resetForm();
                try { window.scrollTo(0, 0); } catch (e) {}
            }
            tabBtns.forEach(function (b) {
                b.addEventListener('click', function () { switchView(b.getAttribute('data-st-tab')); });
            });

            /* ---------- 首頁 ---------- */
            function monthRange(y, m) {
                return { start: y + '-' + pad(m) + '-01', end: y + '-' + pad(m) + '-' + new Date(y, m, 0).getDate() };
            }
            function sumBillingInRange(subs, start, end) {
                var total = 0;
                subs.forEach(function (s) {
                    if (!isLive(s)) return;
                    var n = 0, guard = 0;
                    while (guard < 2000) {
                        var d = billingAt(s, n);
                        if (d > end) break;
                        if (d >= start) total += toTWD(s.amount, s.currency);
                        n++; guard++;
                    }
                });
                return total;
            }
            function renderHome() {
                var today = todayStr();

                var live = state.subs.filter(isLive);

                /* 每月平均總支出（不同週期換算成月平均；USD 換算 TWD） */
                function monthlyAvgTWD(s) {
                    var amt = toTWD(s.amount, s.currency);
                    switch (s.cycle) {
                        case 'weekly': return amt * 52 / 12;
                        case 'monthly': return amt;
                        case 'quarterly': return amt / 3;
                        case 'halfyear': return amt / 6;
                        case 'yearly': return amt / 12;
                        case 'custom': {
                            var days = parseInt(s.cycle_days, 10);
                            if (!days || days <= 0) days = 30;
                            return amt * 30 / days;
                        }
                        default: return amt;
                    }
                }
                var totalMonthly = live.reduce(function (sum, s) { return sum + monthlyAvgTWD(s); }, 0);
                $('st-monthlyTotal').textContent = twd(totalMonthly);
                $('st-totalMeta').innerHTML = live.length
                    ? '使用中 ' + live.length + ' 筆<br>年支出約 ' + twd(totalMonthly * 12)
                    : '<span class="st-muted">還沒有使用中的訂閱</span>';

                var due = getDue(state.subs, today);

                /* 取消期限清單：依最晚取消日排序 */
                var cancelItems = live.map(function (s) {
                    var cb = getCancelBy(s, today);
                    return { sub: s, cancelBy: cb, daysLeft: daysUntil(cb, today) };
                }).filter(function (x) { return x.daysLeft >= 0; })
                  .sort(function (a, b) { return a.cancelBy < b.cancelBy ? -1 : 1; });

                var cl = $('st-cancelList');
                if (!cancelItems.length) {
                    cl.innerHTML = '<div class="st-muted">沒有使用中的訂閱</div>';
                } else {
                    cl.innerHTML = cancelItems.map(function (x) {
                        var s = x.sub;
                        var urgent = x.daysLeft <= 3;
                        var badge = x.daysLeft === 0
                            ? '<span class="st-badge st-due">今天到期</span>'
                            : '<span class="st-badge' + (urgent ? ' st-due' : '') + '">剩 ' + x.daysLeft + ' 天</span>';
                        return '<div class="st-row">' +
                            '<div><strong>' + esc(s.name) + '</strong><div class="st-muted">最晚 ' + x.cancelBy + ' 前取消</div></div>' +
                            '<div style="text-align:right">' + badge + '<div class="st-muted">' + moneyOf(s) + '・' + cycleLabel(s.cycle) + '</div></div></div>';
                    }).join('');
                }

                /* 橫幅：取消期限 ≤3 天優先，其次試用，最後扣款 */
                var banner = '';
                var urgentCancel = cancelItems.filter(function (x) { return x.daysLeft <= 3; });
                var parts = [];
                urgentCancel.forEach(function (x) {
                    parts.push(esc(x.sub.name) + ' 最晚 ' + (x.daysLeft === 0 ? '今天' : x.daysLeft + ' 天內') + '要取消');
                });
                due.trialEnding.forEach(function (x) {
                    parts.push(esc(x.sub.name) + ' 試用剩 ' + x.daysLeft + ' 天');
                });
                if (parts.length) {
                    banner = '<div class="st-banner st-danger">⚠️ ' + parts.join('；') + '，否則會被續扣！</div>';
                } else {
                    var urgentDue = due.dueSoon.filter(function (x) { return x.daysLeft <= 3; });
                    if (urgentDue.length) {
                        banner = '<div class="st-banner">⏰ ' + urgentDue.map(function (x) {
                            return esc(x.sub.name) + (x.daysLeft === 0 ? '今天' : x.daysLeft + ' 天後') + '扣款';
                        }).join('；') + '</div>';
                    } else if (state.subs.length) {
                        banner = '<div class="st-banner st-ok">✓ 近期沒有即將到期或扣款的訂閱</div>';
                    }
                }
                $('st-homeBanner').innerHTML = banner;

                /* 7 天內扣款 */
                var dl = $('st-dueList');
                if (!due.dueSoon.length) {
                    dl.innerHTML = '<div class="st-muted">7 天內沒有扣款</div>';
                } else {
                    dl.innerHTML = due.dueSoon.map(function (x) {
                        var s = x.sub;
                        var when = x.daysLeft === 0 ? '<span class="st-badge st-due">今天</span>' :
                            '<span class="st-badge' + (x.daysLeft <= 3 ? ' st-due' : '') + '">' + x.daysLeft + ' 天後</span>';
                        return '<div class="st-row">' +
                            '<div><strong>' + esc(s.name) + '</strong><div class="st-muted">' + x.date + (s.pay_method ? '・' + esc(s.pay_method) : '') + '</div></div>' +
                            '<div style="text-align:right">' + when + '<div class="st-muted">' + moneyOf(s) + '</div></div></div>';
                    }).join('');
                }

            }

            /* ---------- 清單 ---------- */
            function renderList() {
                var today = todayStr();
                var live = [], hist = [];
                state.subs.forEach(function (s) { (s.status === 'cancelled' ? hist : live).push(s); });
                live.sort(function (a, b) {
                    var da = getCancelBy(a, today), db = getCancelBy(b, today);
                    return da < db ? -1 : da > db ? 1 : 0;
                });

                function guideFor(name) {
                var n = String(name || '').toLowerCase().replace(/\s+/g, '');
                for (var i = 0; i < GUIDE.length; i++) {
                    var g = GUIDE[i].name.toLowerCase().replace(/\s+/g, '');
                    if (n.indexOf(g) !== -1 || g.indexOf(n) !== -1) return GUIDE[i];
                }
                return null;
            }

            function card(s) {
                    var cancelled = s.status === 'cancelled';
                    var cb = cancelled ? '' : getCancelBy(s, today);
                    var cbd = cancelled ? 999 : daysUntil(cb, today);
                    var urgent = !cancelled && cbd <= 3;
                    var nb = cancelled ? '' : nextBilling(s, today);
                    var d = cancelled ? 0 : daysUntil(nb, today);
                    var paid = totalPaid(s, today);
                    var cancelLine = cancelled ? '' :
                        '<div class="st-cancel' + (urgent ? ' st-urgent' : '') + '">⚠️ 最晚取消：' + cb + '（' + (cbd === 0 ? '今天到期' : '剩 ' + cbd + ' 天') + '）</div>';
                    var gd = cancelled ? null : guideFor(s.name);
                    var guideLine = !gd ? '' :
                        '<details class="st-guide"><summary>怎麼取消？</summary><ol>' +
                        gd.steps.map(function (st) { return '<li>' + esc(st) + '</li>'; }).join('') + '</ol></details>';
                    var countTxt;
                    if (cancelled) countTxt = '已取消';
                    else if (s.status === 'paused') countTxt = '暫停中';
                    else if (s.status === 'trial' && s.trial_end) countTxt = '試用剩 ' + daysUntil(s.trial_end, today) + ' 天';
                    else countTxt = d === 0 ? '今天扣款' : d + ' 天後扣款';
                    return '<div class="st-card st-subcard' + (cancelled ? ' st-cancelled' : '') + '">' +
                        '<div class="st-row"><div class="st-name">' + esc(s.name) + '</div>' +
                        '<span class="st-badge st-' + s.status + '">' + statusLabel(s.status) + '</span></div>' +
                        '<div class="st-meta">' + moneyOf(s) + '・' + cycleLabel(s.cycle) +
                        (s.cycle === 'custom' ? '(' + esc(String(s.cycle_days)) + '天)' : '') +
                        (s.category ? '・' + esc(s.category) : '') +
                        (s.pay_method ? '・' + esc(s.pay_method) : '') + '</div>' +
                        cancelLine +
                        guideLine +
                        '<div class="st-row" style="margin-top:6px"><div class="st-count' + (urgent ? ' st-soon' : '') + '">' + esc(countTxt) + '</div>' +
                        '<div class="st-muted">累計 ' + twd(toTWD(paid, s.currency)) + '</div></div>' +
                        '<div class="st-btnrow">' +
                        '<button type="button" class="st-small" data-act="edit" data-id="' + s.id + '">編輯</button>' +
                        (cancelled
                            ? '<button type="button" class="st-small" data-act="restore" data-id="' + s.id + '">恢復</button>'
                            : '<button type="button" class="st-small" data-act="cancel" data-id="' + s.id + '">取消訂閱</button>') +
                        '<button type="button" class="st-small st-danger-btn" data-act="del" data-id="' + s.id + '">刪除</button>' +
                        '</div></div>';
                }

                $('st-subList').innerHTML = live.length
                    ? live.map(card).join('')
                    : '<div class="st-empty">還沒有訂閱<br>按「＋ 新增」開始記錄</div>';

                var hw = $('st-histWrap');
                if (hist.length) {
                    hw.style.display = 'block';
                    $('st-histSummary').textContent = '已取消的訂閱（' + hist.length + '）';
                    $('st-histList').innerHTML = hist.map(card).join('');
                } else {
                    hw.style.display = 'none';
                }

                Array.prototype.forEach.call(document.querySelectorAll('#st-subList [data-act], #st-histList [data-act]'), function (b) {
                    b.addEventListener('click', function () { onCardAct(b.getAttribute('data-act'), +b.getAttribute('data-id')); });
                });
            }

            function onCardAct(act, id) {
                var s = null;
                state.subs.forEach(function (x) { if (x.id === id) s = x; });
                if (act === 'edit') { openEdit(id); return; }
                if (!s) return;
                if (act === 'cancel') {
                    if (!confirm('確定取消這筆訂閱？\n紀錄會保留，方便查看累計花費。記得去平台完成取消流程喔！')) return;
                    s.status = 'cancelled';
                } else if (act === 'restore') {
                    s.status = 'active';
                } else if (act === 'del') {
                    if (!confirm('確定永久刪除？累計花費紀錄也會消失，建議用「取消訂閱」保留。')) return;
                    state.subs = state.subs.filter(function (x) { return x.id !== id; });
                }
                saveSubs();
                renderAll();
            }

            /* ---------- 表單 ---------- */
            function resetForm() {
                state.editingId = null;
                state.cancelByTouched = false;
                $('st-formTitle').textContent = '新增訂閱';
                ['st-f_id', 'st-f_name', 'st-f_amount', 'st-f_pay_method', 'st-f_note'].forEach(function (id) { $(id).value = ''; });
                $('st-f_currency').value = 'TWD';
                $('st-f_cycle').value = 'monthly';
                $('st-f_cycle_days').value = 30;
                $('st-f_first_billing').value = todayStr();
                $('st-f_cancel_by').value = '';
                $('st-f_status').value = 'active';
                $('st-f_trial_end').value = '';
                $('st-f_category').value = '';
                toggleFormParts();
            }
            function toggleFormParts() {
                $('st-cycleDaysWrap').style.display = $('st-f_cycle').value === 'custom' ? 'block' : 'none';
                $('st-trialEndWrap').style.display = $('st-f_status').value === 'trial' ? 'block' : 'none';
            }
            $('st-f_cycle').addEventListener('change', toggleFormParts);
            $('st-f_status').addEventListener('change', toggleFormParts);

            /* 首次扣款日變更時，若使用者沒手動改過最晚取消日，自動帶入「下次扣款日前一天」 */
            $('st-f_first_billing').addEventListener('change', autoCancelBy);
            $('st-f_cycle').addEventListener('change', autoCancelBy);
            $('st-f_cycle_days').addEventListener('change', autoCancelBy);
            $('st-f_cancel_by').addEventListener('change', function () { state.cancelByTouched = true; });
            function autoCancelBy() {
                if (state.cancelByTouched) return;
                var fb = $('st-f_first_billing').value;
                if (!/^\d{4}-\d{2}-\d{2}$/.test(fb)) return;
                var tmp = { first_billing: fb, cycle: $('st-f_cycle').value, cycle_days: parseInt($('st-f_cycle_days').value, 10) || 30 };
                $('st-f_cancel_by').value = addDaysStr(nextBilling(tmp), -1);
            }

            $('st-presetChips').innerHTML = PRESETS.map(function (p, i) {
                return '<button type="button" data-preset="' + i + '">' + esc(p.name) + ' ' + p.amount + '</button>';
            }).join('');
            Array.prototype.forEach.call(document.querySelectorAll('#st-presetChips [data-preset]'), function (b) {
                b.addEventListener('click', function () {
                    var p = PRESETS[+b.getAttribute('data-preset')];
                    $('st-f_name').value = p.name;
                    $('st-f_amount').value = p.amount;
                    $('st-f_currency').value = p.currency;
                    $('st-f_cycle').value = p.cycle;
                    $('st-f_category').value = p.category;
                    if (!$('st-f_first_billing').value) $('st-f_first_billing').value = todayStr();
                    state.cancelByTouched = false;
                    toggleFormParts();
                    autoCancelBy();
                });
            });

            function openEdit(id) {
                var s = null;
                state.subs.forEach(function (x) { if (x.id === id) s = x; });
                if (!s) return;
                state.editingId = id;
                state.cancelByTouched = !!s.cancel_by;
                $('st-formTitle').textContent = '編輯訂閱';
                $('st-f_id').value = s.id;
                $('st-f_name').value = s.name || '';
                $('st-f_amount').value = s.amount || 0;
                $('st-f_currency').value = s.currency || 'TWD';
                $('st-f_cycle').value = s.cycle || 'monthly';
                $('st-f_cycle_days').value = s.cycle_days || 30;
                $('st-f_first_billing').value = s.first_billing || todayStr();
                $('st-f_cancel_by').value = s.cancel_by || '';
                $('st-f_status').value = ['trial', 'active', 'paused'].indexOf(s.status) >= 0 ? s.status : 'active';
                $('st-f_trial_end').value = s.trial_end || '';
                $('st-f_category').value = s.category || '';
                $('st-f_pay_method').value = s.pay_method || '';
                $('st-f_note').value = s.note || '';
                toggleFormParts();
                switchView('form');
            }

            $('st-formSave').addEventListener('click', function () {
                var body = {
                    name: $('st-f_name').value.trim(),
                    amount: parseFloat($('st-f_amount').value) || 0,
                    currency: $('st-f_currency').value,
                    cycle: $('st-f_cycle').value,
                    cycle_days: parseInt($('st-f_cycle_days').value, 10) || 30,
                    first_billing: $('st-f_first_billing').value,
                    cancel_by: $('st-f_cancel_by').value || null,
                    status: $('st-f_status').value,
                    trial_end: $('st-f_trial_end').value || null,
                    category: $('st-f_category').value,
                    pay_method: $('st-f_pay_method').value.trim(),
                    note: $('st-f_note').value.trim()
                };
                if (!body.name) { alert('請填寫名稱'); return; }
                if (!/^\d{4}-\d{2}-\d{2}$/.test(body.first_billing)) { alert('請選擇首次扣款日'); return; }
                if (!body.cancel_by) {
                    body.cancel_by = addDaysStr(nextBilling({ first_billing: body.first_billing, cycle: body.cycle, cycle_days: body.cycle_days }), -1);
                }
                if (state.editingId) {
                    state.subs.forEach(function (x) {
                        if (x.id === state.editingId) {
                            for (var k in body) x[k] = body[k];
                        }
                    });
                } else {
                    body.id = newId();
                    state.subs.push(body);
                }
                saveSubs();
                resetForm();
                renderAll();
                switchView('list');
            });



            /* ---------- 總渲染 ---------- */
            function renderAll() {
                renderHome();
                renderList();
            }

            renderAll();
        })();
        </script>

