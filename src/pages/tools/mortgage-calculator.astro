        <script is:inline>
            (function () {
                var section = document.querySelector('[data-affiliate-section="mortgage_result_next"]');
                if (!section) return;
                function track(name, params) {
                    try {
                        if (typeof window.taicalcTrackEvent === 'function') window.taicalcTrackEvent(name, params);
                    } catch (e) {}
                }
                if ('IntersectionObserver' in window) {
                    var seen = false;
                    var observer = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting && !seen) {
                                seen = true;
                                track('affiliate_section_view', { section: 'mortgage_result_next', tool_id: 'mortgage-calculator' });
                                observer.disconnect();
                            }
                        });
                    }, { threshold: 0.3 });
                    observer.observe(section);
                }
                section.querySelectorAll('[data-affiliate-slot]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        track('partner_click', {
                            partner_id: btn.getAttribute('data-partner-id'),
                            partner_placement: btn.getAttribute('data-partner-placement') || 'mortgage_result_next',
                            offer_type: btn.getAttribute('data-offer-type') || 'mortgage',
                            partner_status: 'pending'
                        });
                        var badge = btn.querySelector('[data-affiliate-badge]');
                        if (badge && !badge.dataset.clicked) {
