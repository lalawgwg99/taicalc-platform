---
import Layout from '../layouts/Layout.astro';

const title = "退休規劃工具箱｜TaiCalc";
const description = "退休金一次算清：勞保老年年金、勞退、FIRE 目標與通膨後實質報酬，用數字規劃退休。";

const steps = [
    {
        title: "算勞保老年年金",
        desc: "一次領 vs 月領、提前延後請領，確認退休現金流。",
        href: "/tools/labor-insurance-pension-calculator",
        cta: "勞保年金試算",
    },
    {
        title: "算勞退與自提",
        desc: "雇主 6% 提撥與自願提繳的累積效益，確認節稅空間。",
        href: "/tools/labor-pension-calculator",
        cta: "勞退試算",
    },
    {
        title: "算 FIRE 目標",
        desc: "用 4% 法則算出退休目標金額與所需年限。",
        href: "/tools/fire-calculator",
        cta: "FIRE 試算",
    },
];

const compareLinks = [
    { title: "一次領 vs 月領", href: "/compare/labor-pension-lump-vs-monthly" },
    { title: "勞退自提 0% vs 6%", href: "/compare/pension-contribution-0-vs-6" },
    { title: "定存 vs 債券 vs ETF", href: "/compare/asset-real-return" },
];
---

<Layout title={title} description={description} fullWidth>
    <section class="pt-16 pb-20 md:pt-24 md:pb-28 hero-sheen relative overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 md:px-6 text-center relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-brand-50 border border-brand-100 rounded-full mb-6">
                <span class="text-xs font-medium text-brand-600">退休金一次算清</span>
            </div>
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif font-normal text-ink-700 tracking-tight leading-[1.2] mb-5">
                退休不是猜<br class="md:hidden">是算出來的
            </h1>
            <p class="text-base md:text-lg text-ink-400 leading-relaxed max-w-2xl mx-auto mb-8">
                勞保、勞退、FIRE 目標與通膨——把退休金拆成可計算的數字，才知道還差多少。
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="/tools/labor-insurance-pension-calculator" class="btn-primary rounded-xl px-5 py-3 text-sm">先算勞保年金</a>
                <a href="/tools/fire-calculator" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white border border-paper-300 text-ink-100 text-sm font-medium hover:border-brand hover:text-brand transition-colors">先算 FIRE 目標</a>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24 bg-white section-wash">
        <div class="max-w-6xl mx-auto px-4 md:px-6">
            <div class="max-w-xl mb-10 md:mb-14">
                <span class="text-[11px] font-semibold text-brand uppercase tracking-widest">三步驟</span>
                <h2 class="text-xl md:text-2xl font-medium text-ink-700 mt-2">用 3 個計算完成退休規劃</h2>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
                {steps.map((step) => (
                    <a href={step.href} class="group rounded-2xl border border-paper-300 bg-paper-100 p-5 transition-all hover:border-brand-300 hover:bg-paper-50">
                        <p class="text-sm font-semibold text-ink-700 group-hover:text-brand transition-colors">{step.title}</p>
                        <p class="mt-2 text-sm text-ink-500 leading-relaxed">{step.desc}</p>
                        <p class="mt-4 text-sm font-semibold text-brand">{step.cta} →</p>
                    </a>
                ))}
            </div>

            <div class="mt-12 rounded-2xl border border-paper-300 bg-paper-100 p-6">
                <h2 class="text-base font-semibold text-ink-700">退休比較頁</h2>
                <div class="mt-3 grid gap-2 md:grid-cols-3">
                    {compareLinks.map((link) => (
                        <a href={link.href} class="rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm font-semibold text-brand-700 hover:border-brand-400 hover:bg-brand-100 transition-colors">
                            {link.title} →
                        </a>
                    ))}
                </div>
            </div>

            <div class="mt-12 rounded-2xl border border-paper-300 bg-paper-100 p-6">
                <h2 class="text-base font-semibold text-ink-700">延伸閱讀</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    <a href="/blog/labor-pension-lump-sum-vs-monthly" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">勞退一次領 vs 月領</a>
                    <a href="/blog/taiwan-labor-pension-early-retirement-age-61-crisis" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">勞保 61 歲退休危機</a>
                    <a href="/blog/6-jars-money-management-system" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">六罐子理財法</a>
                    <a href="/glossary/fire" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">FIRE</a>
                    <a href="/glossary/four-percent-rule" class="rounded-full border border-paper-300 bg-white px-4 py-1.5 text-sm text-ink-600 hover:border-brand-300 hover:text-brand transition-colors">4% 法則</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
