---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { platformGovernance } from '../data/regulatoryMetadata';
import { getToolByHref, toolCatalog } from '../data/toolCatalog';

const title = "TaiCalc｜台灣生活計算工具";
const description = "薪資、房貸、買車、稅務與生活成本試算工具；資料年度與來源清楚標示。";
const keywords = "人生模擬器,台灣人生模擬器,人生遊戲,台灣計算機,買車成本,離職資遣費,債務整合,勞保老年年金,育兒津貼,買房成本";

const supportCategories = Array.from(new Set(toolCatalog.map((tool) => tool.category))).map((category) => ({
    category,
    tools: toolCatalog.filter((tool) => tool.category === category),
}));
const categoryNames = supportCategories.map((group) => group.category);

const featuredDecisions = [
    '/tools/delivery-income-calculator',
    '/tools/split-calculator',
    '/tools/electricity-calculator',
    '/tools/salary-calculator',
    '/tools/life-simulator',
    '/tools/labor-insurance-pension-calculator',
    '/tools/labor-pension-calculator',
    '/tools/mortgage-calculator',
    '/tools/income-tax-calculator',
    '/tools/fire-calculator',
    '/tools/etf-dividend-calculator',
    '/tools/car-cost-calculator',
].map((path) => getToolByHref(path)!);
const toolCatalogJson = JSON.stringify(toolCatalog);
const allPosts = await getCollection('blog');
const latestPosts = allPosts
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 3);
const homeFaqs = [
    {
        q: 'TaiCalc 的計算結果會儲存我的薪資或財務資料嗎？',
        a: '不會。主要計算都在你的瀏覽器本地完成，不需要註冊帳號，也不會把輸入的薪資、房貸或稅務數字上傳。',
    },
    {
        q: '計算器使用哪一年度的台灣法規資料？',
        a: `目前標示為 ${platformGovernance.dataYear}、版本 ${platformGovernance.version}，各工具頁也會列出更新日期與官方來源。`,
    },
    {
        q: '試算結果可以當作報稅或貸款的正式金額嗎？',
        a: '試算適合用來比較方案與預估現金流；正式金額仍應以主管機關、銀行、雇主或專業人士提供的資料為準。',
    },
];
const homeFaqSchema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
});
const toolListSchema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'TaiCalc 台灣生活計算工具',
    itemListElement: toolCatalog.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.label,
        url: `https://taicalc.com${tool.href}`,
    })),
});
---

<Layout title={title} description={description} keywords={keywords} fullWidth>
    <script type="application/ld+json" set:html={homeFaqSchema} slot="head" />
    <script type="application/ld+json" set:html={toolListSchema} slot="head" />
    <section class="v2-hero relative overflow-hidden">
        <div class="max-w-6xl mx-auto px-4 md:px-6 relative py-12 sm:py-16 md:py-24">
            <p class="v2-hero-kicker">台灣生活計算工具</p>
            <h1 class="v2-hero-h1">
                人生很難選，<br />數字可以先算。
            </h1>
            <p class="v2-hero-sub">
                把薪資、房貸、買車與稅務算清楚，再做決定。
            </p>

            <div id="tool-discovery" data-tool-catalog={toolCatalogJson} class="v2-hero-search reveal" data-reveal>
                <div class="relative">
                    <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-ink-500 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                    </svg>
                    <input id="tool-search" type="search" autocomplete="off" aria-label="搜尋所有計算工具" aria-controls="search-results" aria-expanded="false" placeholder="例如：人生模擬器、資遣費、車貸" class="v2-search-input" />
                    <div id="search-results" role="listbox" aria-label="工具搜尋結果" class="hidden absolute left-0 right-0 mt-2 bg-paper-200 border border-paper-300 rounded-xl p-2 space-y-0.5 max-h-72 overflow-y-auto shadow-card-hover z-30"></div>
                    <p id="search-status" class="sr-only" aria-live="polite"></p>
                </div>

                <div class="v2-scenarios" role="group" aria-label="情境快速入口">
                    <button type="button" data-scenario-keyword="外送">外送跑單</button>
                    <button type="button" data-scenario-category="居住與房產">買房</button>
                    <button type="button" data-scenario-category="交通與購車">買車</button>
                    <button type="button" data-scenario-keyword="薪資">轉職談薪</button>
                    <button type="button" data-scenario-category="投資與退休">退休規劃</button>
                    <button type="button" data-scenario-category="薪資與稅務">報稅</button>
                </div>
            </div>

            <div class="mt-7 reveal" data-reveal>
                <a href="#support-tools" class="v2-btn-mustard" data-sfx="accent">瀏覽全部工具</a>
            </div>

            <div class="v2-hero-trust">
                <span>免註冊</span><span>在地法規資料</span><span>試算不留個資</span>
            </div>
        </div>
    </section>

    <section id="new-decisions" class="v2-section reveal" data-reveal>
        <div class="max-w-6xl mx-auto px-4 md:px-6">
            <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="v2-kicker">熱門工具</p>
                    <h2 class="v2-h2">先算最常遇到的事</h2>
                </div>
            </div>
            <div class="decision-card-grid">
                {featuredDecisions.map((tool, index) => (
                    <a href={tool.href} class={`decision-card group ${index === 0 || index === 6 ? 'decision-card-wide' : ''}`} data-sfx="tap">
                        <div class="flex items-start justify-between gap-4">
                            <span class="decision-index">{String(index + 1).padStart(2, '0')}</span>
                            <span class="decision-arrow">↗</span>
                        </div>
                        <div>
                            <p class="text-[11px] font-semibold tracking-[.12em] text-brand-600">{tool.category}</p>
                            <h3 class="mt-2 text-lg font-semibold text-ink-800">{tool.label}</h3>
                            <p class="mt-2 text-sm leading-6 text-ink-500">{tool.desc}</p>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="border-t border-paper-300 v2-section reveal" data-reveal>
        <div class="max-w-6xl mx-auto px-4 md:px-6">
            <div class="v2-trust-grid">
                <div class="v2-trust-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                    <div>
                        <p class="v2-trust-title">免註冊</p>
                        <p class="v2-trust-desc">試算都在你的瀏覽器完成，不用登入</p>
                    </div>
                </div>
                <div class="v2-trust-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                    <div>
                        <p class="v2-trust-title">在地法規</p>
                        <p class="v2-trust-desc">標示資料年度、版本與官方來源</p>
                    </div>
                </div>
                <div class="v2-trust-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <div>
                        <p class="v2-trust-title">不留個資</p>
                        <p class="v2-trust-desc">薪資財務數字不上傳、不儲存</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="support-tools" class="border-t border-paper-300 v2-section reveal" data-reveal>
        <div class="max-w-6xl mx-auto px-4 md:px-6">
            <div class="mb-8 flex flex-col gap-4 lg:mb-12 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="v2-kicker">所有工具</p>
                    <h2 class="v2-h2">生活計算器</h2>
                </div>
            </div>

            <div class="mb-7 flex gap-2 overflow-x-auto pb-2 no-scrollbar" role="group" aria-label="依類別篩選工具">
                <button type="button" class="catalog-filter is-active" data-category-filter="all" aria-pressed="true">全部</button>
                {categoryNames.map((category) => (
                    <button type="button" class="catalog-filter" data-category-filter={category} aria-pressed="false">{category}</button>
                ))}
            </div>
            <p id="catalog-status" class="sr-only" aria-live="polite"></p>

            <div id="catalog-grid" class="grid gap-5 lg:grid-cols-2">
                {supportCategories.map((group) => (
                    <section class="catalog-group card-surface p-4 sm:p-5" data-category={group.category} aria-labelledby={`category-${group.category}`}>
                        <div class="mb-3 flex items-center justify-between border-b border-paper-300 pb-3">
                            <h3 id={`category-${group.category}`} class="text-sm font-semibold text-ink-700">{group.category}</h3>
                        </div>
                        <div class="grid gap-1">
                            {group.tools.map((tool) => (
                                <a href={tool.href} class="group flex items-center justify-between rounded-xl px-3 py-3 hover:bg-paper-100 transition-colors" data-sfx="tap">
                                    <div>
                                        <p class="text-sm font-medium text-ink-700 group-hover:text-brand transition-colors">{tool.label}</p>
                                        <p class="text-xs text-ink-500 mt-1">{tool.desc}</p>
                                    </div>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-500 group-hover:text-brand group-hover:translate-x-0.5 transition-all"><path d="m9 18 6-6-6-6"/></svg>
                                </a>
                            ))}
                        </div>
                    </section>
                ))}
            </div>
        </div>
    </section>

    <section class="border-t border-paper-300 v2-section reveal" data-reveal>
        <div class="max-w-6xl mx-auto px-4 md:px-6">
            <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="v2-kicker">專欄文章</p>
                    <h2 class="v2-h2">需要時再看說明</h2>
                </div>
                <a href="/blog" class="text-sm text-brand hover:text-brand-400">查看全部文章 →</a>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
                {latestPosts.map((post) => (
                    <a href={`/blog/${post.id}`} class="group card-surface-hover overflow-hidden">
                        {post.data.coverImage && (
                            <div class="aspect-[16/9] overflow-hidden border-b border-paper-300">
                                <img src={post.data.coverImage} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
                            </div>
                        )}
                        <div class="p-5">
                            <div class="flex items-center gap-2 text-[11px] text-ink-500">
                                <span>{post.data.category}</span><span>·</span><time datetime={post.data.date}>{post.data.date}</time>
                            </div>
                            <h3 class="mt-3 text-base font-semibold leading-6 text-ink-700 group-hover:text-brand transition-colors">{post.data.title}</h3>
                            <p class="mt-2 line-clamp-2 text-xs leading-6 text-ink-500">{post.data.excerpt}</p>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="border-t border-paper-300 v2-section reveal" data-reveal>
        <div class="max-w-3xl mx-auto px-4 md:px-6">
            <p class="v2-kicker">FAQ</p>
            <h2 class="v2-h2">使用前常見問題</h2>
            <div class="mt-7 space-y-3">
                {homeFaqs.map((faq) => (
                    <details class="group rounded-2xl border border-paper-300 bg-paper-200/70 p-5">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-ink-700">
                            {faq.q}<span class="text-brand transition-transform group-open:rotate-45">＋</span>
                        </summary>
                        <p class="mt-4 border-t border-paper-300 pt-4 text-sm leading-7 text-ink-500">{faq.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

<script>
const escapeHtml = (value: unknown): string => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    "'": '&#39;',
    '"': '&quot;',
}[char] ?? char));

const searchInput = document.getElementById('tool-search') as HTMLInputElement | null;
const searchResults = document.getElementById('search-results');
const searchStatus = document.getElementById('search-status');
const toolCatalogData = document.getElementById('tool-discovery')?.dataset.toolCatalog || '[]';
const searchTools = JSON.parse(toolCatalogData) as Array<{
    href: string;
    label: string;
    desc: string;
    category: string;
    tags?: string[];
    isCore?: boolean;
}>;
searchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim();
    if (!q) {
        searchResults?.classList.add('hidden');
        searchInput?.setAttribute('aria-expanded', 'false');
        if (searchStatus) searchStatus.textContent = '';
        return;
    }

    const normalizedQuery = q.toLowerCase();
    const hits = searchTools.filter((tool) =>
        [tool.label, tool.desc, tool.category, ...(tool.tags ?? [])].some((keyword) =>
            keyword.toLowerCase().includes(normalizedQuery)
        )
    );

    if (searchResults) {
        if (!hits.length) {
            searchResults.innerHTML = `<p class="text-xs text-ink-400 px-3 py-2">找不到「${escapeHtml(q)}」的相關工具</p>`;
        } else {
            searchResults.innerHTML = hits.map((tool) => `
                <a href="${escapeHtml(tool.href)}" role="option" class="flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-paper-300 transition-colors group" data-sfx="tap">
                    <div>
                        <p class="text-sm font-medium text-ink-700">${escapeHtml(tool.label)}</p>
                        <p class="text-xs text-ink-400 mt-0.5">${escapeHtml(tool.desc)}</p>
                    </div>
                    <svg class="text-ink-400 group-hover:text-brand shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            `).join('');
        }
        searchResults.classList.remove('hidden');
        searchInput?.setAttribute('aria-expanded', 'true');
        if (searchStatus) searchStatus.textContent = hits.length ? `找到 ${hits.length} 個相關工具` : '找不到相關工具';
    }
});

document.addEventListener('click', (e) => {
    if (!searchInput?.contains(e.target as Node) && !searchResults?.contains(e.target as Node)) {
        searchResults?.classList.add('hidden');
        searchInput?.setAttribute('aria-expanded', 'false');
    }
});

searchInput?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    searchResults?.classList.add('hidden');
    searchInput.setAttribute('aria-expanded', 'false');
    searchInput.blur();
});

document.querySelectorAll('[data-scenario-keyword]').forEach((chip) => {
    chip.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = chip.dataset.scenarioKeyword || '';
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        searchInput.focus();
        document.getElementById('tool-discovery')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
});

document.querySelectorAll('[data-scenario-category]').forEach((chip) => {
    chip.addEventListener('click', () => {
        const target = document.querySelector(`[data-category-filter="${chip.dataset.scenarioCategory}"]`);
        if (target instanceof HTMLButtonElement) {
            target.click();
        }
        document.getElementById('support-tools')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});

const catalogFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
const catalogGroups = Array.from(document.querySelectorAll<HTMLElement>('.catalog-group'));
const catalogStatus = document.getElementById('catalog-status');

catalogFilters.forEach((button) => {
    button.addEventListener('click', () => {
        const selected = button.dataset.categoryFilter || 'all';
        catalogFilters.forEach((filter) => {
            const active = filter === button;
            filter.classList.toggle('is-active', active);
            filter.setAttribute('aria-pressed', String(active));
        });
        catalogGroups.forEach((group) => {
            group.hidden = selected !== 'all' && group.dataset.category !== selected;
        });
        if (catalogStatus) {
            catalogStatus.textContent = selected === 'all' ? '已顯示所有工具類別' : `已顯示${selected}工具`;
        }
    });
});
</script>
</Layout>
