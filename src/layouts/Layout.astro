---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
    description?: string;
    fullWidth?: boolean;
    hideNav?: boolean;
    hideFooter?: boolean;
    ogImage?: string;
    keywords?: string;
    type?: string;
}

const {
    title,
    description = "TaiCalc 專業財務計算平台｜台灣人專用免費線上工具。2026 最新薪資稅額、勞健保級距、新青安房貸試算、FIRE 退休規劃、股票當沖手續費計算。完全本地運算，資料不外傳。",
    fullWidth = false,
    hideNav = false,
    hideFooter = false,
    ogImage = "https://taicalc.com/og-image-v2.png",
    keywords = "薪資計算機,房貸試算,所得稅,2026新制,勞健保,FIRE退休,當沖手續費,台灣財務計算機,免費線上工具",
    type = "website"
} = Astro.props;

const canonicalPath = Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '');
const canonicalURL = new URL(canonicalPath, Astro.site);
const siteName = "TaiCalc 財務計算平台";
const fullTitle = title.includes("TaiCalc") ? title : `${title} | TaiCalc`;
const gaId = import.meta.env.PUBLIC_GA_ID || "G-J6BM5DCBNN";
---

<!DOCTYPE html>
<html lang="zh-TW">
	<head>
		<meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="TaiCalc" />
        <meta name="theme-color" content="#F6F8F5" />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow" />
        <meta name="language" content="Chinese" />
        <meta name="revisit-after" content="7 days" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

        <!-- Open Graph / Social -->
        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content="zh_TW" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@taicalc" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

		<title>{fullTitle}</title>

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": siteName,
            "alternateName": "台灣財務計算機",
            "url": "https://taicalc.com",
            "description": description,
            "keywords": keywords,
            "inLanguage": "zh-TW",
            "potentialAction": {
                "@type": "SearchAction",
                "target": {
                    "@type": "EntryPoint",
                    "urlTemplate": "https://taicalc.com/?search={search_term_string}"
                },
                "query-input": "required name=search_term_string"
            }
        })} />

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "TaiCalc",
            "url": "https://taicalc.com",
            "logo": "https://taicalc.com/favicon.svg",
            "description": "專為台灣人設計的免費財務計算機平台",
            "sameAs": [
                "https://github.com/lalawgwg99/taicalc-platform"
            ],
            "contactPoint": {
                "@type": "ContactPoint",
                "email": "service@taicalc.com",
                "contactType": "customer service"
            }
        })} />

        <!-- Fonts — Space Grotesk + IBM Plex Sans -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet" />

        <!-- Google Analytics (GA4) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId);
        </script>
        <slot name="head" />
    </head>
    <body class="bg-paper-100 text-ink-700 min-h-screen flex flex-col font-sans antialiased selection:bg-brand selection:text-paper-50">
        <a href="#main-content" class="skip-link">跳到主要內容</a>
        { !fullWidth ? (
            <div class="max-w-6xl mx-auto px-4 md:px-6 w-full flex-grow flex flex-col">
                { !hideNav && <Navbar /> }
                <main id="main-content" class="flex-grow">
                    <slot />
                </main>
                { !hideFooter && <Footer /> }
            </div>
        ) : (
            <div class="w-full flex-grow flex flex-col">
                { !hideNav && <div class="max-w-6xl mx-auto px-4 md:px-6 w-full"><Navbar /></div> }
                <main id="main-content" class="flex-grow">
                    <slot />
                </main>
                { !hideFooter && <div class="max-w-6xl mx-auto px-4 md:px-6 w-full"><Footer /></div> }
            </div>
        )}

    <script is:inline>
    // ── Analytics Bridge (GA4) ─────────────────────────────────────
    (function () {
        const funnelSteps = {
            search_entry: { step: 1, label: '搜尋進站' },
            tool_view: { step: 2, label: '開啟工具' },
            calculation_start: { step: 3, label: '開始輸入' },
            calculation_complete: { step: 4, label: '完成試算' },
            result_copy: { step: 5, label: '複製結果' },
            next_tool_click: { step: 6, label: '前往下一工具' },
            partner_click: { step: 7, label: '合作連結' },
        };

        const safeSessionGet = (key) => {
            try {
                return window.sessionStorage.getItem(key);
            } catch {
                return null;
            }
        };

        const safeSessionSet = (key, value) => {
            try {
                window.sessionStorage.setItem(key, value);
            } catch {
                // Analytics must never block the calculator.
            }
        };

        const createSessionId = () => {
            try {
                return window.crypto.randomUUID();
            } catch {
                return `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
            }
        };

        const funnelSessionId = safeSessionGet('taicalc_funnel_session') || createSessionId();
        safeSessionSet('taicalc_funnel_session', funnelSessionId);

        const toolId = window.location.pathname.startsWith('/tools/')
            ? window.location.pathname.replace(/^\/tools\//, '').replace(/\/$/, '').replace(/\.html$/, '')
            : '';

        const track = (eventName, params = {}) => {
            try {
                const funnel = funnelSteps[eventName];
                const payload = {
                    page_path: window.location.pathname,
                    page_type: toolId ? 'tool' : 'content',
                    funnel_session_id: funnelSessionId,
                    ...(toolId ? { tool_id: toolId } : {}),
                    ...(funnel ? {
                        funnel_name: 'tool_conversion_v1',
                        funnel_step: funnel.step,
                        funnel_step_name: funnel.label,
                    } : {}),
                    ...params,
                };
                const gtagFn = window.gtag;
                if (typeof gtagFn === 'function') {
                    gtagFn('event', eventName, payload);
                    return;
                }
                const dataLayer = (window.dataLayer = window.dataLayer || []);
                dataLayer.push({ event: eventName, ...payload });
            } catch (_) {
                // Ignore analytics errors to avoid affecting user flows.
            }
        };

        Reflect.set(window, 'taicalcTrackEvent', track);

        const landingUrl = new URL(window.location.href);
        const referrerHost = (() => {
            try {
                return document.referrer ? new URL(document.referrer).hostname.toLowerCase() : '';
            } catch {
                return '';
            }
        })();
        const utmSource = landingUrl.searchParams.get('utm_source')?.toLowerCase() || '';
        const utmMedium = landingUrl.searchParams.get('utm_medium')?.toLowerCase() || '';
        const hasGoogleClickId = landingUrl.searchParams.has('gclid');
        const referrerSearchSource =
            /google\./.test(referrerHost) ? 'google' :
                /bing\./.test(referrerHost) ? 'bing' :
                    /yahoo\./.test(referrerHost) ? 'yahoo' : '';
        const isSearchMedium = ['organic', 'cpc', 'paid_search'].includes(utmMedium);
        const isSearchEntry = hasGoogleClickId ||
            Boolean(referrerSearchSource) ||
            isSearchMedium;

        if (isSearchEntry && safeSessionGet('taicalc_search_entry_sent') !== '1') {
            track('search_entry', {
                traffic_source: utmSource || referrerSearchSource || (hasGoogleClickId ? 'google' : 'search'),
                traffic_medium: utmMedium || (hasGoogleClickId ? 'cpc' : 'organic'),
                landing_path: window.location.pathname,
            });
            safeSessionSet('taicalc_search_entry_sent', '1');
        }

        if (toolId) {
            track('tool_view', { tool_path: window.location.pathname });
        }

        document.addEventListener('click', (event) => {
            const target = event.target;
            const anchor = target instanceof Element ? target.closest('a[href]') : null;
            if (!anchor) return;
            const href = anchor.getAttribute('href') ?? '';

            if (anchor.dataset.partnerId) {
                track('partner_click', {
                    partner_id: anchor.dataset.partnerId,
                    partner_placement: anchor.dataset.partnerPlacement || 'unspecified',
                    offer_type: anchor.dataset.offerType || 'unspecified',
                });
            }

            if (anchor.hasAttribute('data-next-tool')) {
                track('next_tool_click', {
                    next_tool_path: href,
                    source_tool_id: toolId,
                });
            }

            if (href.startsWith('/tools/')) {
                track('tool_click', {
                    tool_path: href,
                    source_path: window.location.pathname,
                });
            }
        });

    })();
    </script>

    <script>
    // ── Reveal ────────────────────────────────────────────────────
    (function () {
        const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (!revealItems.length) return;
        if (!('IntersectionObserver' in window)) {
            revealItems.forEach(el => el.classList.add('is-visible'));
            return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });

        revealItems.forEach(el => observer.observe(el));
    })();
    </script>

	</body>
</html>
