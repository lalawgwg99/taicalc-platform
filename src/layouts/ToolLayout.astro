---
import Layout from './Layout.astro';
import { platformGovernance, type SourceLink } from '../data/regulatoryMetadata';
import { getRelatedTools, normalizeToolPath } from '../data/toolCatalog';
import { defaultToolHelp, toolHelp } from '../data/toolHelp';

interface Props {
  title: string;
  description: string;
  category?: string;
  faqs?: { q: string; a: string }[];
  keywords?: string;
  kicker?: string;
  compactHero?: boolean;
  dataVersion?: string;
  dataYear?: string;
  lastUpdated?: string;
  sources?: SourceLink[];
}

const {
  title,
  description,
  category = "台灣生活財務",
  faqs = [],
  keywords,
  kicker = "先算，再看細節",
  compactHero = true,
  dataVersion = platformGovernance.version,
  dataYear = platformGovernance.dataYear,
  lastUpdated = platformGovernance.updatedAt,
  sources = platformGovernance.sources
} = Astro.props;

const faqSchema = faqs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
      "dateCreated": lastUpdated
    }
  }))
}) : null;

const currentPath = normalizeToolPath(Astro.url.pathname);
const currentHelp = toolHelp[currentPath] ?? defaultToolHelp;

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title.replace(/｜TaiCalc$/, '').replace(/\｜.*$/, ''),
  "description": description,
  "url": `https://taicalc.com${currentPath}`,
  "applicationCategory": "FinanceApplication",
  "applicationSubCategory": category,
  "operatingSystem": "All",
  "inLanguage": "zh-TW",
  "isAccessibleForFree": true,
  "dateModified": lastUpdated,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "TWD"
  },
  "browserRequirements": "Requires JavaScript",
  "softwareVersion": dataVersion,
  "keywords": keywords || "台灣,財務計算,免費工具",
  "citation": sources.map(source => source.href),
  "featureList": ["即時試算", "本機運算", "結果分享", "方案比較"]
});

const fallbackTitle = title.replace(/｜TaiCalc$/, '').replace(/\｜.*$/, '');
const cleanTitle = fallbackTitle;
const relatedTools = getRelatedTools(currentPath);
const immediateTools = relatedTools.slice(0, 2);
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "TaiCalc", "item": "https://taicalc.com/" },
    { "@type": "ListItem", "position": 2, "name": cleanTitle, "item": `https://taicalc.com${currentPath}` }
  ]
});
const relatedToolsSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${cleanTitle}相關工具`,
  "itemListElement": relatedTools.map((tool, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": tool.label,
    "url": `https://taicalc.com${tool.href}`
  }))
});
---

<Layout title={title} description={description} keywords={keywords}>
    <meta name="citation_title" content={cleanTitle} slot="head" />
    <meta name="citation_publication_date" content={lastUpdated} slot="head" />
    <meta name="citation_fulltext_world_readable" content="true" slot="head" />
    {faqSchema && <script type="application/ld+json" set:html={faqSchema} slot="head" />}
    <script type="application/ld+json" set:html={webAppSchema} slot="head" />
    <script type="application/ld+json" set:html={breadcrumbSchema} slot="head" />
    <script type="application/ld+json" set:html={relatedToolsSchema} slot="head" />
    <div class="book-tool mx-auto max-w-[64rem] px-4 pb-24 md:px-6 md:pb-16">
        <header class="border-b border-[#E3DCCB]">
            <div class={compactHero ? 'pt-5 pb-6 md:pt-6 md:pb-6' : 'pt-6 pb-8 md:pt-10 md:pb-10'}>
                <div class="mb-4 flex items-center justify-between gap-3">
                    <a href="/" class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-400 hover:text-brand-700 transition-colors group">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                        所有工具
                    </a>
                    <span class="text-xs font-semibold tracking-[.12em] text-[#A58436]">{dataYear}</span>
                </div>
                <p class="book-kicker">{category}</p>
                <h1 class="book-h1">{cleanTitle}</h1>
                <p class="book-sub">{kicker}</p>
                {!compactHero && (
                    <div class="mt-5">
                        <a href="#calculator-panel" data-sfx="accent" class="book-more-link">開始試算 →</a>
                    </div>
                )}
            </div>
        </header>

        <section id="calculator-panel" class="mb-10 max-w-none" aria-label="計算器">
            <details class="mb-4 px-1 py-2">
                <summary class="cursor-pointer text-xs font-semibold text-ink-500 hover:text-ink-700">第一次使用？30 秒知道怎麼填</summary>
                <div class="mt-3 grid gap-x-8 gap-y-2 border-l-2 border-[#E3DCCB] pl-4 text-xs leading-5 text-ink-500 sm:grid-cols-3">
                    {currentHelp.map((help, index) => <p><strong class="text-ink-700">{index + 1}.</strong> {help}</p>)}
                </div>
            </details>
            <slot name="tool" />
            <slot name="after-tool" />
            <div id="calc-load-error" hidden class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-4 text-center">
                <p class="text-sm font-semibold text-red-700">計算器載入失敗</p>
                <p class="mt-1 text-xs leading-5 text-red-600/80">可能是網路不穩或載入逾時，請重新載入頁面再試一次。</p>
                <button type="button" id="calc-reload-btn" class="mt-3 inline-flex items-center justify-center rounded-lg bg-[#1D4B34] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#163B29]">重新載入</button>
            </div>
            <nav aria-label="相關工具" class="after-tool-content mt-8 border-t border-[#E3DCCB] pt-5">
                <p class="book-kicker">相關工具</p>
                <div class="mt-2">
                    {immediateTools.map((tool) => (
                        <a href={tool.href} data-next-tool class="group flex items-baseline justify-between gap-3 border-b border-[#E3DCCB] py-3">
                            <span class="min-w-0">
                                <strong class="block text-sm font-semibold text-ink-700">{tool.label}</strong>
                                <small class="mt-0.5 block text-xs leading-5 text-ink-400">{tool.desc}</small>
                            </span>
                            <span aria-hidden="true" class="shrink-0 text-[#1D4B34] transition group-hover:translate-x-0.5">→</span>
                        </a>
                    ))}
                </div>
            </nav>
        </section>

        <section class="max-w-4xl mb-12">
            <details class="border-t border-[#E3DCCB] pt-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-ink-700">
                    <span class="inline-flex items-center gap-2"><i class="h-2 w-2 rounded-full bg-[#A58436]"></i>資料版本與來源</span>
                    <span class="text-[10px] font-medium text-ink-400">更新 {lastUpdated}</span>
                </summary>
                <ul class="mt-4 grid gap-2">
                    {sources.map((source) => (
                        <li>
                            <a href={source.href} target="_blank" rel="noopener noreferrer" class="action-link w-full justify-between !text-xs">
                                <span>{source.label}</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                            </a>
                        </li>
                    ))}
                </ul>
                <p class="mt-4 text-xs leading-5 text-ink-400">版本 {dataVersion} · 結果供估算，正式金額以主管機關為準。</p>
            </details>
        </section>

        <details id="guide-panel" class="mb-12 max-w-4xl border-t border-[#E3DCCB] pt-5">
            <summary class="cursor-pointer text-sm font-semibold text-ink-700">規則說明</summary>
            <article class="prose prose-gray mt-5 text-sm">
                <slot name="article" />
            </article>
        </details>

        {faqs.length > 0 && (
            <section class="mb-16 max-w-4xl">
                <div class="mb-6 border-t border-[#E3DCCB] pt-10">
                    <p class="book-kicker">FAQ</p>
                    <h2 class="book-h2">常見問題</h2>
                </div>
                <div>
                    {faqs.map((faq) => (
                        <details class="book-faq group">
                            <summary>
                                <span>{faq.q}</span>
                                <span class="transition-transform group-open:rotate-45">＋</span>
                            </summary>
                            <p>{faq.a}</p>
                        </details>
                    ))}
                </div>
            </section>
        )}

    </div>
</Layout>

<script>
const track = (window as any).taicalcTrackEvent as ((eventName: string, params?: Record<string, string | number | boolean>) => void) | undefined;
const calculatorPanel = document.getElementById('calculator-panel');
if (calculatorPanel) {
        const toolPath = window.location.pathname;
        let started = false;
        let lastCompletionAt = 0;
        let lastResultSignature = '';

        const markStarted = () => {
            if (started) return;
            started = true;
            track?.('calculation_start', {
                tool_path: toolPath,
            });
        };

        const readResultSignature = () => {
            const blocks = Array.from(
                calculatorPanel.querySelectorAll<HTMLElement>('.result-card, .result-main-card, .result-value, [class*="result"]')
            );
            const values = blocks
                .map((block) => block.textContent?.replace(/\s+/g, ' ').trim() ?? '')
                .filter((text) => /[\d$%NT]/.test(text))
                .slice(0, 8);
            return values.join('|').slice(0, 360);
        };

        const markCompleted = () => {
            if (!started) return;
            const now = Date.now();
            if (now - lastCompletionAt < 1200) return;
            const signature = readResultSignature();
            if (!signature || signature === lastResultSignature) return;
            lastResultSignature = signature;
            lastCompletionAt = now;
            track?.('calculation_complete', {
                tool_path: toolPath,
            });
        };

        calculatorPanel.addEventListener('input', (event) => {
            const target = event.target as HTMLElement | null;
            if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement)) return;
            markStarted();
            window.setTimeout(markCompleted, 650);
        });

        calculatorPanel.addEventListener('change', (event) => {
            const target = event.target as HTMLElement | null;
            if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement)) return;
            markStarted();
            window.setTimeout(markCompleted, 50);
        });

        calculatorPanel.addEventListener('click', (event) => {
            const target = event.target as HTMLElement | null;
            const button = target?.closest('button');
            if (!button) return;
            const label = button.textContent?.trim() ?? '';
            if (/計算|試算|更新|比較|分析|開始|送出/.test(label)) {
                markStarted();
                window.setTimeout(markCompleted, 50);
            }
        });

        const observer = new MutationObserver(() => {
            window.setTimeout(markCompleted, 80);
        });
        observer.observe(calculatorPanel, { subtree: true, childList: true, characterData: true });

        // 掛載看門狗：2026-11-22 起計算器改 SSR（client:load），輸入欄位由伺服端直出、
        // 首屏即存在；10 秒後島區域仍無任何輸入欄位，代表整頁渲染失敗，顯示錯誤與重新載入按鈕。
        // 注意：JS 載入失敗時輸入欄位看得見但點了沒反應，此檢查抓不到那種情況（需重整）。
        // （本站是純 MPA、沒有 client router，所謂「站內切換空白」實為冷載入水合慢）。
        window.setTimeout(() => {
            if (calculatorPanel.querySelector('input, select, textarea')) return;
            const err = document.getElementById('calc-load-error');
            if (err) err.hidden = false;
        }, 10000);
        document.getElementById('calc-reload-btn')?.addEventListener('click', () => {
            window.location.reload();
        });
}
</script>

<style is:global>
/* 工具頁底色跟首頁一樣走暖白，與書式內容銜接 */
body.bg-paper-100 { background-color: #FDFCF8; }

@media print {
    body.print-tool-report {
        background: #fff !important;
    }

    body.print-tool-report nav,
    body.print-tool-report footer,
    body.print-tool-report header,
    body.print-tool-report .after-tool-content,
    body.print-tool-report #calculator-panel ~ section,
    body.print-tool-report #guide-panel {
        display: none !important;
    }

    body.print-tool-report #calculator-panel {
        margin: 0 !important;
        max-width: none !important;
    }
}
</style>
