---
import Layout from './Layout.astro';
import { platformGovernance, type SourceLink } from '../data/regulatoryMetadata';
import { getRelatedTools, normalizeToolPath } from '../data/toolCatalog';

interface Props {
  title: string;
  description: string;
  category?: string;
  faqs?: { q: string; a: string }[];
  keywords?: string;
  kicker?: string;
  dataVersion?: string;
  dataYear?: string;
  lastUpdated?: string;
  sources?: SourceLink[];
}

const {
  title,
  description,
  category = "台灣生活財務",
  faqs = [],
  keywords,
  kicker = "先算，再看細節",
  dataVersion = platformGovernance.version,
  dataYear = platformGovernance.dataYear,
  lastUpdated = platformGovernance.updatedAt,
  sources = platformGovernance.sources
} = Astro.props;

const faqSchema = faqs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
      "dateCreated": lastUpdated
    }
  }))
}) : null;

const currentPath = normalizeToolPath(Astro.url.pathname);

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title.replace(/｜TaiCalc$/, '').replace(/\｜.*$/, ''),
  "description": description,
  "url": `https://taicalc.com${currentPath}`,
  "applicationCategory": "FinanceApplication",
  "applicationSubCategory": category,
  "operatingSystem": "All",
  "inLanguage": "zh-TW",
  "isAccessibleForFree": true,
  "dateModified": lastUpdated,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "TWD"
  },
  "browserRequirements": "Requires JavaScript",
  "softwareVersion": dataVersion,
  "keywords": keywords || "台灣,財務計算,免費工具",
  "citation": sources.map(source => source.href),
  "featureList": ["即時試算", "本機運算", "結果分享", "方案比較"]
});

const fallbackTitle = title.replace(/｜TaiCalc$/, '').replace(/\｜.*$/, '');
const cleanTitle = fallbackTitle;
const relatedTools = getRelatedTools(currentPath);
const immediateTools = relatedTools.slice(0, 2);
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "TaiCalc", "item": "https://taicalc.com/" },
    { "@type": "ListItem", "position": 2, "name": cleanTitle, "item": `https://taicalc.com${currentPath}` }
  ]
});
const relatedToolsSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${cleanTitle}相關工具`,
  "itemListElement": relatedTools.map((tool, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": tool.label,
    "url": `https://taicalc.com${tool.href}`
  }))
});
---

<Layout title={title} description={description} keywords={keywords}>
    {faqSchema && <script type="application/ld+json" set:html={faqSchema} slot="head" />}
    <script type="application/ld+json" set:html={webAppSchema} slot="head" />
    <script type="application/ld+json" set:html={breadcrumbSchema} slot="head" />
    <script type="application/ld+json" set:html={relatedToolsSchema} slot="head" />
    <div class="max-w-6xl mx-auto px-4 md:px-0">
        <header class="pt-4 pb-5">
            <div class="tool-hero-panel hero-sheen relative overflow-hidden">
                <div class="relative z-10">
                    <div class="mb-3 flex items-center justify-between gap-3">
                        <a href="/" class="inline-flex items-center gap-1.5 text-xs text-ink-400 hover:text-ink-700 transition-colors group">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform">
                                <path d="M19 12H5M12 19l-7-7 7-7"/>
                            </svg>
                            所有工具
                        </a>
                        <span class="data-pill !px-2.5 !py-1">{dataYear}</span>
                    </div>
                    <h1 class="mb-2 text-2xl font-semibold text-ink-700 md:text-4xl">{cleanTitle}</h1>
                    <p class="max-w-2xl text-sm leading-relaxed text-ink-500">{kicker}</p>
                    <div class="tool-hero-actions mt-4 flex flex-wrap gap-2">
                        <a href="#calculator-panel" class="action-link" data-sfx="accent">開始試算</a>
                        <button
                            id="share-tool"
                            type="button"
                            class="action-link"
                            data-share-title={cleanTitle}
                            aria-label="分享這個工具"
                        >
                            分享
                        </button>
                        <button id="print-tool-report" type="button" class="action-link" aria-label="列印或儲存 PDF">
                            PDF
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <main id="calculator-panel" class="mb-10 max-w-6xl">
            <slot name="tool" />
            <slot name="after-tool" />
            <nav aria-label="下一步試算" class="after-tool-content mt-4 rounded-2xl border border-paper-300 bg-white/75 p-3 shadow-[0_18px_45px_-40px_rgba(9,35,26,.45)]">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                    <p class="shrink-0 px-2 text-[10px] font-semibold tracking-[.12em] text-ink-400">下一步</p>
                    <div class="grid flex-1 gap-2 sm:grid-cols-2">
                        {immediateTools.map((tool) => (
                            <a href={tool.href} data-next-tool class="group flex items-center justify-between gap-3 rounded-xl bg-paper-200 px-3 py-2.5 transition hover:bg-brand-50">
                                <span class="min-w-0">
                                    <strong class="block truncate text-xs font-semibold text-ink-700">{tool.label}</strong>
                                    <small class="mt-0.5 block truncate text-[10px] text-ink-400">{tool.desc}</small>
                                </span>
                                <span aria-hidden="true" class="shrink-0 text-brand-600 transition group-hover:translate-x-0.5">→</span>
                            </a>
                        ))}
                    </div>
                </div>
            </nav>
        </main>

        <section class="max-w-4xl mb-12">
            <details class="rounded-2xl border border-paper-300 bg-paper-200 p-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-ink-700">
                    <span class="inline-flex items-center gap-2"><i class="h-2 w-2 rounded-full bg-brand-500"></i>資料版本與來源</span>
                    <span class="text-[10px] font-medium text-ink-400">更新 {lastUpdated}</span>
                </summary>
                <ul class="mt-4 grid gap-2">
                    {sources.map((source) => (
                        <li>
                            <a href={source.href} target="_blank" rel="noopener noreferrer" class="action-link w-full justify-between !text-xs">
                                <span>{source.label}</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                            </a>
                        </li>
                    ))}
                </ul>
                <p class="mt-4 text-xs leading-5 text-ink-400">版本 {dataVersion} · 結果供估算，正式金額以主管機關為準。</p>
            </details>
        </section>

        <details id="guide-panel" class="mb-12 max-w-4xl rounded-2xl border border-paper-300 bg-paper-200 p-5">
            <summary class="cursor-pointer text-sm font-semibold text-ink-700">規則說明</summary>
            <article class="prose prose-gray mt-5 text-sm">
                <slot name="article" />
            </article>
        </details>

        {faqs.length > 0 && (
            <section class="mb-16 max-w-4xl">
                <div class="flex items-center gap-3 mb-6 border-t border-paper-300 pt-10">
                    <div class="w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-500">
                            <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>
                        </svg>
                    </div>
                    <h2 class="text-base font-semibold text-ink-700">常見問題</h2>
                </div>
                <dl class="space-y-3">
                    {faqs.map((faq) => (
                        <details class="group bg-paper-200 border border-paper-300 rounded-xl overflow-hidden hover:border-brand-200 transition-colors">
                            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none">
                                <dt class="text-sm font-medium text-ink-700 pr-4">{faq.q}</dt>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     class="text-ink-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </summary>
                            <dd class="px-5 pb-4 text-sm text-ink-500 leading-relaxed border-t border-paper-300/60 pt-3">{faq.a}</dd>
                        </details>
                    ))}
                </dl>
            </section>
        )}

    </div>
</Layout>

<script>
const shareToolButton = document.getElementById('share-tool') as HTMLButtonElement | null;
const printToolButton = document.getElementById('print-tool-report') as HTMLButtonElement | null;

shareToolButton?.addEventListener('click', async () => {
    const shareTitle = shareToolButton.dataset.shareTitle || document.title;
    const shareData = {
        title: shareTitle,
        text: `用 TaiCalc 免費試算：${shareTitle}`,
        url: window.location.href,
    };
    try {
        if (navigator.share) {
            await navigator.share(shareData);
            (window as any).taicalcTrackEvent?.('tool_share', { method: 'native' });
            return;
        }
        await navigator.clipboard.writeText(window.location.href);
        const originalLabel = shareToolButton.textContent;
        shareToolButton.textContent = '連結已複製';
        (window as any).taicalcTrackEvent?.('tool_share', { method: 'clipboard' });
        window.setTimeout(() => {
            shareToolButton.textContent = originalLabel;
        }, 1800);
    } catch (error) {
        if ((error as DOMException)?.name !== 'AbortError') {
            shareToolButton.textContent = '請複製網址分享';
        }
    }
});

printToolButton?.addEventListener('click', () => {
    document.body.classList.add('print-tool-report');
    (window as any).taicalcTrackEvent?.('report_print', {
        report_type: 'tool_page',
        tool_path: window.location.pathname,
    });
    window.print();
});

window.addEventListener('afterprint', () => {
    document.body.classList.remove('print-tool-report');
});

const track = (window as any).taicalcTrackEvent as ((eventName: string, params?: Record<string, string | number | boolean>) => void) | undefined;
const calculatorPanel = document.getElementById('calculator-panel');
if (calculatorPanel) {
        const toolPath = window.location.pathname;
        let started = false;
        let lastCompletionAt = 0;
        let lastResultSignature = '';

        const markStarted = () => {
            if (started) return;
            started = true;
            track?.('calculation_start', {
                tool_path: toolPath,
            });
        };

        const readResultSignature = () => {
            const blocks = Array.from(
                calculatorPanel.querySelectorAll<HTMLElement>('.result-card, .result-main-card, .result-value, [class*="result"]')
            );
            const values = blocks
                .map((block) => block.textContent?.replace(/\s+/g, ' ').trim() ?? '')
                .filter((text) => /[\d$%NT]/.test(text))
                .slice(0, 8);
            return values.join('|').slice(0, 360);
        };

        const markCompleted = () => {
            if (!started) return;
            const now = Date.now();
            if (now - lastCompletionAt < 1200) return;
            const signature = readResultSignature();
            if (!signature || signature === lastResultSignature) return;
            lastResultSignature = signature;
            lastCompletionAt = now;
            track?.('calculation_complete', {
                tool_path: toolPath,
            });
        };

        calculatorPanel.addEventListener('input', (event) => {
            const target = event.target as HTMLElement | null;
            if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement)) return;
            markStarted();
            window.setTimeout(markCompleted, 650);
        });

        calculatorPanel.addEventListener('change', (event) => {
            const target = event.target as HTMLElement | null;
            if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement)) return;
            markStarted();
            window.setTimeout(markCompleted, 50);
        });

        calculatorPanel.addEventListener('click', (event) => {
            const target = event.target as HTMLElement | null;
            const button = target?.closest('button');
            if (!button) return;
            const label = button.textContent?.trim() ?? '';
            if (/計算|試算|更新|比較|分析|開始|送出/.test(label)) {
                markStarted();
                window.setTimeout(markCompleted, 50);
            }
        });

        const observer = new MutationObserver(() => {
            window.setTimeout(markCompleted, 80);
        });
        observer.observe(calculatorPanel, { subtree: true, childList: true, characterData: true });
}
</script>

<style is:global>
@media print {
    body.print-tool-report {
        background: #fff !important;
    }

    body.print-tool-report nav,
    body.print-tool-report footer,
    body.print-tool-report header,
    body.print-tool-report .after-tool-content,
    body.print-tool-report main#calculator-panel ~ section,
    body.print-tool-report #guide-panel {
        display: none !important;
    }

    body.print-tool-report main#calculator-panel {
        margin: 0 !important;
        max-width: none !important;
    }
}
</style>
