---
import { platformGovernance } from '../data/regulatoryMetadata';

const currentYear = new Date().getFullYear();
const tools = [
    { href: '/tools/delivery-income-calculator', label: '外送收入計算' },
    { href: '/tools/split-calculator', label: '分帳計算機' },
    { href: '/tools/electricity-calculator', label: '電費計算機' },
    { href: '/tools/salary-calculator', label: '薪資實拿計算' },
    { href: '/tools/life-simulator', label: '台灣人生模擬器' },
    { href: '/tools/labor-insurance-pension-calculator', label: '勞保老年年金' },
    { href: '/tools/labor-pension-calculator', label: '勞退試算' },
    { href: '/tools/fire-calculator', label: 'FIRE 退休規劃' },
    { href: '/#support-tools', label: '所有計算工具' },
    { href: '/blog', label: '專欄文章' },
    { href: '/data-sources', label: '資料來源' },
    { href: '/about', label: '關於我們' },
];
---
<footer class="site-footer">
    <div class="site-footer-grid">
        <div class="site-footer-intro">
            <p class="site-footer-index">台灣生活計算工具</p>
            <a href="/" class="site-footer-title">TaiCalc</a>
            <p class="site-footer-copy">
                把台灣生活裡的數字，算得更清楚。
            </p>
            <p class="site-footer-version">{platformGovernance.version} · {platformGovernance.updatedAt}</p>
        </div>

        <div class="site-footer-directory">
            <p class="site-footer-index">常用工具</p>
            <div class="site-footer-links">
                {tools.map((t, index) => (
                    <a href={t.href}><span>{String(index + 1).padStart(2, '0')}</span>{t.label}</a>
                ))}
            </div>
        </div>
    </div>

    <div class="site-footer-bottom">
        <p>© {currentYear} TaiCalc</p>
        <div class="site-footer-legal">
            <a href="/privacy">隱私權政策</a>
            <a href="/disclaimer">免責聲明</a>
            <a href="mailto:Lalawgwg99@gmail.com?subject=TaiCalc%20聯絡或問題回報">聯絡／回報問題 →</a>
        </div>
    </div>
</footer>
