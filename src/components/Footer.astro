---
import { platformGovernance } from '../data/regulatoryMetadata';

const currentYear = new Date().getFullYear();
const tools = [
    { href: '/tools/car-cost-calculator', label: '買車總成本' },
    { href: '/tools/severance-calculator', label: '離職結算' },
    { href: '/tools/home-ownership-cost-calculator', label: '買房持有成本' },
    { href: '/tools/estate-gift-tax-calculator', label: '遺產／贈與稅' },
    { href: '/#support-tools', label: '所有計算工具' },
    { href: '/blog', label: '專欄文章' },
];
---
<footer class="border-t border-paper-300 pt-10 pb-8 mt-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div>
            <a href="/" class="text-base font-semibold text-ink-700 hover:text-ink-500 transition-colors">TaiCalc</a>
            <p class="text-xs text-ink-400 mt-2 leading-relaxed max-w-sm">
                為台灣人的工作、買車、買房、家庭與退休決策，把複雜規則整理成能比較的數字。<br>
                法規型工具標示資料版本與官方來源，主要計算在瀏覽器完成。
            </p>
            <p class="text-xs text-ink-400 mt-2">版本 {platformGovernance.version} · 更新 {platformGovernance.updatedAt}</p>
        </div>

        <div>
            <p class="text-xs font-medium text-ink-400 uppercase tracking-widest mb-3">快速入口</p>
            <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                {tools.map(t => (
                    <a href={t.href} class="text-xs text-ink-400 hover:text-ink-700 transition-colors">{t.label}</a>
                ))}
            </div>
        </div>
    </div>

    <div class="flex items-center justify-between border-t border-paper-300 pt-6">
        <p class="text-xs text-ink-400">© {currentYear} TaiCalc</p>
        <a href="mailto:laladoo99@gmail.com?subject=TaiCalc%20聯絡或問題回報" class="text-xs text-ink-400 hover:text-ink-600 transition-colors">聯絡／回報問題</a>
    </div>
</footer>
