---
const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
    if (href === '/') return currentPath === '/';
    return currentPath.startsWith(href);
};
---
<nav class="site-nav">
    <div class="site-nav-inner">
        <a href="/" class="site-logo">
            <span class="site-logo-mark">∑</span>
            <span class="site-logo-word">TAI<span>CALC</span></span>
            <small>生活決策手帳</small>
        </a>

        <div class="site-nav-links">
            <a href="/" class={`site-nav-link ${isActive('/') ? 'is-active' : ''}`}>首頁</a>
            <a href="/tools/life-simulator" class={`site-nav-link ${isActive('/tools/life-simulator') ? 'is-active' : ''}`}>人生模擬</a>
            <a href="/tools/mortgage-calculator" class={`site-nav-link ${isActive('/tools/mortgage') ? 'is-active' : ''}`}>房貸</a>
            <a href="/tools/electricity-calculator" class={`site-nav-link ${isActive('/tools/electricity') ? 'is-active' : ''}`}>電費</a>
            <a href="/tools/split-calculator" class={`site-nav-link ${isActive('/tools/split') ? 'is-active' : ''}`}>分帳</a>
            <a href="/#support-tools" class="site-nav-link">所有工具</a>
            <a href="/blog" class={`site-nav-link ${isActive('/blog') ? 'is-active' : ''}`}>專欄</a>
        </div>

        <button id="menu-btn" class="site-menu-button" aria-label="開啟選單" aria-controls="mobile-menu" aria-expanded="false" data-sfx="tap">
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="8" x2="20" y2="8"></line>
                <line x1="4" y1="16" x2="20" y2="16"></line>
            </svg>
            <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
        </button>
    </div>
</nav>

<div id="mobile-menu" class="site-mobile-menu hidden">
    <div class="site-mobile-menu-inner">
        <a href="/" class="menu-link site-mobile-primary">首頁</a>
        <p class="site-mobile-label">熱門決策</p>
        <a href="/tools/life-simulator" class="menu-link site-mobile-link"><span>01</span>人生模擬器</a>
        <a href="/tools/car-cost-calculator" class="menu-link site-mobile-link"><span>02</span>買車總成本</a>
        <a href="/tools/severance-calculator" class="menu-link site-mobile-link"><span>03</span>離職結算</a>
        <a href="/tools/home-ownership-cost-calculator" class="menu-link site-mobile-link"><span>04</span>買房持有成本</a>

        <div class="site-mobile-rule"></div>
        <p class="site-mobile-label">工具入口</p>
        <a href="/#support-tools" class="menu-link site-mobile-link">查看所有計算器</a>
        <a href="/housing-toolbox" class="menu-link site-mobile-link">居住決策工具箱</a>
        <a href="/tax-season" class="menu-link site-mobile-link">報稅季攻略</a>

        <div class="site-mobile-rule"></div>
        <a href="/blog" class="menu-link site-mobile-primary">專欄文章</a>
    </div>
</div>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const menuLinks = document.querySelectorAll('.menu-link');

    const openMenu = () => {
        mobileMenu?.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        menuBtn?.setAttribute('aria-label', '關閉選單');
        menuBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
        mobileMenu?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        menuBtn?.setAttribute('aria-label', '開啟選單');
        menuBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
    };

    menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.contains('hidden') ? openMenu() : closeMenu();
    });

    menuLinks.forEach(link => link.addEventListener('click', closeMenu));
    mobileMenu?.addEventListener('click', (e) => { if (e.target === mobileMenu) closeMenu(); });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
            closeMenu();
            menuBtn?.focus();
        }
    });
</script>
