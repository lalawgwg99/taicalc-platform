---
const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
    if (href === '/') return currentPath === '/';
    return currentPath.startsWith(href);
};
---
<nav class="sticky top-0 z-50 bg-paper-100/80 backdrop-blur-2xl border-b border-paper-300/70 shadow-[0_12px_40px_-30px_rgba(19,155,121,0.32)]">
    <div class="h-14 flex items-center justify-between">
        <a href="/" class="text-lg font-semibold tracking-tight text-ink-800 hover:text-brand-500 transition-colors">Tai<span class="text-brand-500">Calc</span></a>

        <div class="hidden md:flex items-center gap-4 text-[11px] uppercase tracking-[0.2em]">
            <a href="/" class={`px-2 py-1 rounded-full transition-all ${isActive('/') ? 'text-brand-500 bg-brand-50/70 border border-brand-300/50' : 'text-ink-400 hover:text-ink-700 hover:bg-paper-200/70'}`}>首頁</a>
            <a href="/#new-decisions" class="px-2 py-1 rounded-full text-ink-400 hover:text-ink-700 hover:bg-paper-200/70 transition-all">熱門決策</a>
            <a href="/tools/car-cost-calculator" class={`px-2 py-1 rounded-full transition-all ${isActive('/tools/car-cost') ? 'text-brand-500 bg-brand-50/70 border border-brand-300/50' : 'text-ink-400 hover:text-ink-700 hover:bg-paper-200/70'}`}>買車</a>
            <a href="/tools/home-ownership-cost-calculator" class={`px-2 py-1 rounded-full transition-all ${isActive('/tools/home-ownership') ? 'text-brand-500 bg-brand-50/70 border border-brand-300/50' : 'text-ink-400 hover:text-ink-700 hover:bg-paper-200/70'}`}>買房</a>
            <a href="/#support-tools" class="px-2 py-1 rounded-full text-ink-400 hover:text-ink-700 hover:bg-paper-200/70 transition-all">所有工具</a>
            <a href="/blog" class={`px-2 py-1 rounded-full transition-all ${isActive('/blog') ? 'text-brand-500 bg-brand-50/70 border border-brand-300/50' : 'text-ink-400 hover:text-ink-700 hover:bg-paper-200/70'}`}>專欄</a>
        </div>

        <button id="menu-btn" class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg text-ink-400 hover:text-ink-700 hover:bg-paper-200/80 transition-colors" aria-label="開啟選單" aria-controls="mobile-menu" aria-expanded="false" data-sfx="tap">
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="8" x2="21" y2="8"></line>
                <line x1="3" y1="16" x2="21" y2="16"></line>
            </svg>
            <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
        </button>
    </div>
</nav>

<div id="mobile-menu" class="hidden fixed inset-0 z-40 bg-paper-100/95 backdrop-blur-2xl pt-16">
    <div class="px-4 pt-6 pb-8 flex flex-col gap-1">
        <a href="/" class="menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-lg font-medium text-ink-700 hover:bg-paper-200/80 transition-colors">首頁</a>
        <p class="px-4 text-xs font-medium text-ink-400 uppercase tracking-widest mb-1">熱門決策</p>
        <a href="/tools/car-cost-calculator" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">買車總成本</a>
        <a href="/tools/severance-calculator" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">離職結算</a>
        <a href="/tools/home-ownership-cost-calculator" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">買房持有成本</a>

        <div class="h-px bg-paper-300 my-3"></div>
        <p class="px-4 text-xs font-medium text-ink-400 uppercase tracking-widest mb-1">工具入口</p>
        <a href="/#support-tools" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">查看所有計算器</a>
        <a href="/housing-toolbox" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">居住決策工具箱</a>
        <a href="/tax-season" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">報稅季攻略</a>

        <div class="h-px bg-paper-300 my-3"></div>
        <a href="/blog" class="menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-lg font-medium text-ink-700 hover:bg-paper-200/80 transition-colors">專欄文章</a>
    </div>
</div>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const menuLinks = document.querySelectorAll('.menu-link');

    const openMenu = () => {
        mobileMenu?.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        menuBtn?.setAttribute('aria-label', '關閉選單');
        menuBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
        mobileMenu?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        menuBtn?.setAttribute('aria-label', '開啟選單');
        menuBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
    };

    menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.contains('hidden') ? openMenu() : closeMenu();
    });

    menuLinks.forEach(link => link.addEventListener('click', closeMenu));
    mobileMenu?.addEventListener('click', (e) => { if (e.target === mobileMenu) closeMenu(); });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
            closeMenu();
            menuBtn?.focus();
        }
    });
</script>
