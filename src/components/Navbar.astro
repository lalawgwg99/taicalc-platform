---
const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
    if (href === '/') return currentPath === '/';
    return currentPath.startsWith(href);
};
---
<nav class="sticky top-0 z-50 bg-white/75 backdrop-blur-xl border-b border-black/[0.04] shadow-[0_2px_16px_rgba(0,0,0,0.02)] transition-all">
    <div class="h-14 flex items-center justify-between px-4 md:px-6 max-w-6xl mx-auto">
        <a href="/" class="text-base font-bold tracking-tight text-stone-900 hover:text-blue-600 transition-colors flex items-center gap-1.5 active:scale-95">
            <span class="w-6 h-6 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs font-mono font-bold shadow-xs">∑</span>
            <span>Tai<span class="text-blue-600">Calc</span></span>
        </a>

        <div class="hidden items-center gap-1 text-xs tracking-tight md:flex font-medium">
            <a href="/" class={`px-3 py-1.5 rounded-full transition-all ${isActive('/') ? 'text-blue-600 bg-blue-50 font-semibold shadow-2xs' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/70'}`}>首頁</a>
            <a href="/tools/life-simulator" class={`px-3 py-1.5 rounded-full transition-all ${isActive('/tools/life-simulator') ? 'text-blue-600 bg-blue-50 font-semibold shadow-2xs' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/70'}`}>🎮 人生模擬</a>
            <a href="/tools/mortgage-calculator" class={`px-3 py-1.5 rounded-full transition-all ${isActive('/tools/mortgage') ? 'text-blue-600 bg-blue-50 font-semibold shadow-2xs' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/70'}`}>🏠 房貸</a>
            <a href="/tools/electricity-calculator" class={`px-3 py-1.5 rounded-full transition-all ${isActive('/tools/electricity') ? 'text-blue-600 bg-blue-50 font-semibold shadow-2xs' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/70'}`}>⚡ 電費冷氣</a>
            <a href="/tools/split-calculator" class={`px-3 py-1.5 rounded-full transition-all ${isActive('/tools/split') ? 'text-blue-600 bg-blue-50 font-semibold shadow-2xs' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/70'}`}>⚖️ AA分帳</a>
            <a href="/#support-tools" class="px-3 py-1.5 rounded-full text-stone-600 hover:text-stone-900 hover:bg-stone-100/70 transition-all">所有工具</a>
            <a href="/blog" class={`px-3 py-1.5 rounded-full transition-all ${isActive('/blog') ? 'text-blue-600 bg-blue-50 font-semibold shadow-2xs' : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/70'}`}>專欄</a>
        </div>

        <button id="menu-btn" class="md:hidden flex items-center justify-center w-9 h-9 rounded-xl bg-stone-100/80 text-stone-700 hover:bg-stone-200 transition-colors active:scale-95" aria-label="開啟選單" aria-controls="mobile-menu" aria-expanded="false" data-sfx="tap">
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="8" x2="20" y2="8"></line>
                <line x1="4" y1="16" x2="20" y2="16"></line>
            </svg>
            <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
        </button>
    </div>
</nav>

<div id="mobile-menu" class="hidden fixed inset-0 z-40 bg-paper-100/95 backdrop-blur-2xl pt-16">
    <div class="px-4 pt-6 pb-8 flex flex-col gap-1">
        <a href="/" class="menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-lg font-medium text-ink-700 hover:bg-paper-200/80 transition-colors">首頁</a>
        <p class="px-4 text-xs font-medium text-ink-400 uppercase tracking-widest mb-1">熱門決策</p>
        <a href="/tools/life-simulator" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">人生模擬器</a>
        <a href="/tools/car-cost-calculator" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">買車總成本</a>
        <a href="/tools/severance-calculator" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">離職結算</a>
        <a href="/tools/home-ownership-cost-calculator" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">買房持有成本</a>

        <div class="h-px bg-paper-300 my-3"></div>
        <p class="px-4 text-xs font-medium text-ink-400 uppercase tracking-widest mb-1">工具入口</p>
        <a href="/#support-tools" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">查看所有計算器</a>
        <a href="/housing-toolbox" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">居住決策工具箱</a>
        <a href="/tax-season" class="menu-link flex items-center gap-3 px-4 py-2.5 rounded-xl text-ink-600 hover:bg-paper-200/80 transition-colors">報稅季攻略</a>

        <div class="h-px bg-paper-300 my-3"></div>
        <a href="/blog" class="menu-link flex items-center gap-3 px-4 py-3 rounded-xl text-lg font-medium text-ink-700 hover:bg-paper-200/80 transition-colors">專欄文章</a>
    </div>
</div>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const menuLinks = document.querySelectorAll('.menu-link');

    const openMenu = () => {
        mobileMenu?.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        menuBtn?.setAttribute('aria-label', '關閉選單');
        menuBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
        mobileMenu?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        menuBtn?.setAttribute('aria-label', '開啟選單');
        menuBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
    };

    menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.contains('hidden') ? openMenu() : closeMenu();
    });

    menuLinks.forEach(link => link.addEventListener('click', closeMenu));
    mobileMenu?.addEventListener('click', (e) => { if (e.target === mobileMenu) closeMenu(); });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
            closeMenu();
            menuBtn?.focus();
        }
    });
</script>
