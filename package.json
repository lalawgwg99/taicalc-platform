{
  "name": "taicalc-platform",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint \"src/**/*.{js,ts,tsx,vue}\" \"functions/**/*.js\"",
    "type-check": "tsc --noEmit",
    "astro-check": "astro check",
    "analyze": "astro build && npx @astrojs/telemetry",
    "security-audit": "npm audit",
    "clean": "rm -rf dist node_modules/.vite",
    "optimize-images": "echo 'Image optimization configured via vite-plugin-image-optimizer'"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/vue": "^7.0.1",
    "astro": "^7.1.5",
    "chart.js": "^4.5.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite-plugin-image-optimizer": "^1.1.6",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/telemetry": "^3.3.0",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^9.4.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
